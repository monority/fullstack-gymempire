---
// Template de composant de domaine — à copier vers src/components/<domaine>/Xxx.astro.
// Voir docs/componentization-rules.md §4.
import type { HTMLAttributes } from 'astro/types';
import type { Session } from '../../lib/storage/types';

type Tag = 'article' | 'div' | 'li';
interface Props extends HTMLAttributes<Tag> {
  session: Session;
  as?: Tag;
  variant?: 'default' | 'compact';
  class?: string;
}

const {
  session,
  as: Tag = 'article',
  variant = 'default',
  class: className = '',
  ...rest
} = Astro.props;
const hasActions = Astro.slots.has('actions');
---

<Tag class:list={['session-card', `session-card--${variant}`, className]} {...rest}>
  <h3 class="session-card__title">{session.name}</h3>
  {hasActions && (
    <div class="session-card__actions">
      <slot name="actions" />
    </div>
  )}
  <slot />
</Tag>

<style>
  /* Scope Astro : préfixe BEM par le NOM DU COMPOSANT, jamais par la page. */
  .session-card {
    padding: var(--card-pad, 24px);
    border: 1px solid var(--color-border);
  }
  .session-card__title {
    color: var(--color-text);
  }
  .session-card__actions {
    display: flex;
    gap: 8px;
  }
</style>
