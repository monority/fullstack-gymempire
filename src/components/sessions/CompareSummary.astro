---
/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
import { t } from '../../i18n';
import Icon from '../ui/Icon.astro';
const L = t();
---

{/* ── Summary deltas at the top ── */}
<div class="comp__summary-section">
  <h2 class="comp__summary-title">{L.comparer.summaryTitle}</h2>
  <div class="comp__summary-grid">
    {/* Volume delta */}
    <article class="comp__summary-card">
      <div class="comp__summary-header">
        <Icon name="volumeBox" size={20} />
        <span class="comp__summary-label">{L.comparer.volume}</span>
      </div>
      <div class="comp__summary-body">
        <div class="comp__summary-col">
          <div class="comp__summary-col-label">{L.comparer.session1Ref}</div>
          <div class="comp__summary-col-value" x-text="formatVolume(totalVolume(session1))"></div>
        </div>
        <div class="comp__summary-delta" :class="'comp__summary-delta--' + volumeDelta.direction">
          <span class="comp__summary-delta-icon" aria-hidden="true">
            <template x-if="volumeDelta.direction === 'up'">
              <span class="comp__rotate-180">
                <Icon name="arrowDown" size={18} />
              </span>
            </template>
            <template x-if="volumeDelta.direction === 'down'">
              <Icon name="arrowDown" size={18} />
            </template>
            <template x-if="volumeDelta.direction === 'equal'">
              <Icon name="minus" size={20} />
            </template>
          </span>
          <span x-text="volumeDelta.label"></span>
        </div>
        <div class="comp__summary-col">
          <div class="comp__summary-col-label">{L.comparer.session2}</div>
          <div class="comp__summary-col-value" x-text="formatVolume(totalVolume(session2))"></div>
        </div>
      </div>
    </article>

    {/* Exercises delta */}
    <article class="comp__summary-card">
      <div class="comp__summary-header">
        <Icon name="list" size={20} />
        <span class="comp__summary-label">{L.comparer.exercises}</span>
      </div>
      <div class="comp__summary-body">
        <div class="comp__summary-col">
          <div class="comp__summary-col-label">{L.comparer.session1Ref}</div>
          <div class="comp__summary-col-value" x-text="session1.exercises.length"></div>
        </div>
        <div
          class="comp__summary-delta"
          :class="'comp__summary-delta--' + exercisesDelta.direction"
        >
          <span class="comp__summary-delta-icon" aria-hidden="true">
            <template x-if="exercisesDelta.direction === 'up'">
              <span class="comp__rotate-180">
                <Icon name="arrowDown" size={18} />
              </span>
            </template>
            <template x-if="exercisesDelta.direction === 'down'">
              <Icon name="arrowDown" size={18} />
            </template>
            <template x-if="exercisesDelta.direction === 'equal'">
              <Icon name="minus" size={20} />
            </template>
          </span>
          <span x-text="exercisesDelta.label"></span>
        </div>
        <div class="comp__summary-col">
          <div class="comp__summary-col-label">{L.comparer.session2}</div>
          <div class="comp__summary-col-value" x-text="session2.exercises.length"></div>
        </div>
      </div>
    </article>

    {/* Sets delta */}
    <article class="comp__summary-card">
      <div class="comp__summary-header">
        <Icon name="list" size={20} />
        <span class="comp__summary-label">{L.comparer.sets}</span>
      </div>
      <div class="comp__summary-body">
        <div class="comp__summary-col">
          <div class="comp__summary-col-label">{L.comparer.session1Ref}</div>
          <div class="comp__summary-col-value" x-text="totalSets(session1)"></div>
        </div>
        <div class="comp__summary-delta" :class="'comp__summary-delta--' + setsDelta.direction">
          <span class="comp__summary-delta-icon" aria-hidden="true">
            <template x-if="setsDelta.direction === 'up'">
              <span class="comp__rotate-180">
                <Icon name="arrowDown" size={18} />
              </span>
            </template>
            <template x-if="setsDelta.direction === 'down'">
              <Icon name="arrowDown" size={18} />
            </template>
            <template x-if="setsDelta.direction === 'equal'">
              <Icon name="minus" size={20} />
            </template>
          </span>
          <span x-text="setsDelta.label"></span>
        </div>
        <div class="comp__summary-col">
          <div class="comp__summary-col-label">{L.comparer.session2}</div>
          <div class="comp__summary-col-value" x-text="totalSets(session2)"></div>
        </div>
      </div>
    </article>

    {/* Best 1RM delta */}
    <article class="comp__summary-card">
      <div class="comp__summary-header">
        <Icon name="dumbbell" size={20} />
        <span class="comp__summary-label">{L.comparer.best1RM}</span>
      </div>
      <div class="comp__summary-body">
        <div class="comp__summary-col">
          <div class="comp__summary-col-label">{L.comparer.session1Ref}</div>
          <div class="comp__summary-col-value" x-text="formatVolume(bestSet(session1))"></div>
        </div>
        <div class="comp__summary-delta" :class="'comp__summary-delta--' + bestSetDelta.direction">
          <span class="comp__summary-delta-icon" aria-hidden="true">
            <template x-if="bestSetDelta.direction === 'up'">
              <span class="comp__rotate-180">
                <Icon name="arrowDown" size={18} />
              </span>
            </template>
            <template x-if="bestSetDelta.direction === 'down'">
              <Icon name="arrowDown" size={18} />
            </template>
            <template x-if="bestSetDelta.direction === 'equal'">
              <Icon name="minus" size={20} />
            </template>
          </span>
          <span x-text="bestSetDelta.label"></span>
        </div>
        <div class="comp__summary-col">
          <div class="comp__summary-col-label">{L.comparer.session2}</div>
          <div class="comp__summary-col-value" x-text="formatVolume(bestSet(session2))"></div>
        </div>
      </div>
    </article>
  </div>
</div>
