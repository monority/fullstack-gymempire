---
import { resolveLocale } from '../../i18n';

/** Bandeau de repos — affiché au-dessus de la série en cours, sans écran dédié. */
interface Props {}
import { t } from '../../i18n';
import Button from '../ui/Button.astro';
const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
---

<template x-if="state === 'working' && isResting">
  <section class="quick__rest-banner" role="status" aria-live="off">
    <div class="quick__rest-label">
      <span class="quick__rest-title">{L.rapide.resting}</span>
      <span class="quick__rest-next" x-text="restNextLabel()"></span>
    </div>
    <div
      class="quick__rest-timer"
      :class="{ 'quick__rest-timer--low': restRemaining <= 10 && restRemaining > 0 }"
      x-text="formatRestTime()"
    ></div>
    <div class="quick__rest-actions">
      <button
        type="button"
        class="quick__rest-step"
        @click="addRestTime(-15)"
        aria-label={L.rapide.restMinusAria}
      >
        −15s
      </button>
      <Button variant="secondary" size="sm" @click="skipRest()">
        {L.common.skip}
      </Button>
      <button
        type="button"
        class="quick__rest-step"
        @click="addRestTime(15)"
        aria-label={L.rapide.restPlusAria}
      >
        +15s
      </button>
    </div>
  </section>
</template>
