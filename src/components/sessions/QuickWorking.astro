---
import { t } from '../../i18n';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Segmented from '../ui/Segmented.astro';
import Select from '../ui/Select.astro';
const L = t();
---

{/* --- STATE 2 — Working --- */}
<template x-if="state === 'working' && currentSet">
  <section class="quick__working" @touchstart="onTouchStart($event)" @touchend="onTouchEnd($event)">
    <div class="quick__working-inner">
      <div
        class="quick__exercise-name"
        x-text="trExercise(currentExercise?.name)"
        aria-live="polite"
        aria-atomic="true"
      ></div>
      <div class="quick__muscle" x-text="trMuscle(currentExercise?.muscle)"></div>

      <div class="quick__set-info" aria-live="polite" aria-atomic="true">
        {L.rapide.setProgress}
        <span x-text="currentSet.setNumber"></span>
        <span
          class="quick__set-type"
          :class="'tone--' + currentSet.type"
          x-text="typeLabel(currentSet.type)"
        ></span>
      </div>

      <div class="quick__values">
        <div class="quick__value-col">
          <span class="quick__value-number" x-text="formatWeightValue(currentSet.weight)"></span>
          <span class="quick__value-unit" x-text="weightUnit()"></span>
        </div>
        <div class="quick__x-separator" aria-hidden="true">
          ×
        </div>
        <div class="quick__value-col">
          <span class="quick__value-number" x-text="currentSet.reps"></span>
          <span class="quick__value-unit">{L.rapide.repsUnit}</span>
        </div>
      </div>

      <div class="quick__rpe-control">
        <span class="quick__label">{L.rapide.rpeLabel}</span>
        <Segmented
          items={[
            { value: 'rpe', label: 'RPE' },
            { value: 'urpe', label: 'uRPE' },
          ]}
          model="currentRpeType"
          ariaLabel={L.rapide.rpeTypeLabel}
        />
        <Select
          class="quick__rpe-select"
          aria-label={L.rapide.rpeLabel}
          x-model.number="currentRpe"
        >
          <option value="">{L.rapide.rpeUnset}</option>
          <template x-for="value in rpeValues" :key="value">
            <option :value="value" x-text="value"></option>
          </template>
        </Select>
      </div>

      <Button
        variant="primary"
        class="quick__done-btn"
        @click="completeSet()"
        aria-label={L.rapide.completeSetAria}
      >
        <Icon name="check" size={24} />
        <span>{L.rapide.done}</span>
      </Button>

      <Button
        variant="ghost"
        class="quick__undo-working"
        :disabled="!canUndo"
        @click="undoLastSet()"
      >
        <Icon name="undo" size={18} />
        <span>{L.rapide.undoLast}</span>
      </Button>

      <div class="quick__nav-grid">
        <button
          type="button"
          class="quick__nav-btn"
          :disabled="!canGoPrev()"
          @click="prevSet()"
          aria-label={L.rapide.prevSetAria}
        >
          <Icon name="chevronLeft" size={20} />
          <span>{L.rapide.prev}</span>
        </button>
        <button
          type="button"
          class="quick__nav-btn"
          :disabled="!canGoNext()"
          @click="nextSet()"
          aria-label={L.rapide.nextSetAria}
        >
          <span>{L.rapide.next}</span>
          <Icon name="chevronRight" size={20} />
        </button>
      </div>
    </div>
  </section>
</template>

<style>
  .quick__working {
    flex: 1 1 0%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow: hidden;
  }

  .quick__working-inner {
    width: 100%;
    max-width: 60rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .quick__exercise-name {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-text);
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
  }

  .quick__set-info {
    font-size: 1.6rem;
    color: var(--color-muted);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .quick__set-type {
    display: inline-flex;
    align-items: center;
    height: 2.6rem;
    padding: 0 0.625rem;
    border-radius: 0;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background-color: transparent;
    border: 1px solid var(--color-border);
  }

  .quick__values {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
    margin: 0.5rem 0;
  }

  .quick__rpe-control {
    display: grid;
    grid-template-columns: auto auto minmax(11rem, 16rem);
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: 100%;
  }

  .quick__rpe-control :global(.seg) {
    min-height: 4.4rem;
  }

  .quick__rpe-control :global(.select-wrapper) {
    width: 100%;
  }

  .quick__rpe-select {
    min-height: 4.4rem;
    font-size: 1.3rem;
  }

  .quick__value-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .quick__value-number {
    font-family: var(--font-display);
    font-size: clamp(5.2rem, 14vw, 9.6rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .quick__value-unit {
    font-family: var(--font-body);
    font-size: 1.6rem;
    color: var(--color-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-top: 0.25rem;
  }

  .quick__x-separator {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 5.6rem);
    color: var(--color-muted);
    font-weight: 300;
    line-height: 1;
  }

  .quick__undo-working {
    min-height: 4.4rem;
    font-size: 1.3rem;
    color: var(--color-muted);
  }

  .quick__undo-working:disabled {
    opacity: 0.35;
  }

  .quick__nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    width: 100%;
    max-width: 60rem;
  }

  .quick__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 4.4rem;
    padding: 0 1rem;
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 600;
    cursor: pointer;
    appearance: none;
    transition: all 140ms var(--transition-fast);
  }

  .quick__nav-btn:hover {
    background-color: transparent;
    border-color: var(--color-border-strong);
  }

  .quick__nav-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .quick__nav-btn:active {
    transform: scale(0.98);
  }

  .quick__nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  @media (max-width: 360px) {
    .quick__header {
      grid-template-columns: 4.8rem minmax(0, 1fr) 4.8rem;
      gap: 0.375rem;
    }
    .quick__header :global(.icon-btn) {
      width: 4.8rem;
      height: 4.8rem;
    }
    .quick__progress-text {
      font-size: 1.1rem;
    }
    .quick__exercise-name {
      font-size: 2.2rem;
    }
    .quick__value-number {
      font-size: clamp(4.6rem, 18vw, 7rem);
    }
  }
</style>
