---
import { t } from '../../i18n';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
const L = t();
---

{/* --- STATE 4 — Completed --- */}
<template x-if="state === 'completed'">
  <section class="quick__completed">
    <div class="quick__completed-inner">
      <div
        class="quick__done-icon"
        :class="{ 'quick__done-icon--partial': recordedSets < totalSets }"
        aria-hidden="true"
      >
        <Icon name="checkCircle" size={80} />
      </div>
      <h1 class="quick__done-title" x-text="completionTitle"></h1>
      <p class="quick__done-name" x-text="session?.name"></p>
      <p class="quick__done-message" x-text="completionMessage" role="status"></p>

      <div class="quick__stats">
        <div class="quick__stat-card">
          <div class="quick__stat-value" x-text="`${recordedSets} / ${totalSets}`"></div>
          <div class="quick__stat-label">{L.rapide.setsDone}</div>
        </div>
        <div class="quick__stat-card">
          <div class="quick__stat-value" x-text="`${completedExercises} / ${totalExercises}`"></div>
          <div class="quick__stat-label">{L.rapide.exercises}</div>
        </div>
        <div class="quick__stat-card">
          <div class="quick__stat-value" x-text="formatDuration(sessionDuration)"></div>
          <div class="quick__stat-label">{L.rapide.duration}</div>
        </div>
        <div class="quick__stat-card">
          <div class="quick__stat-value" x-text="formatWeightValue(sessionTotalVolume)"></div>
          <div class="quick__stat-label">{L.rapide.volume}</div>
        </div>
      </div>

      <div class="quick__done-actions">
        <Button variant="primary" :href="detailHref(session?.id)">
          {L.rapide.viewSession}
        </Button>
        <Button variant="ghost" :disabled="!canUndo" @click="undoLastSet()">
          {L.rapide.undoLast}
        </Button>
        <Button variant="ghost" @click="reset()">
          {L.rapide.chooseAnother}
        </Button>
      </div>
    </div>
  </section>
</template>

<style>
  .quick__done-btn {
    width: 100%;
    max-width: 60rem;
    min-height: 5.2rem;
    padding: 0 1.5rem;
    background-color: var(--color-success);
    color: var(--color-success-foreground);
    border: none;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-success) 20%, transparent);
    transition: all 140ms var(--transition-fast);
  }

  .quick__done-btn:hover {
    background-color: color-mix(in srgb, var(--color-success) 90%, white);
  }

  .quick__done-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .quick__done-btn:active {
    transform: scale(0.985);
  }

  .quick__completed {
    flex: 1 1 0%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overflow-y: auto;
  }

  .quick__completed-inner {
    width: 100%;
    max-width: 56rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .quick__done-icon {
    width: 12rem;
    height: 12rem;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-success) 12%, transparent);
    color: var(--color-success);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.25rem;
  }

  .quick__done-icon--partial {
    background-color: color-mix(in srgb, var(--color-warning) 12%, transparent);
    color: var(--color-warning);
  }

  .quick__done-title {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 4.8rem);
    font-weight: 700;
    line-height: 1;
    margin: 0;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .quick__done-name {
    font-size: 1.6rem;
    color: var(--color-muted);
    margin: 0;
  }

  .quick__done-message {
    font-size: 1.4rem;
    color: var(--color-success);
    margin-top: -0.25rem;
  }

  .quick__done-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .quick__done-actions :global(.button) {
    flex: 1;
  }

  @media (max-width: 480px) {
    .quick__header {
      grid-template-columns: 5.2rem 1fr 5.2rem;
      padding: 1rem;
    }
    .quick__header :global(.icon-btn) {
      width: 5.2rem;
      height: 5.2rem;
    }
    .quick__progress-text {
      font-size: 1.2rem;
    }
    .quick__selecting {
      align-items: flex-start;
      padding: 2rem 1rem;
    }
    .quick__selecting-inner {
      gap: 0.75rem;
    }
    .quick__zap-icon {
      width: 7.2rem;
      height: 7.2rem;
    }
    .quick__title {
      font-size: clamp(2.6rem, 11vw, 3.8rem);
    }
    .quick__selecting-actions {
      flex-direction: column;
      gap: 0.5rem;
    }
    .quick__working {
      align-items: flex-start;
      padding: 1rem;
      overflow-y: auto;
    }
    .quick__working-inner {
      gap: 0.75rem;
    }
    .quick__values {
      gap: clamp(1.2rem, 8vw, 2.4rem);
    }
    .quick__rpe-control {
      grid-template-columns: 1fr 1fr;
    }
    .quick__rpe-control :global(.quick__label) {
      grid-column: 1 / -1;
    }
    .quick__rpe-control :global(.select-wrapper) {
      grid-column: 1 / -1;
    }
    .quick__resting {
      align-items: flex-start;
      padding: 2rem 1rem;
      overflow-y: auto;
    }
    .quick__resting-inner {
      gap: 0.75rem;
    }
    .quick__resting-timer {
      font-size: clamp(8rem, 32vw, 12rem);
    }
    .quick__resting-grid {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .quick__resting-grid :global(.quick__undo) {
      grid-column: auto;
      order: 3;
    }
    .quick__selecting-actions :global(.button) {
      width: 100%;
    }
    .quick__completed {
      align-items: flex-start;
      padding: 2rem 1rem;
    }
    .quick__completed-inner {
      gap: 0.75rem;
    }
    .quick__done-icon {
      width: 8rem;
      height: 8rem;
    }
    .quick__stats {
      gap: 0.5rem;
    }
    .quick__stat-card {
      padding: 0.75rem 0.375rem;
    }
    .quick__stat-label {
      font-size: 0.9rem;
      letter-spacing: 0.06em;
    }
  }

  @media (min-width: 540px) {
    .quick__stats {
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }
    .quick__done-actions {
      flex-direction: row;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quick__header :global(.icon-btn),
    .quick__select,
    .quick__done-btn,
    .quick__nav-btn {
      transition: none;
    }
  }
</style>
