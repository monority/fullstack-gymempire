---
/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
import { t } from '../../i18n';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
const L = t();
---

{/* --- STATE 4 — Completed --- */}
<template x-if="state === 'completed'">
  <section class="quick__completed">
    <div class="quick__completed-inner">
      <div
        class="quick__done-icon"
        :class="{ 'quick__done-icon--partial': recordedSets < totalSets }"
        aria-hidden="true"
      >
        <Icon name="checkCircle" size={80} />
      </div>
      <h1 class="quick__done-title" x-text="completionTitle"></h1>
      <p class="quick__done-name" x-text="session?.name"></p>
      <p class="quick__done-message" x-text="completionMessage" role="status"></p>

      <div class="quick__stats">
        <div class="quick__stat-card">
          <div class="quick__stat-value" x-text="`${recordedSets} / ${totalSets}`"></div>
          <div class="quick__stat-label">{L.rapide.setsDone}</div>
        </div>
        <div class="quick__stat-card">
          <div class="quick__stat-value" x-text="`${completedExercises} / ${totalExercises}`"></div>
          <div class="quick__stat-label">{L.rapide.exercises}</div>
        </div>
        <div class="quick__stat-card">
          <div class="quick__stat-value" x-text="formatDuration(sessionDuration)"></div>
          <div class="quick__stat-label">{L.rapide.duration}</div>
        </div>
        <div class="quick__stat-card">
          <div class="quick__stat-value" x-text="formatWeightValue(sessionTotalVolume)"></div>
          <div class="quick__stat-label">{L.rapide.volume}</div>
        </div>
      </div>

      <div class="quick__done-actions">
        <Button variant="primary" :href="detailHref(session?.id)">
          {L.rapide.viewSession}
        </Button>
        <Button variant="ghost" :disabled="!canUndo" @click="undoLastSet()">
          {L.rapide.undoLast}
        </Button>
        <Button variant="ghost" @click="reset()">
          {L.rapide.chooseAnother}
        </Button>
      </div>
    </div>
  </section>
</template>
