---
/**
 * NextSession — the dominant object of the first viewport.
 * Renders inside the Alpine dashboardApp scope.
 */
import { t, localizedPath } from '../../i18n';

const L = t();
---

<section class="dash__next" x-show="nextSession" aria-label={L.dashboard.nextSession}>
  <div class="dash__next-main">
    <div class="dash__next-copy">
      <h2 class="dash__next-name" x-text="nextSession?.name"></h2>
      <p class="dash__next-meta">
        <span x-text="nextSession ? sessionExercisesCount(nextSession) + ' ' + labels.exercisesUnit : ''"></span>
        <span aria-hidden="true">·</span>
        <span x-text="nextSession ? sessionSetsCount(nextSession) + ' ' + labels.setsUnit : ''"></span>
        <span aria-hidden="true">·</span>
        <span x-text="nextDurationLabel()" title={L.dashboard.durationHint}></span>
      </p>
      <p
        class="dash__next-hint"
        x-text="nextSession?.status === 'in-progress' ? labels.continueWorkout : labels.plannedWorkoutHint"
      ></p>
    </div>
    <a
      class="dash__next-action"
      :href="localizedPath('/sessions/quick?session=' + nextSession?.id)"
    >
      <span x-text="nextSession?.status === 'in-progress' ? labels.continueWorkout : labels.startWorkout"></span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<section class="dash__next" x-show="!nextSession" x-cloak aria-label={L.dashboard.noNextTitle}>
  <div class="dash__next-main">
    <div class="dash__next-copy">
      <h2 class="dash__next-name">{L.dashboard.noNextTitle}</h2>
      <p class="dash__next-hint">{L.dashboard.noNextHint}</p>
    </div>
    <a class="dash__next-action" href={localizedPath('/sessions/quick')}>
      <span>{L.dashboard.quickSession}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .dash__next {
    position: relative;
    padding: 2.8rem 2.4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .dash__next::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2.4rem;
    bottom: 2.4rem;
    width: 1px;
    background: var(--color-accent);
  }

  .dash__next-main {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.4rem;
  }

  .dash__next-copy {
    min-width: 0;
  }

  .dash__next-name {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-metric);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .dash__next-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.2rem 0 0;
    color: var(--color-muted);
    font-size: 1.2rem;
  }

  .dash__next-hint {
    margin: 0.6rem 0 0;
    color: var(--color-muted);
    font-size: 1.3rem;
  }

  .dash__next-action {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1rem;
    min-height: 4.4rem;
    padding: 0 1.6rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-foreground);
    font-size: 1.2rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 200ms var(--ease-out);
  }

  .dash__next-action:hover {
    background: var(--color-accent-hover);
  }

  .dash__next-action:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (max-width: 640px) {
    .dash__next {
      padding: 2.4rem 1.6rem;
    }

    .dash__next-main {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
