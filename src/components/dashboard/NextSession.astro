---
import { resolveLocale } from '../../i18n';

/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
/**
 * NextSession — the dominant object of the first viewport.
 * Renders inside the Alpine dashboardApp scope.
 */
import { t, localizedPath } from '../../i18n';

const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
---

<section class="dash__next" x-show="nextSession" aria-label={L.dashboard.nextSession}>
  <div class="dash__next-main">
    <div class="dash__next-copy">
      <h2 class="dash__next-name" x-text="nextSession?.name"></h2>
      <p class="dash__next-meta">
        <span x-text="nextSession ? sessionExercisesCount(nextSession) + ' ' + labels.exercisesUnit : ''"></span>
        <span aria-hidden="true">·</span>
        <span x-text="nextSession ? sessionSetsCount(nextSession) + ' ' + labels.setsUnit : ''"></span>
        <span aria-hidden="true">·</span>
        <span x-text="nextDurationLabel()" title={L.dashboard.durationHint}></span>
      </p>
      <p
        class="dash__next-hint"
        x-text="nextSession?.status === 'in-progress' ? labels.continueWorkout : labels.plannedWorkoutHint"
      ></p>
    </div>
    <a
      class="dash__next-action"
      :href="localizedPath('/sessions/quick?session=' + nextSession?.id, locale)"
    >
      <span x-text="nextSession?.status === 'in-progress' ? labels.continueWorkout : labels.startWorkout"></span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<section class="dash__next" x-show="!nextSession" x-cloak aria-label={L.dashboard.noNextTitle}>
  <div class="dash__next-main">
    <div class="dash__next-copy">
      <h2 class="dash__next-name">{L.dashboard.noNextTitle}</h2>
      <p class="dash__next-hint">{L.dashboard.noNextHint}</p>
    </div>
    <a class="dash__next-action" href={localizedPath('/sessions/quick', locale)}>
      <span>{L.dashboard.quickSession}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
