---
import Icon from './Icon.astro';
import Button from './Button.astro';
import Card from './Card.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  iconName?: IconName;
  title: string;
  description?: string;
  actionLabel?: string;
  actionHref?: string;
  variant?: 'default' | 'error';
  class?: string;
}

const {
  iconName,
  title,
  description,
  actionLabel,
  actionHref,
  variant = 'default',
  class: className = '',
} = Astro.props;

const hasAction = Boolean(actionLabel && actionHref);
const isError = variant === 'error';
---

{isError ? (
  <Card class={className}>
    <div class="empty-state empty-state--centered">
      {iconName && (
        <div class="empty-state__icon empty-state__icon--error" aria-hidden="true">
          <Icon name={iconName} size={30} />
        </div>
      )}
      <h2 class="empty-state__title empty-state__title--large">{title}</h2>
      {description && <p class="empty-state__desc">{description}</p>}
      {hasAction && (
        <Button href={actionHref} variant="primary" class="empty-state__action">
          {actionLabel}
        </Button>
      )}
    </div>
  </Card>
) : (
  <div class:list={['empty-state', className]} role="status">
    {iconName && (
      <div class="empty-state__icon" aria-hidden="true">
        <Icon name={iconName} size={24} />
      </div>
    )}
    <h3 class="empty-state__title">{title}</h3>
    {description && <p class="empty-state__desc">{description}</p>}
    {hasAction && (
      <Button href={actionHref} variant="primary" class="empty-state__action--lg">
        {actionLabel}
      </Button>
    )}
  </div>
)}
