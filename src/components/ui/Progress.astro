---
interface Props {
  value: number;
  max?: number;
  variant?: 'default' | 'success' | 'warning' | 'danger' | 'accent';
  size?: 'sm' | 'md';
  label?: string;
  class?: string;
}

const {
  value,
  max = 100,
  variant = 'default',
  size = 'md',
  label,
  class: className = '',
} = Astro.props;

const safeMax = max > 0 ? max : 1;
const clamped = Math.max(0, Math.min(value, safeMax));
const percent = (clamped / safeMax) * 100;
---

{label && <div class="progress__label">{label}</div>}
<div
  class:list={['progress', `progress--${size}`, className]}
  role="progressbar"
  aria-valuenow={clamped}
  aria-valuemin="0"
  aria-valuemax={safeMax}
  aria-label={label}
>
  <div
    class:list={['progress__fill', `progress__fill--${variant}`]}
    style={`width: ${percent}%;`}
  ></div>
</div>
