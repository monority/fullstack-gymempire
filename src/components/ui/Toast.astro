---
/**
 *
 * Renders a small stack in the bottom-right of the viewport. Driven by
 * Alpine and driven by the global UI store ($store.ui).
 * Trigger from anywhere with uiStore.notify(message, variant).
 *
 *   <Toast />
 *
 * Trigger from anywhere on the page:
 *
 * Variants: success (green) | error (red) | info (blue) | warning (yellow).
 * Default variant is `info`; auto-dismiss defaults to 3000ms (configurable
 * via the `duration` prop, in milliseconds).
 *
 * Accessible: role="status", aria-live="polite", aria-atomic="true".
 */
interface Props {
  /** Auto-dismiss delay in milliseconds (default 3000). */
  duration?: number;
  closeLabel?: string;
}

const { duration = 3000, closeLabel } = Astro.props;
import Icon from './Icon.astro';
---

<div x-data="toastApp()" data-duration={duration} class="toast-root">
  <template x-for="toast in $store.ui.toasts" :key="toast.id">
    <div
      x-cloak
      x-transition.opacity.duration.200ms
      role="status"
      aria-live="polite"
      aria-atomic="true"
      class="toast"
      :class="`toast--${toast.variant}`"
    >
      <span class="toast__icon" x-show="toast.variant === 'success'" x-cloak aria-hidden="true">
        <Icon name="check" size={18} />
      </span>
      <span class="toast__icon" x-show="toast.variant === 'error'" x-cloak aria-hidden="true">
        <Icon name="closeX" size={18} />
      </span>
      <span class="toast__icon" x-show="toast.variant === 'info'" x-cloak aria-hidden="true">
        <Icon name="infoCircle" size={18} />
      </span>
      <span class="toast__icon" x-show="toast.variant === 'warning'" x-cloak aria-hidden="true">
        <Icon name="alertTriangle" size={18} />
      </span>
      <p class="toast__message" x-text="toast.message"></p>
      <button
        type="button"
        class="toast__close"
        @click="$store.ui.dismiss(toast.id)"
        aria-label={closeLabel}
      >
        <Icon name="closeX" size={16} />
      </button>
    </div>
  </template>
</div>

<script>
  import { registerAlpine } from '../../lib/alpine';
  import { singleton as uiStore } from '../../lib/ui-store';

  uiStore.duration =
    Number(document.querySelector('.toast-root')?.getAttribute('data-duration')) || 3000;

  registerAlpine('toastApp', () => ({}));
</script>
