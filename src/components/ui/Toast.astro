---
/**
 *
 * Renders a small stack in the bottom-right of the viewport. Driven by
 * Alpine and driven by the global UI store ($store.ui).
 * Trigger from anywhere with uiStore.notify(message, variant).
 *
 *   <Toast />
 *
 * Trigger from anywhere on the page:
 *
 * Variants: success (green) | error (red) | info (blue) | warning (yellow).
 * Default variant is `info`; auto-dismiss defaults to 3000ms (configurable
 * via the `duration` prop, in milliseconds).
 *
 * Accessible: role="status", aria-live="polite", aria-atomic="true".
 */
interface Props {
  /** Auto-dismiss delay in milliseconds (default 3000). */
  duration?: number;
}

const { duration = 3000 } = Astro.props;
import Icon from './Icon.astro';
---

<div x-data="toastApp()" data-duration={duration} class="toast-root">
  <template x-for="toast in $store.ui.toasts" :key="toast.id">
    <div
      x-cloak
      x-transition.opacity.duration.200ms
      role="status"
      aria-live="polite"
      aria-atomic="true"
      class="toast"
      :class="`toast--${toast.variant}`"
    >
      <span class="toast__icon" x-show="toast.variant === 'success'" x-cloak aria-hidden="true">
        <Icon name="check" size={18} />
      </span>
      <span class="toast__icon" x-show="toast.variant === 'error'" x-cloak aria-hidden="true">
        <Icon name="closeX" size={18} />
      </span>
      <span class="toast__icon" x-show="toast.variant === 'info'" x-cloak aria-hidden="true">
        <Icon name="infoCircle" size={18} />
      </span>
      <span class="toast__icon" x-show="toast.variant === 'warning'" x-cloak aria-hidden="true">
        <Icon name="alertTriangle" size={18} />
      </span>
      <p class="toast__message" x-text="toast.message"></p>
      <button
        type="button"
        class="toast__close"
        @click="$store.ui.dismiss(toast.id)"
        aria-label="Close"
      >
        <Icon name="closeX" size={16} />
      </button>
    </div>
  </template>
</div>

<style>
  .toast-root {
    position: fixed;
    bottom: calc(var(--bottom-nav-height, 5.6rem) + 1.2rem);
    right: 2.4rem;
    z-index: 8; /* level 8: toasts */
    max-width: 42rem;
    font-family: var(--font-body);
  }

  .toast {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    padding: 1.2rem 1.4rem;
    background-color: var(--color-surface-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-2);
  }

  .toast__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .toast__icon svg {
    width: 18px;
    height: 18px;
  }

  .toast__message {
    margin: 0;
    flex: 1 1 auto;
    color: var(--color-text);
    font-size: 1.4rem;
    line-height: 1.4;
    word-break: break-word;
  }

  .toast__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0.2rem;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .toast__close svg {
    width: 16px;
    height: 16px;
  }

  .toast__close:hover {
    color: var(--color-text);
    background-color: var(--alpha-bg-hover);
  }

  .toast--success .toast__icon {
    color: var(--color-success);
  }
  .toast--error .toast__icon {
    color: var(--color-destructive);
  }
  .toast--info .toast__icon {
    color: var(--color-info);
  }
  .toast--warning .toast__icon {
    color: var(--color-warning);
  }

  @media (max-width: 640px) {
    .toast-root {
      bottom: 5.6rem;
      right: 1.2rem;
    }
  }
</style>

<script>
  import { registerAlpine } from '../../lib/alpine';
  import { singleton as uiStore } from '../../lib/ui-store';

  uiStore.duration =
    Number(document.querySelector('.toast-root')?.getAttribute('data-duration')) || 3000;

  registerAlpine('toastApp', () => ({}));
</script>
