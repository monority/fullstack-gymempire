---
interface Props {
  placeholder?: string;
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const { placeholder, label, class: className = '', ...rest } = Astro.props;
import Icon from './Icon.astro';
---

<div class:list={['search-input', className]}>
  <Icon name="searchLine" size={18} />
  <input
    type="search"
    class="search-input__field"
    placeholder={placeholder}
    aria-label={label}
    {...rest}
  />
</div>
