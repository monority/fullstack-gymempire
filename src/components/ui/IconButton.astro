---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'default' | 'danger' | 'accent' | 'ghost';
  size?: 'sm' | 'md';
  icon?: string;
  label?: string;
  title?: string;
  class?: string;
  disabled?: boolean;
  loading?: boolean;
}

const {
  variant = 'default',
  size = 'md',
  icon,
  label,
  title,
  class: className = '',
  disabled,
  loading = false,
  ...rest
} = Astro.props;

const sizeClasses = {
  sm: 'icon-btn--sm',
  md: 'icon-btn--md',
};

const variantClasses = {
  default: '',
  danger: 'icon-btn--danger',
  accent: 'icon-btn--accent',
  ghost: 'icon-btn--ghost',
};
---

<button
  {...rest}
  type="button"
  class:list={['icon-btn', sizeClasses[size], variantClasses[variant], className]}
  aria-label={label}
  title={title ?? label}
  aria-busy={loading || undefined}
  disabled={disabled || loading}
>
  {loading ? <span class="icon-btn__spinner" aria-hidden="true" /> : <Fragment set:html={icon} />}
</button>
