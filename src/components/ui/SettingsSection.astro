---
import Icon from './Icon.astro';
import Card from './Card.astro';
import CardHeader from './CardHeader.astro';
import CardTitle from './CardTitle.astro';
import CardContent from './CardContent.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  icon: IconName;
  title: string;
  description?: string;
  id?: string;
  class?: string;
}

const { icon, title, description, id, class: className = '' } = Astro.props;
---

<section class:list={['settings-section', className]} id={id}>
  <Card>
    <CardHeader>
      <div class="settings-section__heading">
        <span class="settings-section__icon" aria-hidden="true">
          <Icon name={icon} size={24} />
        </span>
        <CardTitle>{title}</CardTitle>
      </div>
      {description && <p class="settings-section__desc">{description}</p>}
    </CardHeader>
    <CardContent>
      <slot />
    </CardContent>
  </Card>
</section>
