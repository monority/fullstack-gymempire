---
/**
 * StatCard — brique de métrique calme (hairline, flat, une seule valeur).
 * Les valeurs/date sont injectées par slots pour rester pilotables par Alpine.
 */
import type { HTMLAttributes } from 'astro/types';

type Tag = 'article' | 'div';
interface Props extends HTMLAttributes<Tag> {
  label: string;
  icon?: string;
  hero?: boolean;
  as?: Tag;
  class?: string;
}

const {
  label,
  icon,
  hero = false,
  as: Tag = 'article',
  class: className = '',
  ...rest
} = Astro.props;
---

<Tag class:list={['stat-card', hero && 'stat-card--hero', className]} {...rest}>
  <div class="stat-card__head">
    {icon && <span class="stat-card__icon" aria-hidden="true" set:html={icon} />}
    <span class:list={['stat-card__label', 'u-label']}>{label}</span>
  </div>
  <slot name="value" />
  <slot name="date" />
</Tag>

<style>
  /* Règle héros : doit rester non layerée pour battre les styles locaux des pages. */
  .stat-card--hero :global(.stat-card__value) {
    color: var(--color-accent);
  }
</style>
