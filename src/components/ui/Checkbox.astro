---
interface Props {
  label?: string;
  checked?: boolean;
  disabled?: boolean;
  name?: string;
  id?: string;
  class?: string;
}

const { label, checked = false, disabled = false, name, id, class: className = '' } = Astro.props;

const classes = ['checkbox', disabled && 'is-disabled', className].filter(Boolean).join(' ');
---

<label for={id} class:list={['checkbox__label', classes]}>
  <input
    type="checkbox"
    id={id}
    name={name}
    checked={checked}
    disabled={disabled}
    class="checkbox__input"
  />

  <span aria-hidden="true" class="checkbox__box">
    <svg class="checkbox__check" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M3.5 8L6.5 11L12.5 5"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>

  {label && <span class="checkbox__text">{label}</span>}
</label>
