---
interface Props {
  href: string;
  label: string;
  class?: string;
  [key: string]: unknown;
}

const { href, label, class: className = '', ...rest } = Astro.props;
import Icon from './Icon.astro';
---

<a {href} class:list={['back-link', className]} {...rest}>
  <Icon name="arrowLeft" size={20} />
  <span>{label}</span>
</a>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-muted);
    font-size: 1.4rem;
    font-weight: 500;
    text-decoration: none;
    margin-bottom: 1.2rem;
    transition: color var(--transition-fast);
  }
  .back-link:hover {
    color: var(--color-text);
  }
  .back-link :global(svg) {
    flex-shrink: 0;
  }
</style>
