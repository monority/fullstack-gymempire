---
interface Props {
  href: string;
  label: string;
  class?: string;
  [key: string]: unknown;
}

const { href, label, class: className = '', ...rest } = Astro.props;
import Icon from './Icon.astro';
---

<a {href} class:list={['back-link', className]} {...rest}>
  <Icon name="arrowLeft" size={20} />
  <span>{label}</span>
</a>
