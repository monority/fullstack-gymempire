---
import FormField from './FormField.astro';
import Icon from './Icon.astro';
import { buildDescribedBy } from '../../lib/form-utils';

interface Option {
  value: string;
  label: string;
  disabled?: boolean;
}

interface Props {
  label?: string;
  hint?: string;
  error?: string;
  disabled?: boolean;
  required?: boolean;
  name?: string;
  id?: string;
  value?: string;
  placeholder?: string;
  options?: Option[];
  class?: string;
  [key: string]: unknown;
}

const {
  label,
  hint,
  error,
  disabled = false,
  required = false,
  name,
  id,
  value,
  placeholder,
  options,
  class: className = '',
  ...rest
} = Astro.props;

const describedBy = buildDescribedBy(id, hint, error);
---

<FormField id={id} label={label} hint={hint} error={error} required={required}>
  <div class="select-wrapper">
    <select
      id={id}
      name={name}
      disabled={disabled}
      required={required}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      class:list={['select', error && 'select--error', className]}
      {...rest}
    >
      {placeholder && (
        <option value="" disabled selected={!value}>
          {placeholder}
        </option>
      )}
      {options?.map((opt) => (
        <option value={opt.value} disabled={opt.disabled} selected={opt.value === value}>
          {opt.label}
        </option>
      ))}
      <slot />
    </select>

    <span class="select__chevron">
      <Icon name="chevronDown" size={16} />
    </span>
  </div>
</FormField>
