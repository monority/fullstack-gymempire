---
/**
 * AppShell - orchestrates Sidebar + Header into the full layout.
 *
 * - Desktop (>=1024px): sidebar (left) + topbar (top) + content
 * - Mobile  (<1024px): topbar (with hamburger) + content
 *                    + slide-in drawer (same nav as the sidebar)
 */
import Sidebar from './Sidebar.astro';
import Header from './Header.astro';
import Icon from '../ui/Icon.astro';
import { t } from '../../i18n';
import { renderIcon } from '../../lib/nav';
import type { NavGroup, NavItem } from '../../lib/types';

interface Props {
  groups: NavGroup[];
  title?: string;
  class?: string;
}

const { groups, title, class: className = '' } = Astro.props as unknown as Props;
const L = t();

const classes = ['app-shell', className].filter(Boolean).join(' ');

// Flatten groups into items + children for the mobile drawer
const drawerItems = groups.map((group) => ({
  label: group.label,
  items: group.items.flatMap((item) => {
    const base = { ...item, children: undefined as undefined };
    if (!item.children?.length) return [base];
    return [base, ...item.children.map((c) => ({ ...c, isChild: true as const }))];
  }) as Array<NavItem & { isChild?: boolean; children: undefined }>,
}));
---

<div
  class={classes}

  x-data="themeApp()"
  x-init="init()"
>
  <Sidebar groups={groups} />

  <div class="main-area">
    <Header title={title}>
      <slot name="actions" slot="actions" />
    </Header>
    <main class="page-content">
      <div class="demo-banner" data-demo-banner hidden role="status">
        <span class="demo-banner__dot" aria-hidden="true"></span>
        {L.layout.demoBanner}
      </div>
      <slot />
    </main>
  </div>

  {/* Mobile drawer (hidden on desktop via CSS) */}
  <div class="drawer" id="primary-drawer" data-mobile-panel hidden aria-hidden="true">
    <div class="drawer__backdrop" data-mobile-backdrop></div>
    <div class="drawer__panel" role="dialog" aria-modal="true" aria-label={L.layout.menuAria}>
      <div class="drawer__header">
        <div class="drawer__brand">
          <span class="drawer__brand-icon u-surface" aria-hidden="true">
            <Icon name="dumbbell" size={20} />
          </span>
          <span class="drawer__brand-text">Gym Empire</span>
        </div>
        <button
          type="button"
          class="drawer__close"
          aria-label={L.layout.closeMenu}
          data-mobile-close
        >
          <Icon name="closeCross" size={20} />
        </button>
      </div>

      <nav class="drawer__nav" aria-label={L.layout.mobileNavAria}>
        {drawerItems.map((group) => (
          <div class="drawer__group">
            <div class="drawer__group-label">{group.label}</div>
            {group.items.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'drawer__item',
                  item.active && 'is-active',
                  item.isChild && 'drawer__item--child',
                ]}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.icon && (
                  <span
                    class="drawer__item-icon"
                    aria-hidden="true"
                    set:html={renderIcon(item.icon)}
                  />
                )}
                <span class="drawer__item-label">{item.label}</span>
              </a>
            ))}
          </div>
        ))}
      </nav>

      {/* Footer - user session + logout */}
      <div class="drawer__user u-surface" data-user-zone hidden>
        <div class="drawer__user-info">
          <span class="drawer__user-label">{L.layout.signedInAs}</span>
          <span class="drawer__user-name" data-user-name>
            --
          </span>
          <span class="drawer__user-email" data-user-email>
            --
          </span>
        </div>
        <button type="button" class="drawer__logout" data-logout aria-label={L.layout.logoutAria}>
          <Icon name="logout" size={16} />
          <span>{L.layout.logout}</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { registerAlpine } from '../../lib/alpine';
  // Mobile drawer toggle
  (() => {
    const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-mobile-panel]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-mobile-close]');
    const backdrop = document.querySelector<HTMLElement>('[data-mobile-backdrop]');

    if (!toggle || !panel) return;

    let previouslyFocused: HTMLElement | null = null;

    const open = () => {
      previouslyFocused =
        document.activeElement instanceof HTMLElement ? document.activeElement : null;
      panel.hidden = false;
      panel.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => {
        panel.classList.add('is-open');
        closeBtn?.focus();
      });
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      if (panel.hidden) return;
      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      window.setTimeout(() => {
        if (panel && !panel.classList.contains('is-open')) {
          panel.hidden = true;
          previouslyFocused?.focus();
          previouslyFocused = null;
        }
      }, 240);
    };

    toggle.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    backdrop?.addEventListener('click', close);

    const getFocusable = (): HTMLElement[] =>
      Array.from(
        panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((element) => !element.hasAttribute('hidden'));

    document.addEventListener('keydown', (e) => {
      if (panel.hidden) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab' || !panel.classList.contains('is-open')) return;

      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });

    panel.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
      a.addEventListener('click', () => close());
    });
  })();

  // Auth gate + session display
  import { getAuth, clearAuth } from '../../lib/auth';
  import { logoutFromDemoAccount } from '../../lib/demo-account';
  import { localizedPath } from '../../i18n';

  const logout = () => {
    // Un compte démo restaure les données réelles sauvegardées à l'entrée.
    if (!logoutFromDemoAccount()) clearAuth();
    window.location.href = localizedPath('/login');
  };

  document.querySelectorAll<HTMLButtonElement>('[data-logout]').forEach((btn) => {
    btn.addEventListener('click', logout);
  });

  const auth = getAuth();
  if (auth?.demo) {
    document.querySelector<HTMLElement>('[data-demo-banner]')?.removeAttribute('hidden');
  }
  if (auth) {
    document.querySelectorAll<HTMLElement>('[data-user-name]').forEach((el) => {
      el.textContent = auth.name;
    });
    document.querySelectorAll<HTMLElement>('[data-user-email]').forEach((el) => {
      el.textContent = auth.email;
    });
    document.querySelectorAll<HTMLElement>('[data-user-zone]').forEach((el) => {
      el.removeAttribute('hidden');
    });
  } else {
    window.location.replace('/login');
  }

  // The sidebar is persisted by Astro's client router, so refresh its
  // active-link styling after a page swap without touching accordion state.
  const syncSidebarActiveState = () => {
    const currentPath = window.location.pathname;
    const isCurrent = (href: string) => {
      const path = new URL(href, window.location.origin).pathname;
      return currentPath === path;
    };

    document.querySelectorAll<HTMLElement>('.sidebar .nav-item-wrap').forEach((wrap) => {
      const children = Array.from(wrap.querySelectorAll<HTMLAnchorElement>('.nav-child'));
      if (children.length > 0) {
        const childActive = children.some((link) => {
          const active = isCurrent(link.href);
          link.classList.toggle('is-active', active);
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
          return active;
        });
        wrap
          .querySelector('.nav-item--toggle')
          ?.classList.toggle('nav-item--parent-active', childActive);
        return;
      }

      const link = wrap.querySelector<HTMLAnchorElement>('.nav-item:not(.nav-item--toggle)');
      if (!link) return;
      const active = isCurrent(link.href);
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };

  syncSidebarActiveState();
  document.addEventListener('astro:after-swap', syncSidebarActiveState);

  // Theme + nav accordion Alpine data factory
  const ACCORDION_KEY = 'muscu:nav:collapsed';

  function readCollapsed(): string[] {
    try {
      const raw = window.localStorage.getItem(ACCORDION_KEY);
      const saved = raw ? JSON.parse(raw) : [];
      return Array.isArray(saved) ? saved : [];
    } catch {
      return [];
    }
  }

  registerAlpine('themeApp', () => ({
    theme: 'dark' as 'dark' | 'light',
    collapsed: [] as string[],
    navReady: false,

    init() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      this.theme = current === 'light' ? 'light' : 'dark';
      this.collapsed = readCollapsed();

      // Let Alpine apply the restored accordion state without a transition;
      // transitions are enabled again for subsequent user interactions.
      requestAnimationFrame(() => {
        this.navReady = true;
      });
    },

    toggleTheme() {
      this.theme = this.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', this.theme);
      try {
        window.localStorage.setItem('muscu-theme', this.theme);
      } catch {}
    },

    isDark(): boolean {
      return this.theme === 'dark';
    },

    isExpanded(id: string): boolean {
      return !this.collapsed.includes(id);
    },

    toggleNav(id: string) {
      const i = this.collapsed.indexOf(id);
      if (i >= 0) this.collapsed.splice(i, 1);
      else this.collapsed.push(id);
      try {
        window.localStorage.setItem(ACCORDION_KEY, JSON.stringify(this.collapsed));
      } catch {}
    },
  }));
</script>
