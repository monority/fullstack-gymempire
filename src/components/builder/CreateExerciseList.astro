---
import { resolveLocale } from '../../i18n';

/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
import { t } from '../../i18n';
import Card from '../ui/Card.astro';
import CardContent from '../ui/CardContent.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import IconButton from '../ui/IconButton.astro';
import Badge from '../ui/Badge.astro';
import SetEditor from '../workout/SetEditor.astro';
import SetEditorHeader from '../workout/SetEditorHeader.astro';
import { icons } from '../../lib/icons';

const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
const setTypes = [
  { value: 'warmup', label: L.builder.types.warmup },
  { value: 'work', label: L.builder.types.work },
  { value: 'top', label: L.builder.types.top },
  { value: 'drop', label: L.builder.types.drop },
  { value: 'failure', label: L.builder.types.failure },
] as const;
---

<template x-if="exercises.length === 0">
  <Card>
    <div class="create__empty-state">
      <div class="create__empty-icon" aria-hidden="true">
        <Icon name="dumbbellBox" size={48} />
      </div>
      <h3 class="create__empty-title" x-text="labels.noExoAdded">
        {L.builder.noExoAdded}
      </h3>
      <p class="create__empty-desc" x-text="labels.noExoDesc">
        {L.builder.noExoDesc}
      </p>
      <Button class="create__empty-add-btn" @click="openPicker()">
        <Icon name="plus" size={20} />
        <span>{L.builder.addExercise}</span>
      </Button>
    </div>
  </Card>
</template>

<template x-for="(ex, exIdx) in exercises" :key="ex.exerciseId + '-' + exIdx">
  <div x-data="exerciseCard(ex, exIdx)">
    <Card>
      <div
        class="ses-ex-superset-bar create__superset-bar"
        data-advanced-only
        x-show="exercise.supersetId != null"
        x-cloak
        :class="'ses-superset-bar--g' + exercise.supersetId"
      >
        <span class="ses-superset-dot" aria-hidden="true"></span>
        <Icon name="link" size={16} class="create__superset-bar-icon" />
        <span class="create__superset-bar-label">
          <span x-text="labels.supersetLabel + ' ' + exercise.supersetId">Superset</span>
        </span>
        <IconButton
          variant="ghost"
          icon={icons.closeX(18, 18)}
          label={L.builder.supersetRemove}
          title={L.builder.supersetRemove}
          @click="$dispatch('builder:remove-superset', { index: exerciseIndex })"
        />
      </div>

      <div class="ses-ex-header create__ex-header">
        <button
          type="button"
          class="ses-ex-toggle create__ex-toggle"
          @click="toggle()"
          :aria-expanded="expanded.toString()"
          :aria-controls="'ses-ex-body-' + exerciseIndex"
        >
          <div class="create__toggle-body">
            <div class="ses-ex-head create__ex-head">
              <h3 class="create__ex-name" x-text="$store.i18n.trExercise(exercise.name)"></h3>
              <Badge
                variant="category"
                :class="'badge--cat-' + $store.i18n.muscleHue(exercise.muscle)"
                x-text="$store.i18n.trMuscle(exercise.muscle)"
              />
            </div>
            <p class="create__ex-summary" x-show="!expanded" x-cloak x-text="summary"></p>
          </div>
          <span class="ses-chevron create__ex-chevron" :class="{ 'is-open': expanded }">
            <Icon name="chevronDown" size={20} />
          </span>
        </button>
        <select
          class="input input--sm create__superset-select"
          data-advanced-only
          @change="setSupersetGroup(exerciseIndex, $event.target.value)"
          aria-label={L.builder.supersetFor}
          title={L.builder.supersetHint}
        >
          <option value="" :selected="exercise.supersetId == null">
            {L.builder.supersetNone}
          </option>
          <template x-for="gid in availableSupersetIds()" :key="gid">
            <option
              :value="gid"
              :selected="exercise.supersetId === gid"
              x-text={`'${L.builder.supersetLabel} ' + gid`}
            ></option>
          </template>
          <option value="new">{L.builder.newSuperset}</option>
        </select>
        <IconButton
          variant="danger"
          icon={icons.trash(18, 18)}
          label={L.builder.removeExerciseAria}
          title={L.builder.removeExerciseTitle}
          @click="remove()"
        />
      </div>

      <div :id="'ses-ex-body-' + exerciseIndex" class="create__ex-body" x-show="expanded" x-cloak>
        <CardContent>
          <div
            class="create__sets-scroll"
            role="table"
            :aria-label="labels.setsFor + ' ' + exercise.name"
          >
            <SetEditorHeader
              labels={{
                type: L.builder.setTypeHeader,
                weight: L.builder.weightHeader,
                reps: L.common.reps,
              }}
              unitExpr="unit"
              variant="table"
            />
            <template x-for="(set, setIdx) in exercise.sets" :key="setIdx">
              <SetEditor
                options={setTypes.map((t) => ({ value: t.value, label: t.label }))}
                labels={{
                  type: L.builder.setTypeHeader,
                  weight: L.builder.weight,
                  reps: L.common.reps,
                  deleteSet: L.builder.deleteSet,
                  typeLabel: L.builder.setTypeLabel,
                  weightLabel: L.builder.weightForSet,
                  repsLabel: L.builder.repsForSet,
                }}
                numberExpr="set.setNumber"
                indexExpr="setIdx + 1"
                typeModel="set.type"
                weightValue="displayWeight(set.weight)"
                weightChange="storeWeight($event.target, set)"
                repsModel="set.reps"
                deleteAction="removeSet(setIdx)"
                cantDeleteExpr="exercise.sets.length <= 1"
                unitExpr="unit"
                variant="table"
                mrvAction="applyMrv(setIdx)"
                mrvTitleExpr="mrvTitle(setIdx)"
                mrvEnabledExpr="mrvEnabled(setIdx)"
                mrvLabel="MRV"
              />
            </template>
          </div>

          <div class="ses-ex-actions create__ex-actions">
            <Button
              variant="ghost"
              size="sm"
              @click="generateWarmup()"
              :disabled="!canWarmup"
              x-bind:title={`canWarmup ? ${JSON.stringify(L.builder.warmupTitle)} : ${JSON.stringify(L.builder.warmupHint)}`}
              aria-label={L.builder.warmupBtn}
            >
              <Icon name="zap" size={18} />
              <span>{L.builder.warmupBtn}</span>
            </Button>
            <Button variant="secondary" size="sm" @click="addSet()">
              <Icon name="plus" size={18} />
              <span>{L.builder.addSet}</span>
            </Button>
          </div>
        </CardContent>
      </div>
    </Card>
  </div>
</template>

<template x-if="exercises.length > 0">
  <div class="create__add-wrap">
    <Button class="create__add-btn" @click="openPicker()">
      <Icon name="plus" size={20} />
      <span>{L.builder.addExercise}</span>
    </Button>
  </div>
</template>

<div
  class="create__validation"
  x-show="!canSave && (sessionName.trim() || exercises.length > 0)"
  x-cloak
>
  <template x-if="!sessionName.trim()">
    <span x-text="labels.needName">{L.builder.needName}</span>
  </template>
  <template x-if="sessionName.trim() && exercises.length === 0">
    <span x-text="labels.needExo">{L.builder.needExo}</span>
  </template>
  <template x-if="sessionName.trim() && exercises.length > 0 && exercises.some((exercise) => exercise.sets.length === 0)">
    <span x-text="labels.needSets">{L.builder.needSets}</span>
  </template>
</div>
