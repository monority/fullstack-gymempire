---
import { t } from '../../i18n';
import Dialog from '../ui/Dialog.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import Input from '../ui/Input.astro';
import { TRAINING_TEMPLATES } from '../../lib/templates';
import { trTemplateName, trTemplateDesc, localizedPath } from '../../i18n';
const L = t();
---

<Dialog id="ses-picker-dialog" title={L.builder.pickerTitle}>
  <div class="create__picker">
    <div class="create__picker-search">
      <span class="create__picker-search-icon">
        <Icon name="searchLine" size={20} />
      </span>
      <Input
        type="search"
        class="create__picker-input ses-search-input"
        placeholder={L.builder.searchPlaceholder}
        x-model="exerciseSearch"
        aria-label={L.builder.searchAria}
        x-ref="pickerSearch"
        @keydown.escape="closeDialogById('ses-picker-dialog')"
        autocomplete="off"
      />
    </div>

    <div class="create__picker-filters" role="group" aria-label={L.builder.allMuscles}>
      <button
        type="button"
        class="create__picker-filter"
        :class="{ 'is-active': exerciseMuscleFilter === '' }"
        :aria-pressed="(exerciseMuscleFilter === '').toString()"
        @click="exerciseMuscleFilter = ''"
      >
        {L.builder.allMuscles}
      </button>
      <template x-for="muscle in muscleFilters" :key="muscle">
        <button
          type="button"
          class="create__picker-filter"
          :class="{ 'is-active': exerciseMuscleFilter === muscle }"
          :aria-pressed="(exerciseMuscleFilter === muscle).toString()"
          @click="exerciseMuscleFilter = muscle"
          x-text="trMuscle(muscle)"
        ></button>
      </template>
    </div>

    <div class="create__picker-templates" x-show="exerciseSearch.trim() === ''">
      <div class="create__picker-templates-head">
        <span class="create__picker-templates-title">Templates</span>
        <span class="create__picker-templates-hint">{L.builder.templateHint}</span>
      </div>
      <div class="create__picker-templates-grid">
        {TRAINING_TEMPLATES.map((tpl) => (
          <button type="button" class="create__picker-tpl" @click={`loadTemplate('${tpl.id}')`}>
            <span class="create__picker-tpl-name">{trTemplateName(tpl.name)}</span>
            <span class="create__picker-tpl-desc">{trTemplateDesc(tpl.id)}</span>
            <span class="create__picker-tpl-count">
              {tpl.exercises.length} {L.builder.exercisesWord}
            </span>
          </button>
        ))}
      </div>
    </div>

    <div class="create__picker-list" role="list">
      <template x-if="availableExercises.length === 0">
        <div class="create__picker-empty">
          <p x-text="labels.emptyLibrary">{L.builder.emptyLibrary}</p>
          <a
            href={localizedPath('/exercises')}
            class="create__picker-empty-link"
            x-text="labels.createExoLink"
          >
            {L.builder.createExoLink}
          </a>
        </div>
      </template>

      <template x-if="availableExercises.length > 0 && filteredExercises.length === 0 && exerciseSearch.trim() === ''">
        <div class="create__picker-empty">
          <p x-text="labels.allAdded">{L.builder.allAdded}</p>
        </div>
      </template>

      <template x-if="availableExercises.length > 0 && filteredExercises.length === 0 && exerciseSearch.trim() !== ''">
        <div class="create__picker-empty">
          <p x-text="labels.noSearchMatch">{L.builder.noSearchMatch}</p>
        </div>
      </template>

      <template x-for="ex in filteredExercises" :key="ex.id">
        <div class="create__picker-item" role="listitem">
          <button
            type="button"
            class="create__picker-item-btn"
            @click="addExercise(ex)"
            :aria-label="labels.addExoAria + ' ' + ex.name + ' ' + labels.toSession"
          >
            <span class="create__picker-item-name" x-text="trExercise(ex.name)"></span>
            <Badge
              variant="category"
              size="sm"
              :class="'badge--cat-' + muscleHue(ex.muscle)"
              x-text="trMuscle(ex.muscle)"
            />
          </button>
          <button
            type="button"
            class="create__picker-tip-toggle"
            @click="toggleTip(ex.id)"
            :aria-expanded="isTipOpen(ex.id).toString()"
            :aria-label="labels.showTipAria + ' ' + ex.name"
            title={L.builder.tipTitle}
            x-show="hasTip(ex.name)"
          >
            <Icon name="infoCircle" size={18} />
          </button>
          <p
            class="create__picker-tip ses-picker-tip"
            x-show="isTipOpen(ex.id) && hasTip(ex.name)"
            x-cloak
          >
            <span x-text="getTip(ex.name)"></span>
            <a
              class="create__picker-tip-video ses-tip-video"
              :href="getVideoUrl(ex.name)"
              target="_blank"
              rel="noopener noreferrer"
              :aria-label="labels.videoAria + ' ' + ex.name + ' ' + labels.onYoutube"
              title={L.builder.videoTitle}
            >
              <Icon name="play" size={20} />
              <span x-text="labels.seeTechnique">Voir la technique</span>
            </a>
          </p>
        </div>
      </template>
    </div>
  </div>

  <div slot="footer">
    <Button variant="secondary" data-dialog-close>
      {' '}
      {L.builder.close}{' '}
    </Button>
  </div>
</Dialog>

<style>
  .ses-picker-tip::before {
    content: '';
    display: inline-block;
    width: 0.9rem;
    height: 0.9rem;
    margin-right: 0.7rem;
    vertical-align: middle;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
  }

  .ses-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .create__picker {
    display: flex;
    flex-direction: column;
    max-height: 80vh;
  }

  .create__picker-search {
    position: relative;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    padding: 0.8rem 1.2rem;
  }

  .create__picker-filters {
    display: flex;
    gap: 0.6rem;
    padding: 0.8rem 1.2rem;
    overflow-x: auto;
    border-bottom: 1px solid var(--color-border);
    scrollbar-width: none;
  }

  .create__picker-filters::-webkit-scrollbar {
    display: none;
  }

  .create__picker-filter {
    flex: 0 0 auto;
    min-height: 3.6rem;
    padding: 0 1rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .create__picker-filter:hover,
  .create__picker-filter.is-active {
    color: var(--color-accent);
  }

  .create__picker-filter.is-active {
    border-bottom-color: var(--color-accent);
  }

  .create__picker-filter:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .create__picker-search-icon {
    color: var(--color-muted);
    margin-right: 0.8rem;
    flex-shrink: 0;
  }

  .create__picker-input {
    background-color: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
    font-size: 1.4rem;
    flex: 1 1 0%;
    min-width: 0;
  }

  .create__picker-templates {
    border-bottom: 1px solid var(--color-border);
    padding: 1.2rem;
  }

  .create__picker-templates-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .create__picker-templates-title {
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .create__picker-templates-hint {
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  .create__picker-templates-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
  }

  .create__picker-tpl {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.2rem;
    border-radius: 0;
    border: 1px solid var(--color-border);
    background-color: transparent;
    text-align: left;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .create__picker-tpl:hover {
    border-color: var(--color-accent);
    background-color: transparent;
  }

  .create__picker-tpl-name {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .create__picker-tpl-desc {
    font-size: 1.1rem;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
  }

  .create__picker-tpl-count {
    font-size: 1.1rem;
    color: var(--color-muted);
    margin-top: 0.2rem;
  }

  .create__picker-list {
    flex: 1 1 0%;
    overflow-y: auto;
  }

  .create__picker-empty {
    padding: 2.4rem 1.2rem;
    text-align: center;
    font-size: 1.3rem;
    color: var(--color-muted);
  }

  .create__picker-empty-link {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .create__picker-item {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
  }

  .create__picker-item-btn {
    flex: 1 1 0%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    padding: 1rem 1.2rem;
    min-height: 4.8rem;
    text-align: left;
    background: none;
    border: none;
    border-radius: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .create__picker-item-btn:hover {
    background-color: var(--alpha-bg-subtle);
  }

  .create__picker-item-btn:active {
    background-color: var(--alpha-bg-soft);
  }

  .create__picker-item-btn:focus-visible {
    outline: none;
    box-shadow: inset var(--focus-ring);
  }

  .create__picker-item-name {
    font-size: 1.3rem;
    color: var(--color-text);
  }

  .create__picker-tip-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.4rem;
    min-height: 4.4rem;
    padding: 0.6rem;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .create__picker-tip-toggle:hover {
    color: var(--color-text);
  }

  .create__picker-tip-toggle:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .create__picker-tip {
    padding: 1rem 1.2rem;
    font-size: 1.2rem;
    color: var(--color-muted);
    background-color: var(--color-surface-2);
    border-top: 1px solid var(--color-border);
    line-height: 1.5;
  }

  .create__picker-tip-video {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-accent);
    font-size: 1.1rem;
    margin-top: 0.6rem;
  }
</style>
