---
/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { icons } from '../../lib/icons';
---

<div class="detail__actions">
  <Button
    variant="ghost"
    active
    href="#"
    :href="quickSessionHref()"
    :aria-label="labels.startSession"
    x-show="session?.status !== 'completed'"
  >
    <Icon name="play" size={20} />
    <span x-text="labels.startSession"></span>
  </Button>

  <Button variant="secondary" @click="generateShareCard()">
    <Icon name="share" size={20} />
    <span x-text="labels.share"></span>
  </Button>

  <Button variant="secondary" href="#" :href="compareHref()" :aria-disabled="!session?.id">
    <Icon name="grid" size={20} />
    <span x-text="labels.compare"></span>
  </Button>

  <div class="detail__sheet" role="group">
    <span class="detail__sheet-label u-uppercase" aria-hidden="true"></span>

    <Button variant="secondary" @click="downloadSessionCsv()" :aria-label="labels.downloadCsvAria">
      <Icon name="table" size={20} />
      <span x-text="labels.downloadCsv"></span>
    </Button>

    <Button
      variant="secondary"
      href="#"
      :href="printHref()"
      target="_blank"
      rel="noopener noreferrer"
      :aria-label="labels.printPdfAria"
      :aria-disabled="!session"
    >
      <Icon name="printer" size={20} />
      <span x-text="labels.printPdf"></span>
    </Button>
  </div>

  <Button variant="secondary" size="md" href="#" :href="editHref()">
    <Icon name="edit" size={20} />
    <span x-text="labels.edit"></span>
  </Button>
  <Button variant="destructive" size="md" @click="openDeleteDialog">
    <Fragment set:html={icons.trash()} />
    <span x-text="labels.delete"></span>
  </Button>
</div>

<style>
  .detail__actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .detail__actions > .button {
    min-height: 4.4rem;
  }

  .detail__sheet {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    padding: 1.2rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin: 0.2rem 0;
  }

  .detail__sheet-label {
    font-size: 1.1rem;
    color: var(--color-muted);

    letter-spacing: 0.14em;
    font-weight: 700;
    margin-right: 0.4rem;
  }

  @media (max-width: 640px) {
    .detail__actions {
      align-items: stretch;
      flex-direction: column;
    }
    .detail__actions > .button,
    .detail__sheet {
      width: 100%;
    }
    .detail__sheet > .button {
      flex: 1 1 0%;
    }
  }
</style>
