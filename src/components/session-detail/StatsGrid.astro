---
import { icons } from '../../lib/icons';
---

<div class="detail__stats-grid">
  <div class="detail__stat">
    <div class="detail__stat-label">
      <span class="detail__stat-icon" set:html={icons.clockStopwatch()} />
      <span x-text="labels.duration"></span>
    </div>
    <div class="detail__stat-value" x-text="formatDuration(session.duration)"></div>
  </div>
  <div class="detail__stat detail__stat--volume">
    <div class="detail__stat-label">
      <span class="detail__stat-icon" set:html={icons.volumeBox()} />
      <span x-text="labels.totalVolume"></span>
    </div>
    <div class="detail__stat-value" x-text="formatVolume(sessionTotalVolume)"></div>
  </div>
  <div class="detail__stat">
    <div class="detail__stat-label">
      <span class="detail__stat-icon" set:html={icons.list()} />
      <span x-text="labels.exercises"></span>
    </div>
    <div class="detail__stat-value" x-text="session.exercises.length"></div>
  </div>
</div>

<style>
  /* ── Stats grid ── */
  .detail__stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  @media (min-width: 640px) {
    .detail__stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .detail__stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.8rem 2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .detail__stat-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
  }

  .detail__stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background-color: var(--alpha-bg-subtle);
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .detail__stat-icon svg {
    display: block;
    width: 1.6rem;
    height: 1.6rem;
  }

  .detail__stat-value {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .detail__stat--volume .detail__stat-icon {
    background-color: var(--color-stat-volume-bg);
    color: var(--color-stat-volume);
  }

  .detail__stat--volume .detail__stat-value {
    color: var(--color-stat-volume);
  }
</style>
