---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { icons } from '../../lib/icons';
import { t } from '../../i18n';

const L = t();
---

<section class="detail__exercises">
  <h2 class="detail__section-title">{L.detail.exercises}</h2>

  <template x-if="session.exercises.length === 0">
    <Card>
      <p class="detail__no-exercises">{L.detail.noExercises}</p>
    </Card>
  </template>

  <template x-for="(ex, exIdx) in session.exercises" :key="exIdx">
    <Card>
      <article class="exo-row" :class="supersetTint(ex)">
        <header class="exo-row__head">
          <h3 class="exo-row__name" x-text="trExercise(ex.name)"></h3>
          <div class="exo-row__head-actions">
            <span
              class="exo-row__superset"
              :class="'exo-row__superset--g' + (supersetGroup(ex)?.color ?? 0)"
              :aria-label="supersetLabelFor(ex)"
              :title="supersetMembers(ex)"
              x-show="supersetGroup(ex) != null"
              x-cloak
            >
              <Icon name="link" size={20} />
              <span x-text="supersetLabelFor(ex)"></span>
            </span>
            <Badge
              variant="category"
              size="sm"
              :class="'badge--cat-' + muscleHue(ex.muscle)"
              x-text="trMuscle(ex.muscle)"
            />
          </div>
        </header>

        <div class="exo-row__stats">
          <div class="exo-row__stat">
            <span class="exo-row__stat-label">{L.sessions.volume}</span>
            <span class="exo-row__stat-value" x-text="formatVolume(exerciseVolume(ex))"></span>
          </div>
          <div class="exo-row__stat">
            <span class="exo-row__stat-label">{L.detail.best1RM}</span>
            <span class="exo-row__stat-value" x-text="formatVolume(best1RM(ex))"></span>
          </div>
          <div class="exo-row__stat">
            <span class="exo-row__stat-label">{L.detail.sets}</span>
            <span class="exo-row__stat-value" x-text="ex.sets.length"></span>
          </div>
        </div>

        <div class="exo-row__table-wrap" x-show="ex.sets.length > 0">
          <table class="exo-row__table">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">{L.detail.colType}</th>
                <th scope="col">{L.detail.colWeight}</th>
                <th scope="col">{L.detail.colReps}</th>
                <th scope="col">RPE</th>
                <th scope="col" class="exo-row__th-end">
                  {L.detail.statusLabel}
                </th>
              </tr>
            </thead>
            <tbody>
              <template x-for="set in ex.sets" :key="set.setNumber">
                <tr class="exo-row__tr" :class="{ 'is-completed': set.completed }">
                  <td class="exo-row__num" x-text="set.setNumber"></td>
                  <td>
                    <span
                      class="type-pill"
                      :class="'type-pill--' + set.type"
                      x-text="typeLabel(set.type)"
                    ></span>
                  </td>
                  <td class="exo-row__num exo-row__weight" x-text="formatWeight(set.weight)"></td>
                  <td class="exo-row__num exo-row__reps" x-text="set.reps"></td>
                  <td
                    class="exo-row__rpe"
                    :class="'exo-row__rpe--' + rpeTone(set.rpe)"
                    x-text="formatSetRpe(set)"
                  ></td>
                  <td class="exo-row__td-end">
                    <template x-if="set.completed">
                      <span class="exo-row__check" set:html={icons.check()} />
                    </template>
                    <template x-if="!set.completed">
                      <span class="exo-row__dash">—</span>
                    </template>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
        <p class="exo-row__no-sets" x-show="ex.sets.length === 0">
          {L.detail.noSets}
        </p>
      </article>
    </Card>
  </template>
</section>

<style>
  .exo-row {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .exo-row__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .exo-row__name {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }

  /* ── Superset group badge + row tint ── */
  .exo-row__superset {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.8rem;
    padding: 0 1.1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .exo-row__superset svg {
    width: 1.3rem;
    height: 1.3rem;
    flex-shrink: 0;
  }

  .exo-row__superset--g1 {
    background-color: var(--color-superset-g1-bg);
    color: var(--color-superset-g1);
    border-color: color-mix(in srgb, var(--color-superset-g1) 30%, transparent);
  }

  .exo-row__superset--g2 {
    background-color: var(--color-superset-g2-bg);
    color: var(--color-superset-g2);
    border-color: color-mix(in srgb, var(--color-superset-g2) 30%, transparent);
  }

  .exo-row__superset--g3 {
    background-color: var(--color-superset-g3-bg);
    color: var(--color-superset-g3);
    border-color: color-mix(in srgb, var(--color-superset-g3) 30%, transparent);
  }

  .exo-row__superset--g4 {
    background-color: var(--color-superset-g4-bg);
    color: var(--color-superset-g4);
    border-color: color-mix(in srgb, var(--color-superset-g4) 30%, transparent);
  }

  .exo-row__superset--g5 {
    background-color: var(--color-superset-g5-bg);
    color: var(--color-superset-g5);
    border-color: color-mix(in srgb, var(--color-superset-g5) 30%, transparent);
  }

  .exo-row--g1 {
    background-color: color-mix(in srgb, var(--color-superset-g1) 6%, transparent);
  }

  .exo-row--g2 {
    background-color: color-mix(in srgb, var(--color-superset-g2) 6%, transparent);
  }

  .exo-row--g3 {
    background-color: color-mix(in srgb, var(--color-superset-g3) 6%, transparent);
  }

  .exo-row--g4 {
    background-color: color-mix(in srgb, var(--color-superset-g4) 6%, transparent);
  }

  .exo-row--g5 {
    background-color: color-mix(in srgb, var(--color-superset-g5) 6%, transparent);
  }

  /* ── Per-exercise header actions ── */
  .exo-row__head-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  /* ── Per-exercise stats ── */
  .exo-row__stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 0.4rem 0 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .exo-row__stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .exo-row__stat-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .exo-row__stat-value {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .exo-row__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.3rem;
  }

  .exo-row__table thead th {
    background-color: var(--color-surface-3);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-align: left;
    padding: 1.2rem 1.4rem;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .exo-row__th-end {
    text-align: right !important;
  }

  .exo-row__table tbody td {
    padding: 1rem 1.4rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .exo-row__table tbody tr:last-child td {
    border-bottom: none;
  }

  .exo-row__table tbody tr:nth-child(even) {
    background-color: var(--color-surface-2);
  }

  .exo-row__tr.is-completed {
    color: var(--color-text);
  }

  .exo-row__num {
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .exo-row__weight,
  .exo-row__reps {
    color: var(--color-text);
    font-size: 1.4rem;
  }

  .exo-row__rpe {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .exo-row__rpe--easy {
    color: var(--color-success);
  }

  .exo-row__rpe--moderate {
    color: var(--color-warning);
  }

  .exo-row__rpe--hard {
    color: var(--color-accent);
  }

  .exo-row__rpe--max {
    color: var(--color-destructive);
  }

  .exo-row__rpe--none {
    color: var(--color-muted);
  }

  .exo-row__td-end {
    text-align: right;
  }

  /* ── Check / dash ── */
  .exo-row__check {
    color: var(--color-success);
    display: inline-block;
    vertical-align: middle;
  }

  .exo-row__check svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .exo-row__dash {
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .exo-row__no-sets {
    color: var(--color-muted);
    font-size: 1.3rem;
    text-align: center;
    padding: 1.6rem 0 0.4rem;
  }

  @media (max-width: 480px) {
    .detail__stat {
      padding: 1.4rem 1.6rem;
    }
    .detail__stat-value {
      font-size: 2rem;
    }
    .exo-row__name {
      font-size: 1.7rem;
    }
    .exo-row__stats {
      gap: 1.4rem;
    }
    .exo-row__stat-value {
      font-size: 1.5rem;
    }
    .exo-row__table thead th,
    .exo-row__table tbody td {
      padding: 0.8rem 1rem;
      font-size: 1.2rem;
    }
    .exo-row__table thead th {
      font-size: 1rem;
    }
  }
</style>
