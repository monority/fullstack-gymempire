---
---

<div class="detail__status-section">
  <label class="detail__status-label" x-text="labels.statusLabel"></label>
  <div class="detail__status-grid" role="group" aria-label="">
    <button
      type="button"
      class="detail__status-btn"
      :class="{ 'is-active': session.status === 'planned' }"
      :aria-pressed="session.status === 'planned'"
      @click="updateStatus('planned')"
    >
      <span class="detail__status-dot detail__status-dot--planned" aria-hidden="true"></span>
      <span x-text="labels.planned"></span>
    </button>
    <button
      type="button"
      class="detail__status-btn"
      :class="{ 'is-active': session.status === 'in-progress' }"
      :aria-pressed="session.status === 'in-progress'"
      @click="updateStatus('in-progress')"
    >
      <span class="detail__status-dot detail__status-dot--in-progress" aria-hidden="true"></span>
      <span x-text="labels.inProgress"></span>
    </button>
    <button
      type="button"
      class="detail__status-btn"
      :class="{ 'is-active': session.status === 'completed' }"
      :aria-pressed="session.status === 'completed'"
      @click="updateStatus('completed')"
    >
      <span class="detail__status-dot detail__status-dot--completed" aria-hidden="true"></span>
      <span x-text="labels.completed"></span>
    </button>
  </div>
</div>

<style>
  /* ── Status section ── */
  .detail__status-section {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .detail__status-label {
    font-size: 1.1rem;
    color: var(--color-muted);

    letter-spacing: 0.14em;
    font-weight: 700;
    line-height: 1;
  }

  .detail__status-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

  @media (min-width: 480px) {
    .detail__status-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .detail__status-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 4.4rem;
    padding: 0 1.2rem;
    background-color: var(--color-surface);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .detail__status-btn:hover:not(.is-active) {
    background-color: var(--color-surface-2);
    color: var(--color-text);
    border-color: var(--alpha-border);
  }

  .detail__status-btn:active {
    transform: scale(0.98);
  }

  .detail__status-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .detail__status-btn.is-active {
    cursor: default;
  }

  .detail__status-btn:has(.detail__status-dot--planned).is-active {
    background-color: var(--alpha-bg-soft);
    color: var(--color-text);
    border-color: var(--alpha-border);
  }

  .detail__status-btn:has(.detail__status-dot--in-progress).is-active {
    background-color: color-mix(in srgb, var(--color-info) 12%, transparent);
    color: var(--color-info);
    border-color: color-mix(in srgb, var(--color-info) 40%, transparent);
  }

  .detail__status-btn:has(.detail__status-dot--completed).is-active {
    background-color: color-mix(in srgb, var(--color-success) 12%, transparent);
    color: var(--color-success);
    border-color: color-mix(in srgb, var(--color-success) 40%, transparent);
  }

  .detail__status-dot {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    flex-shrink: 0;
    background-color: var(--color-muted);
    box-shadow: 0 0 0 2px var(--color-surface-2);
  }

  .detail__status-dot--planned {
    background-color: var(--color-muted);
  }

  .detail__status-dot--in-progress {
    background-color: var(--color-info);
  }

  .detail__status-dot--completed {
    background-color: var(--color-success);
  }
</style>
