---
/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
import { t } from '../../i18n';
import Card from '../ui/Card.astro';
import CardHeader from '../ui/CardHeader.astro';
import CardTitle from '../ui/CardTitle.astro';
import CardContent from '../ui/CardContent.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
const L = t();
---

<Card>
  <CardHeader>
    <CardTitle>{L.poids.newMeasure}</CardTitle>
  </CardHeader>
  <CardContent>
    <form class="poids__form" @submit.prevent="addEntry()">
      <div class="poids__grid">
        <Input
          label={L.poids.date}
          id="poids-date"
          type="date"
          x-model="form.date"
          required
          class="poids__input"
        />
        <Input
          label={L.poids.weightLabel}
          id="poids-weight"
          type="number"
          step="0.1"
          min="20"
          max="300"
          inputmode="decimal"
          :value="displayWeight(form.weight ?? 0)"
          @change="storeWeight($event.target)"
          :placeholder="unit === 'lbs' ? 'Ex. 180' : 'Ex. 82.5'"
          required
          class="poids__input"
        />
        <Input
          label={L.poids.armLabel}
          id="poids-arm"
          type="number"
          step="0.1"
          min="0"
          inputmode="decimal"
          x-model.number="form.arm"
          placeholder="—"
          class="poids__input"
        />
        <Input
          label={L.poids.chestLabel}
          id="poids-chest"
          type="number"
          step="0.1"
          min="0"
          inputmode="decimal"
          x-model.number="form.chest"
          placeholder="—"
          class="poids__input"
        />
        <Input
          label={L.poids.waistLabel}
          id="poids-waist"
          type="number"
          step="0.1"
          min="0"
          inputmode="decimal"
          x-model.number="form.waist"
          placeholder="—"
          class="poids__input"
        />
        <Input
          label={L.poids.hipsLabel}
          id="poids-hips"
          type="number"
          step="0.1"
          min="0"
          inputmode="decimal"
          x-model.number="form.hips"
          placeholder="—"
          class="poids__input"
        />
      </div>

      <p
        class="poids__error"
        x-show="formError"
        x-text="formError"
        x-cloak
        x-transition.opacity.duration.180ms
        role="alert"
      ></p>
      <p
        class="poids__success"
        x-show="success"
        x-text="success"
        x-cloak
        x-transition.opacity.duration.180ms
        role="status"
        aria-live="polite"
      ></p>

      <div class="poids__actions">
        <Button type="button" variant="secondary" size="md" @click="resetForm()">
          {L.common.reset}
        </Button>
        <Button type="submit" variant="primary" size="md">
          {L.poids.save}
        </Button>
      </div>
    </form>
  </CardContent>
</Card>
