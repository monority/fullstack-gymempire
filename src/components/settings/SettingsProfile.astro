---
import { resolveLocale } from '../../i18n';

/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
import { t } from '../../i18n';
import SettingsSection from '../ui/SettingsSection.astro';
import Input from '../ui/Input.astro';
import Segmented from '../ui/Segmented.astro';
const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
---

<SettingsSection
  icon="user"
  title={L.settings.profile}
  description={L.settings.profileDesc}
  id="set-profile"
>
  <div class="set__rows">
    <div class="set__row">
      <div class="set__label">
        <span class="set__label-title">{L.settings.pseudo}</span>
        <span class="set__label-desc">{L.settings.pseudoDesc}</span>
      </div>
      <div class="set__control">
        <Input
          bare
          size="md"
          type="text"
          id="set-pseudo"
          class="set__sync-input"
          x-model="display.pseudo"
          @change="savePseudo()"
          :placeholder="labels.pseudoPlaceholder"
          maxlength="40"
          autocomplete="nickname"
          :aria-label="labels.pseudoPlaceholder"
        />
      </div>
    </div>
    <div class="set__row">
      <div class="set__label">
        <span class="set__label-title">{L.settings.email}</span>
        <span class="set__label-desc">{L.settings.emailDesc}</span>
      </div>
      <div class="set__control">
        <Input
          bare
          size="md"
          type="email"
          id="set-email"
          class="set__sync-input"
          x-model="display.email"
          @change="saveEmail()"
          :placeholder="labels.emailPlaceholder"
          autocomplete="email"
          :aria-label="labels.emailPlaceholder"
        />
      </div>
    </div>
  </div>
</SettingsSection>
<SettingsSection
  icon="ruler"
  title={L.settings.units}
  description={L.settings.unitsDesc}
  id="set-units"
>
  <div class="set__rows">
    <div class="set__row">
      <div class="set__label">
        <span class="set__label-title">{L.settings.weightUnit}</span>
        <span class="set__label-desc">{L.settings.weightUnitDesc}</span>
      </div>
      <Segmented
        items={[
          { value: 'kg', label: 'kg', action: "setUnit('kg')" },
          { value: 'lbs', label: 'lbs', action: "setUnit('lbs')" },
        ]}
        model="display.unit"
        ariaLabel={L.settings.weightUnit}
      />
    </div>
  </div>
</SettingsSection>
