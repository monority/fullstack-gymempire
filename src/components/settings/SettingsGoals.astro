---
import { t } from '../../i18n';
import SettingsSection from '../ui/SettingsSection.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Toggle from '../ui/Toggle.astro';
const L = t();
const restOptions = (await import('../../lib/settings-stats')).formatRestOptions();
---

3. OBJECTIFS
<SettingsSection
  icon="target"
  title={L.settings.goals}
  description={L.settings.goalsDesc}
  id="set-goals"
>
  <div class="set__rows">
    <div class="set__row set__row--start">
      <div class="set__label">
        <span class="set__label-title">{L.settings.weeklyGoalCount}</span>
        <span class="set__label-desc">{L.settings.weeklyGoalTrackedDesc}</span>
      </div>
      <div class="set__control set__control--right">
        <div class="set__goal-wrap">
          <Button
            variant="ghost"
            iconLabel={L.settings.weeklyGoalDecrease}
            @click="setWeeklyGoal(display.weeklyGoal - 1)"
            class="set__goal-btn"
          >
            <Icon name="minus" size={24} slot="icon" />
          </Button>
          <input
            id="set-weekly-goal"
            type="number"
            min="1"
            max="7"
            step="1"
            inputmode="numeric"
            class="set__goal-input"
            :value="display.weeklyGoal"
            @change="setWeeklyGoal(parseInt($event.target.value, 10))"
            aria-label={L.settings.weeklyGoalCount}
          />
          <Button
            variant="ghost"
            iconLabel={L.settings.weeklyGoalIncrease}
            @click="setWeeklyGoal(display.weeklyGoal + 1)"
            class="set__goal-btn"
          >
            <Icon name="plus" size={24} slot="icon" />
          </Button>
        </div>
      </div>
    </div>

    <div class="set__row set__row--start">
      <div class="set__label">
        <span class="set__label-title">{L.settings.weeklyProgress}</span>
        <span class="set__label-desc">{L.settings.weeklyProgressDesc}</span>
      </div>
      <div class="set__control set__control--right">
        <span class="set__progress">
          <span class="set__progress-done" x-text="weeklyDone"></span>
          <span class="set__progress-sep" aria-hidden="true">
            /
          </span>
          <span class="set__progress-goal" x-text="display.weeklyGoal"></span>
          <span class="set__progress-unit" x-text="labels.seanceSingular">
            {L.settings.seanceSingular}
          </span>
          <span class="set__progress-plural" x-text="display.weeklyGoal > 1 ? 's' : ''"></span>
        </span>
      </div>
    </div>
  </div>
</SettingsSection>
4. TIMER
<SettingsSection
  icon="clockStopwatch"
  title={L.settings.timerSettings}
  description={L.settings.timerDesc}
  id="set-timer"
>
  <div class="set__rows">
    <div class="set__row set__row--start">
      <div class="set__label">
        <span class="set__label-title">{L.settings.defaultRestTime}</span>
        <span class="set__label-desc">{L.settings.defaultRestTimeDesc}</span>
      </div>
      <div class="set__control set__control--right">
        <Select
          id="set-rest-time"
          name="restTime"
          aria-label={L.settings.defaultRestTime}
          options={restOptions}
          :value="String(display.defaultRestTime)"
          @change="saveRestTime($event.target.value)"
        />
      </div>
    </div>

    <div class="set__row set__row--start">
      <div class="set__label">
        <span class="set__label-title">{L.settings.soundAlerts}</span>
        <span class="set__label-desc">{L.settings.soundAlertsDesc}</span>
      </div>
      <div class="set__control set__control--right">
        <Toggle
          :checked="display.soundAlerts"
          aria-label={L.settings.soundAlerts}
          :aria-checked="display.soundAlerts ? 'true' : 'false'"
          @change="saveSoundAlerts($event.target.checked)"
        />
      </div>
    </div>
  </div>
</SettingsSection>
<style>
  /* ── Goal input ── */
  .set__goal-wrap {
    display: inline-flex;
    align-items: stretch;
    height: 4.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition:
      border-color 140ms ease,
      box-shadow 140ms ease;
  }

  .set__goal-btn {
    border: 0 !important;
    background: transparent !important;
    min-height: 0 !important;
    min-width: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    flex: 1 !important;
  }

  .set__goal-btn:hover {
    background-color: var(--alpha-bg-subtle) !important;
    color: var(--color-text) !important;
  }

  .set__goal-input {
    -webkit-appearance: textfield;
    appearance: textfield;
    width: 5.2rem;
    height: 100%;
    flex-shrink: 0;
    border: 0;
    border-left: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    background-color: transparent;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    text-align: center;
    font-variant-numeric: tabular-nums;
    outline: none;
    padding: 0;
    line-height: 4.4rem;
  }

  .set__goal-input::-webkit-outer-spin-button,
  .set__goal-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* ── Progress display ── */
  .set__progress {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }

  .set__progress-done {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .set__progress-sep {
    color: var(--color-muted);
    font-size: 1.4rem;
    font-weight: 500;
    margin: 0 0.1rem;
  }

  .set__progress-goal {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }

  .set__progress-unit {
    font-size: 1.1rem;
    color: var(--color-muted);
    font-weight: 500;
    margin-left: 0.3rem;
  }

  .set__progress-plural {
    font-size: 1.1rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .set__heading-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
  }

  .set__heading-icon :global(svg) {
    width: 1.8rem;
    height: 1.8rem;
  }
</style>
