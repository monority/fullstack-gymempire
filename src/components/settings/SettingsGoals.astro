---
import { resolveLocale } from '../../i18n';

/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
import { t } from '../../i18n';
import SettingsSection from '../ui/SettingsSection.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Toggle from '../ui/Toggle.astro';
const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
const restOptions = (await import('../../lib/settings-stats')).formatRestOptions();
---

<SettingsSection
  icon="target"
  title={L.settings.goals}
  description={L.settings.goalsDesc}
  id="set-goals"
>
  <div class="set__rows">
    <div class="set__row set__row--start">
      <div class="set__label">
        <span class="set__label-title">{L.settings.weeklyGoalCount}</span>
        <span class="set__label-desc">{L.settings.weeklyGoalTrackedDesc}</span>
      </div>
      <div class="set__control set__control--right">
        <div class="set__goal-wrap">
          <Button
            variant="ghost"
            iconLabel={L.settings.weeklyGoalDecrease}
            @click="setWeeklyGoal(display.weeklyGoal - 1)"
            class="set__goal-btn"
          >
            <Icon name="minus" size={24} slot="icon" />
          </Button>
          <input
            id="set-weekly-goal"
            type="number"
            min="1"
            max="7"
            step="1"
            inputmode="numeric"
            class="set__goal-input"
            :value="display.weeklyGoal"
            @change="setWeeklyGoal(parseInt($event.target.value, 10))"
            aria-label={L.settings.weeklyGoalCount}
          />
          <Button
            variant="ghost"
            iconLabel={L.settings.weeklyGoalIncrease}
            @click="setWeeklyGoal(display.weeklyGoal + 1)"
            class="set__goal-btn"
          >
            <Icon name="plus" size={24} slot="icon" />
          </Button>
        </div>
      </div>
    </div>

    <div class="set__row set__row--start">
      <div class="set__label">
        <span class="set__label-title">{L.settings.weeklyProgress}</span>
        <span class="set__label-desc">{L.settings.weeklyProgressDesc}</span>
      </div>
      <div class="set__control set__control--right">
        <span class="set__progress">
          <span class="set__progress-done" x-text="weeklyDone"></span>
          <span class="set__progress-sep" aria-hidden="true">
            /
          </span>
          <span class="set__progress-goal" x-text="display.weeklyGoal"></span>
          <span class="set__progress-unit" x-text="labels.seanceSingular">
            {L.settings.seanceSingular}
          </span>
          <span class="set__progress-plural" x-text="display.weeklyGoal > 1 ? 's' : ''"></span>
        </span>
      </div>
    </div>
    <div class="set__row set__row--start">
      <div class="set__label">
        <span class="set__label-title">{L.settings.advancedMode}</span>
        <span class="set__label-desc">{L.settings.advancedModeDesc}</span>
      </div>
      <div class="set__control set__control--right">
        <Toggle
          :checked="display.advancedMode"
          aria-label={L.settings.advancedMode}
          :aria-checked="display.advancedMode ? 'true' : 'false'"
          @change="saveAdvancedMode($event.target.checked)"
        />
      </div>
    </div>
  </div>
</SettingsSection>
<SettingsSection
  icon="clockStopwatch"
  title={L.settings.timerSettings}
  description={L.settings.timerDesc}
  id="set-timer"
>
  <div class="set__rows">
    <div class="set__row set__row--start">
      <div class="set__label">
        <span class="set__label-title">{L.settings.defaultRestTime}</span>
        <span class="set__label-desc">{L.settings.defaultRestTimeDesc}</span>
      </div>
      <div class="set__control set__control--right">
        <Select
          id="set-rest-time"
          name="restTime"
          aria-label={L.settings.defaultRestTime}
          options={restOptions}
          :value="String(display.defaultRestTime)"
          @change="saveRestTime($event.target.value)"
        />
      </div>
    </div>

    <div class="set__row set__row--start">
      <div class="set__label">
        <span class="set__label-title">{L.settings.soundAlerts}</span>
        <span class="set__label-desc">{L.settings.soundAlertsDesc}</span>
      </div>
      <div class="set__control set__control--right">
        <Toggle
          :checked="display.soundAlerts"
          aria-label={L.settings.soundAlerts}
          :aria-checked="display.soundAlerts ? 'true' : 'false'"
          @change="saveSoundAlerts($event.target.checked)"
        />
      </div>
    </div>
  </div>
</SettingsSection>
