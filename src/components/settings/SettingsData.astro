---
import { t } from '../../i18n';
import SettingsSection from '../ui/SettingsSection.astro';
import Card from '../ui/Card.astro';
import CardHeader from '../ui/CardHeader.astro';
import CardTitle from '../ui/CardTitle.astro';
import CardContent from '../ui/CardContent.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
const APP_VERSION = '0.0.1';
const L = t();
---

6. DONNÉES
<SettingsSection
  icon="database"
  title={L.settings.data}
  description={L.settings.dataDesc}
  id="set-data"
>
  <div class="set__data-grid">
    <div class="set__data-tile u-surface">
      <div class="set__data-tile-header">
        <div class="set__data-tile-icon" aria-hidden="true">
          <Icon name="download" size={24} />
        </div>
        <div class="set__data-tile-content">
          <h4 class="set__data-tile-title">{L.settings.exportJSON}</h4>
          <p class="set__data-tile-desc">{L.settings.exportJSONDesc}</p>
        </div>
      </div>
      <Button
        variant="secondary"
        fullWidth
        class="set__data-tile-btn"
        @click="exportData()"
        :disabled="exporting"
      >
        <span x-show="!exporting" x-cloak x-text="labels.download">
          {L.settings.download}
        </span>
        <span x-show="exporting" x-cloak x-text="labels.preparing">
          {L.settings.preparing}
        </span>
      </Button>
    </div>

    <div class="set__data-tile u-surface">
      <div class="set__data-tile-header">
        <div class="set__data-tile-icon" aria-hidden="true">
          <Icon name="table" size={24} />
        </div>
        <div class="set__data-tile-content">
          <h4 class="set__data-tile-title">{L.settings.exportCSV}</h4>
          <p class="set__data-tile-desc">{L.settings.exportCSVDesc}</p>
        </div>
      </div>
      <Button
        variant="secondary"
        fullWidth
        class="set__data-tile-btn"
        @click="exportCSV()"
        :disabled="exportingCsv"
      >
        <span x-show="!exportingCsv" x-cloak x-text="labels.download">
          {L.settings.download}
        </span>
        <span x-show="exportingCsv" x-cloak x-text="labels.preparing">
          {L.settings.preparing}
        </span>
      </Button>
    </div>

    <div class="set__data-tile u-surface">
      <div class="set__data-tile-header">
        <div class="set__data-tile-icon" aria-hidden="true">
          <Icon name="upload" size={24} />
        </div>
        <div class="set__data-tile-content">
          <h4 class="set__data-tile-title">{L.settings.import}</h4>
          <p class="set__data-tile-desc">{L.settings.importDesc}</p>
        </div>
      </div>
      <Button
        variant="secondary"
        fullWidth
        class="set__data-tile-btn"
        @click="triggerImport()"
        :disabled="importing"
      >
        <span x-show="!importing" x-cloak>
          {L.settings.chooseFile}
        </span>
        <span x-show="importing" x-cloak x-text="labels.importing">
          {L.settings.importing}
        </span>
      </Button>
      <input
        type="file"
        accept="application/json,.json"
        class="sr-only set__file-input"
        @change="handleImportFile($event)"
        aria-hidden="true"
        tabindex="-1"
      />
    </div>
  </div>

  {/* Danger zone */}
  <div class="set__danger">
    <div class="set__danger-header">
      <span class="set__danger-badge">DANGER</span>
      <h4 class="set__danger-title">{L.settings.resetAll}</h4>
    </div>
    <p class="set__danger-desc">{L.settings.resetDesc}</p>
    <Button variant="destructive" class="set__danger-btn" @click="askReset()">
      {L.settings.resetAction}
    </Button>
  </div>
</SettingsSection>
7. SYNCHRONISATION WEBDAV
<section class="set__section" id="set-sync">
  <Card>
    <CardHeader>
      <div class="set__sync-heading">
        <span class="set__heading-icon" aria-hidden="true">
          <Icon name="cloud" size={24} />
        </span>
        <CardTitle>{L.settings.sync.title}</CardTitle>
      </div>
      <p class="set__sync-desc">{L.settings.sync.desc}</p>
      <p class="set__sync-cors">{L.settings.sync.corsNote}</p>
    </CardHeader>

    <CardContent>
      <div class="set__sync-fields">
        <div class="set__rows">
          <div class="set__row set__row--start">
            <div class="set__label">
              <label class="set__label-title" for="set-sync-url" x-text="labels.syncUrl">
                {L.settings.sync.url}
              </label>
              <span class="set__label-desc" x-text="labels.syncConflict">
                {L.settings.sync.conflict}
              </span>
            </div>
            <div class="set__control set__control--right">
              <Input
                bare
                size="md"
                type="text"
                id="set-sync-url"
                class="set__sync-input"
                x-model="syncForm.url"
                @change="saveSyncFields()"
                :placeholder="labels.syncUrlPlaceholder"
                autocomplete="url"
                spellcheck="false"
                :aria-label="labels.syncUrl"
              />
            </div>
          </div>

          <div class="set__row set__row--start">
            <div class="set__label">
              <label class="set__label-title" for="set-sync-username">
                {L.settings.sync.username}
              </label>
            </div>
            <div class="set__control set__control--right">
              <Input
                bare
                size="md"
                type="text"
                id="set-sync-username"
                class="set__sync-input"
                x-model="syncForm.username"
                @change="saveSyncFields()"
                :placeholder="labels.syncUsernamePlaceholder"
                autocomplete="username"
                spellcheck="false"
                :aria-label="labels.syncUrl"
              />
            </div>
          </div>

          <div class="set__row set__row--start">
            <div class="set__label">
              <label class="set__label-title" for="set-sync-password">
                {L.settings.sync.password}
              </label>
              <span class="set__label-desc">{L.settings.sync.passwordNote}</span>
            </div>
            <div class="set__control set__control--right">
              <Input
                bare
                size="md"
                type="password"
                id="set-sync-password"
                class="set__sync-input"
                x-model="syncForm.password"
                @change="saveSyncFields()"
                :placeholder="labels.syncPasswordPlaceholder"
                autocomplete="off"
                :aria-label="labels.syncUrl"
              />
            </div>
          </div>
        </div>
      </div>

      {/* Last sync status + Google Drive note */}
      <div class="set__sync-status" x-show="syncConfigured" x-cloak>
        <span class="set__sync-status-label">{L.settings.sync.lastSync}</span>
        <span class="set__sync-status-value" x-text="syncLastLabel"></span>
      </div>
      <p class="set__sync-note">{L.settings.sync.googleDrive}</p>

      {/* Manual-only actions */}
      <div class="set__sync-actions">
        <Button
          variant="secondary"
          type="button"
          class="set__sync-btn"
          :disabled="syncBusy !== null || !syncForm.url.trim()"
          :loading="syncBusy === 'test'"
          @click="testSync()"
        >
          <span x-show="syncBusy !== 'test'" x-cloak x-text="labels.syncTest">
            {L.settings.sync.test}
          </span>
          <span x-show="syncBusy === 'test'" x-cloak x-text="labels.syncTesting">
            {L.settings.sync.testing}
          </span>
        </Button>
        <Button
          variant="primary"
          type="button"
          class="set__sync-btn"
          :disabled="syncBusy !== null || !syncForm.url.trim()"
          :loading="syncBusy === 'push'"
          @click="askPush()"
        >
          <span x-show="syncBusy !== 'push'" x-cloak x-text="labels.syncPush">
            {L.settings.sync.push}
          </span>
          <span x-show="syncBusy === 'push'" x-cloak x-text="labels.syncPushing">
            {L.settings.sync.pushing}
          </span>
        </Button>
        <Button
          variant="secondary"
          type="button"
          class="set__sync-btn"
          :disabled="syncBusy !== null || !syncForm.url.trim()"
          :loading="syncBusy === 'pull'"
          @click="askRestore()"
        >
          <span x-show="syncBusy !== 'pull'" x-cloak x-text="labels.syncPull">
            {L.settings.sync.pull}
          </span>
          <span x-show="syncBusy === 'pull'" x-cloak x-text="labels.syncPulling">
            {L.settings.sync.pulling}
          </span>
        </Button>
      </div>
    </CardContent>
  </Card>
</section>
8. À PROPOS
<SettingsSection
  icon="infoCircle"
  title={L.settings.about}
  description={L.settings.aboutDesc}
  id="set-about"
>
  <dl class="set__about-grid">
    <div class="set__about-row">
      <dt class="set__about-dt">{L.settings.version}</dt>
      <dd class="set__about-dd">
        <span class="set__about-pill">v{APP_VERSION}</span>
      </dd>
    </div>
    <div class="set__about-row">
      <dt class="set__about-dt">{L.settings.storage}</dt>
      <dd class="set__about-dd">{L.settings.storageValue}</dd>
    </div>
    <div class="set__about-row">
      <dt class="set__about-dt">{L.settings.mode}</dt>
      <dd class="set__about-dd">{L.settings.modeValue}</dd>
    </div>
    <div class="set__about-row">
      <dt class="set__about-dt">{L.settings.fonts}</dt>
      <dd class="set__about-dd">Inter</dd>
    </div>
    <div class="set__about-row">
      <dt class="set__about-dt">{L.settings.icons}</dt>
      <dd class="set__about-dd">Lucide</dd>
    </div>
    <div class="set__about-row">
      <dt class="set__about-dt">{L.settings.framework}</dt>
      <dd class="set__about-dd">Astro 7</dd>
    </div>
  </dl>

  <p class="set__about-credits">{L.settings.credits}</p>
</SettingsSection>
<style>
  /* ── Sync input (font + placeholder overrides) ── */
  .set__sync-input {
    font-family: var(--font-body);
    font-size: 1.3rem;
  }

  .set__sync-input::placeholder {
    color: var(--color-muted);
  }

  /* ── Data tiles ── */
  .set__data-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    margin-top: 1.2rem;
  }

  .set__data-tile {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 1.8rem;

    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
    position: relative;
  }

  .set__data-tile:hover {
    border-color: var(--alpha-border);
    box-shadow: var(--shadow-2);
  }

  .set__data-tile-header {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .set__data-tile-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    flex-shrink: 0;

    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
  }

  .set__data-tile-icon :global(svg) {
    width: 1.8rem;
    height: 1.8rem;
  }

  .set__data-tile-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .set__data-tile-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .set__data-tile-desc {
    font-size: 1.15rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.4;
  }

  .set__data-tile-btn {
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* ── Danger zone ── */
  .set__danger {
    margin-top: 2.4rem;
    padding: 1.25rem;
    background-color: color-mix(in srgb, var(--color-destructive) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-destructive) 28%, transparent);
    border-radius: var(--radius-md);
  }

  .set__danger-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .set__danger-badge {
    display: inline-flex;
    align-items: center;
    height: 2.2rem;
    padding: 0 0.5rem;
    background-color: color-mix(in srgb, var(--color-destructive) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-destructive) 40%, transparent);
    border-radius: var(--radius-sm);
    color: var(--color-destructive);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .set__danger-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .set__danger-desc {
    font-size: 1.2rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin-bottom: 1.4rem;
  }

  .set__danger-btn {
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .set__danger-btn:active {
    transform: scale(0.97);
  }

  .set__sync-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .set__sync-desc {
    font-size: 1.2rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.4;
  }

  .set__sync-cors {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .set__sync-fields {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin-top: 1.2rem;
  }

  .set__sync-status {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 1.2rem;
  }

  .set__sync-status-label {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .set__sync-status-value {
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .set__sync-note {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .set__sync-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }

  .set__sync-btn {
    flex: 1 1 auto;
    min-width: 12rem;
  }

  /* ── About section ── */
  .set__about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin-top: 1.2rem;
  }

  .set__about-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--alpha-bg-soft);
    gap: 1rem;
  }

  .set__about-row:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .set__about-dt {
    font-size: 1.2rem;
    color: var(--color-muted);
    font-weight: 500;
    margin: 0;
  }

  .set__about-dd {
    font-family: var(--font-body);
    font-size: 1.3rem;
    color: var(--color-text);
    font-weight: 600;
    margin: 0;
    text-align: right;
  }

  .set__about-pill {
    display: inline-flex;
    align-items: center;
    height: 1.5rem;
    padding: 0 1rem;
    background-color: color-mix(in srgb, var(--color-accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: 9999px;
    color: var(--color-accent);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .set__about-credits {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--alpha-bg-soft);
    font-size: 1.2rem;
    color: var(--color-muted);
    line-height: 1.6;
    font-style: italic;
  }

  /* ── Responsive ── */
  @media (min-width: 640px) {
    .set__data-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .set__about-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0 1.5rem;
    }
    .set__about-row:nth-last-child(-n + 2) {
      border-bottom: 1px solid var(--alpha-bg-soft);
    }
    .set__about-row:nth-last-child(2) {
      border-bottom: none;
    }
  }

  @media (min-width: 1024px) {
    .set__data-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .set {
      gap: 1.4rem;
    }
    .set__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .set__seg-group {
      align-self: flex-start;
    }
    .set__data-tile {
      padding: 1.4rem;
    }
    .set__data-tile-icon {
      width: 3.2rem;
      height: 3.2rem;
    }
    .set__data-tile-icon :global(svg) {
      width: 1.6rem;
      height: 1.6rem;
    }
    .set__heading-icon :global(svg) {
      width: 1.6rem;
      height: 1.6rem;
    }
    .set__control {
      max-width: 100%;
    }
    .set__danger {
      padding: 1.6rem;
    }
    .set__data-tile-header {
      gap: 1rem;
    }
  }
</style>
