---
import { resolveLocale } from '../../i18n';

/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
import { t } from '../../i18n';
import Dialog from '../ui/Dialog.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Badge from '../ui/Badge.astro';
import { icons } from '../../lib/icons';
import DialogFooter from '../ui/DialogFooter.astro';
import Icon from '../ui/Icon.astro';
import SetEditor from '../workout/SetEditor.astro';
import SetEditorHeader from '../workout/SetEditorHeader.astro';

const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);

const SET_TYPE_OPTIONS = [
  { value: 'warmup', label: L.builder.types.warmup },
  { value: 'work', label: L.builder.types.work },
  { value: 'top', label: L.builder.types.top },
  { value: 'drop', label: L.builder.types.drop },
  { value: 'failure', label: L.builder.types.failure },
];
---

<Dialog id="exo-add-to-session-dialog" class="exo__add-dialog-host">
  <div class="exo__add-dialog">
    <header class="exo__add-header">
      <div class="exo__add-header-text">
        <h2 class="exo__add-title" x-text="$store.i18n.trExercise(addingExercise?.name)"></h2>
        <Badge
          variant="category"
          size="sm"
          :class="'badge--cat-' + $store.i18n.muscleHue(addingExercise?.muscle)"
          x-text="$store.i18n.trMuscle(addingExercise?.muscle)"
        />
      </div>
      <button
        type="button"
        class="exo__add-close"
        data-dialog-close
        aria-label={L.common.close}
        @click="closeAddToSession()"
      >
        <Fragment set:html={icons.closeX()} />
      </button>
    </header>

    <Select
      id="exo-add-session"
      label={L.sessions.seanceSingular}
      placeholder={L.rapide.selectSession}
      x-model="addToSessionId"
    >
      <option value="new">+ {L.exercices.newSession}</option>
      <template x-for="s in sessions" :key="s.id">
        <option :value="s.id" x-text="s.name + ' (' + s.date + ')'"></option>
      </template>
    </Select>

    <div x-show="addToSessionId === 'new'" x-cloak x-transition.opacity.duration.180ms>
      <Input
        id="exo-add-session-name"
        label={L.builder.name}
        placeholder="Ex. Push day"
        x-model="newSessionName"
        autocomplete="off"
      />
    </div>

    {/* ── Sets table ── */}
    <div class="exo__add-sets">
      <SetEditorHeader
        labels={{ type: L.builder.type, weight: L.builder.weight, reps: L.common.reps }}
        unitExpr="unit"
        variant="card"
      />
      <template x-for="(set, i) in addSets" :key="i">
        <SetEditor
          options={SET_TYPE_OPTIONS}
          labels={{
            type: L.builder.type,
            weight: L.builder.weight,
            reps: L.common.reps,
            deleteSet: L.builder.deleteSet,
            typeLabel: L.builder.setTypeLabel,
            weightLabel: L.builder.weightForSet,
            repsLabel: L.builder.repsForSet,
          }}
          numberExpr="i + 1"
          indexExpr="i + 1"
          typeModel="set.type"
          weightValue="displayWeight(set.weight)"
          weightChange="storeWeight($event.target, set)"
          repsModel="set.reps"
          deleteAction="removeSetFromConfig(i)"
          cantDeleteExpr="addSets.length <= 1"
          unitExpr="unit"
          variant="card"
        />
      </template>
      <div class="exo__add-sets-actions">
        <button
          type="button"
          class="exo__add-sets-warmup"
          @click="generateWarmup()"
          :disabled="!hasWorkingWeight()"
          :title="hasWorkingWeight() ? labels.warmupTitle : labels.warmupHint"
        >
          <Icon name="plus" size={20} class="exo__add-icon" />
          <span>{L.builder.warmupBtn}</span>
        </button>
        <button type="button" class="exo__add-sets-add" @click="addSetToConfig()">
          <Icon name="plus" size={18} />
          <span>{L.builder.addSet}</span>
        </button>
      </div>
    </div>
  </div>

  <div slot="footer" class="exo__add-actions">
    <DialogFooter
      cancelLabel={L.common.cancel}
      cancelClick="closeAddToSession()"
      confirmLabel={L.exercices.addToSession}
      confirmVariant="primary"
      confirmDisabled="!addToSessionId"
      confirmClick="submitAddToSession()"
    />
  </div>
</Dialog>
