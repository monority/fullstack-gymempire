---
import { t } from '../../i18n';
import Dialog from '../ui/Dialog.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Badge from '../ui/Badge.astro';
import { icons } from '../../lib/icons';
import DialogFooter from '../ui/DialogFooter.astro';
import Icon from '../ui/Icon.astro';
const L = t();
---

<Dialog id="exo-add-to-session-dialog" class="exo__add-dialog-host">
  <div class="exo__add-dialog">
    <header class="exo__add-header">
      <div class="exo__add-header-text">
        <h2 class="exo__add-title" x-text="trExercise(addingExercise?.name)"></h2>
        <Badge
          variant="category"
          size="sm"
          :class="'badge--cat-' + muscleHue(addingExercise?.muscle)"
          x-text="trMuscle(addingExercise?.muscle)"
        />
      </div>
      <button
        type="button"
        class="exo__add-close"
        data-dialog-close
        aria-label={L.common.close}
        @click="closeAddToSession()"
      >
        <Fragment set:html={icons.closeX()} />
      </button>
    </header>

    <Select
      id="exo-add-session"
      label={L.sessions.seanceSingular}
      placeholder={L.rapide.selectSession}
      x-model="addToSessionId"
    >
      <option value="new">+ {L.exercices.newSession}</option>
      <template x-for="s in sessions" :key="s.id">
        <option :value="s.id" x-text="s.name + ' (' + s.date + ')'"></option>
      </template>
    </Select>

    <div x-show="addToSessionId === 'new'" x-cloak x-transition.opacity.duration.180ms>
      <Input
        id="exo-add-session-name"
        label={L.builder.name}
        placeholder="Ex. Push day"
        x-model="newSessionName"
        autocomplete="off"
      />
    </div>

    {/* ── Sets table ── */}
    <div class="exo__add-sets">
      <div class="exo__add-sets-header" aria-hidden="true">
        <span>#</span>
        <span>{L.builder.type}</span>
        <span>{L.builder.weight} (kg)</span>
        <span>{L.common.reps}</span>
        <span></span>
      </div>
      <template x-for="(set, i) in addSets" :key="i">
        <div class="exo__add-sets-row">
          <span class="exo__add-sets-num u-tabular" x-text="i + 1"></span>
          <div class="exo__add-sets-type">
            <span class="exo__add-sets-label">{L.builder.type}</span>
            <div class="exo__select-wrap">
              <select class="exo__select exo__select--compact" x-model="set.type">
                <option value="warmup">{L.builder.types.warmup}</option>
                <option value="work">{L.builder.types.work}</option>
                <option value="top">{L.builder.types.top}</option>
                <option value="drop">{L.builder.types.drop}</option>
                <option value="failure">{L.builder.types.failure}</option>
              </select>
              <Icon name="chevronDown" size={16} class="exo__select-icon" />
            </div>
          </div>
          <div class="exo__add-sets-weight">
            <span class="exo__add-sets-label">
              {L.builder.weight} (<span x-text="unit"></span>)
            </span>
            <input
              type="number"
              class="exo__input exo__input--compact"
              :value="displayWeight(set.weight)"
              @change="storeWeight($event.target, set)"
              min="0"
              step="0.5"
              inputmode="decimal"
            />
          </div>
          <div class="exo__add-sets-reps">
            <span class="exo__add-sets-label">{L.common.reps}</span>
            <input
              type="number"
              class="exo__input exo__input--compact"
              x-model.number="set.reps"
              min="0"
              inputmode="numeric"
            />
          </div>
          <button
            type="button"
            class="exo__add-sets-remove"
            @click="removeSetFromConfig(i)"
            :disabled="addSets.length <= 1"
            :aria-label="labels.deleteSet + ' ' + (i + 1)"
            title={L.builder.deleteSet}
          >
            <Icon name="closeX" size={16} />
          </button>
        </div>
      </template>
      <div class="exo__add-sets-actions">
        <button
          type="button"
          class="exo__add-sets-warmup"
          @click="generateWarmup()"
          :disabled="!hasWorkingWeight()"
          :title="hasWorkingWeight() ? labels.warmupTitle : labels.warmupHint"
        >
          <Icon name="plus" size={20} class="exo__add-icon" />
          <span>{L.builder.warmupBtn}</span>
        </button>
        <button type="button" class="exo__add-sets-add" @click="addSetToConfig()">
          <Icon name="plus" size={18} />
          <span>{L.builder.addSet}</span>
        </button>
      </div>
    </div>
  </div>

  <div slot="footer" class="exo__add-actions">
    <DialogFooter
      cancelLabel={L.common.cancel}
      cancelClick="closeAddToSession()"
      confirmLabel={L.exercices.addToSession}
      confirmVariant="primary"
      confirmDisabled="!addToSessionId"
      confirmClick="submitAddToSession()"
    />
  </div>
</Dialog>

<style>
  .exo__add-icon {
    display: inline-flex;
    width: 1.6rem;
    height: 1.6rem;
  }

  .exo__add-dialog {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .exo__add-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.2rem;
  }

  .exo__add-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .exo__add-title {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    word-break: break-word;
  }

  .exo__add-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    flex-shrink: 0;
    background-color: var(--alpha-bg-soft);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .exo__add-close:hover {
    background-color: var(--alpha-border-faint);
    color: var(--color-text);
  }

  .exo__add-close svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .exo__add-sets {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .exo__add-sets-header {
    display: grid;
    grid-template-columns: 3.2rem 1fr 8rem 6rem 3.2rem;
    gap: 0.6rem;
    align-items: center;
    padding: 0 0.2rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    line-height: 1.2;
  }

  .exo__add-sets-header span:nth-child(3),
  .exo__add-sets-header span:nth-child(4) {
    text-align: center;
  }

  .exo__add-sets-row {
    display: grid;
    grid-template-columns: 3.2rem 1fr 8rem 6rem 3.2rem;
    gap: 0.6rem;
    align-items: center;
  }

  .exo__add-sets-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    margin-left: 0.2rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;

    line-height: 1;
  }

  .exo__add-sets-type,
  .exo__add-sets-weight,
  .exo__add-sets-reps {
    min-width: 0;
  }

  .exo__add-sets-label {
    display: none;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.3rem;
  }

  .exo__add-sets-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .exo__add-sets-remove:hover:not(:disabled) {
    background-color: color-mix(in srgb, var(--color-destructive) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-destructive) 40%, transparent);
    color: var(--color-destructive);
  }

  .exo__add-sets-remove:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .exo__add-sets-remove svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .exo__add-sets-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    height: 4rem;
    margin-top: 0.4rem;
    background-color: transparent;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .exo__add-sets-add:hover {
    background-color: var(--alpha-bg-subtle);
    border-color: var(--alpha-border);
    border-style: solid;
    color: var(--color-text);
  }

  .exo__add-sets-add svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  /* ── Sets table action row (warmup + add) ── */
  .exo__add-sets-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  @media (min-width: 640px) {
    .exo__add-sets-actions {
      flex-direction: row;
      align-items: stretch;
    }
    .exo__add-sets-actions .exo__add-sets-warmup {
      flex: 0 0 auto;
    }
    .exo__add-sets-actions .exo__add-sets-add {
      flex: 1 1 auto;
      margin-top: 0;
    }
  }

  /* ── Warmup auto-generation button (dashed accent) ── */
  .exo__add-sets-warmup {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    height: 4rem;
    padding: 0 1.4rem;
    background-color: transparent;
    border: 1px dashed var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      border-style var(--transition-fast),
      color var(--transition-fast);
  }

  .exo__add-sets-warmup:hover:not(:disabled) {
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-style: solid;
  }

  .exo__add-sets-warmup:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    background-color: transparent;
    color: var(--color-muted);
    border-color: var(--color-border);
  }

  .exo__add-sets-warmup svg {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  /* ── Sets table: mobile (stacked cards) ── */
  @media (max-width: 640px) {
    .exo__add-sets-header {
      display: none;
    }
    .exo__add-sets-row {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'num    remove'
        'type   type'
        'weight reps';
      gap: 0.8rem;
      padding: 1rem;
      background-color: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
    }
    .exo__add-sets-num {
      grid-area: num;
      justify-self: start;
    }
    .exo__add-sets-remove {
      grid-area: remove;
      justify-self: end;
    }
    .exo__add-sets-type {
      grid-area: type;
    }
    .exo__add-sets-weight {
      grid-area: weight;
    }
    .exo__add-sets-reps {
      grid-area: reps;
    }
    .exo__add-sets-label {
      display: block;
    }
  }

  .exo__add-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
    margin-top: 0.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
  }

  .exo__input,
  .exo__select {
    width: 100%;
    height: 4.4rem;
    padding: 0 1.4rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
    line-height: 1.2;
    outline: none;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .exo__input::placeholder {
    color: var(--alpha-text-faint);
  }

  .exo__select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    cursor: pointer;
    padding-right: 4rem;
  }

  :global(#exo-add-to-session-dialog) {
    max-width: 56rem;
    width: auto;
  }

  .exo__select--compact,
  .exo__input--compact {
    height: 4rem;
    font-size: 1.3rem;
    padding: 0 1.2rem;
  }

  .exo__select--compact {
    padding-right: 3.4rem;
  }
</style>
