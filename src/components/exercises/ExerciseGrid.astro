---
import { t } from '../../i18n';
import Card from '../ui/Card.astro';
import CardFooter from '../ui/CardFooter.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import IconButton from '../ui/IconButton.astro';
import EmptyState from '../ui/EmptyState.astro';
import EmptyFilterState from '../ui/EmptyFilterState.astro';
import { icons } from '../../lib/icons';
const L = t();
---

{/* ── Grid ── */}
<template x-if="filtered.length > 0">
  <div class="exo__grid">
    <template x-for="ex in filtered" :key="ex.id">
      <Card variant="interactive" hover clickable class="exo__card-body">
        <span class="exo__card-head">
          <span class="exo__card-icon" set:html={icons.dumbbellBox()} />
          <h3 class="exo__card-name" x-text="trExercise(ex.name)"></h3>
          <span
            class="exo__set-badge"
            x-show="getSetCount(ex.id) > 0"
            x-cloak
            x-transition.opacity.duration.200ms
            :title="getSetCount(ex.id) + ' ' + labels.sets"
            x-text="getSetCount(ex.id)"
          ></span>
          <div class="exo__card-actions">
            <IconButton
              variant="ghost"
              icon={icons.infoCircle()}
              label={L.exercices.tipLabel}
              :aria-label="labels.showTipAria + ' ' + ex.name"
              title={L.exercices.tipLabel}
              @click="toggleTip(ex.id)"
              :aria-expanded="isTipOpen(ex.id).toString()"
              x-show="hasTip(ex.name)"
              x-cloak
            />
          </div>

          <IconButton
            variant="default"
            icon={icons.starFilled()}
            class="exo__fav-btn is-fav"
            label={L.exercices.favorites}
            :aria-label="(ex.favorite ? labels.unfavoriteAria : labels.favoriteAria) + ' ' + ex.name"
            :title="ex.favorite ? labels.unfavorite : labels.favorite"
            @click.stop="toggleFav(ex)"
            x-show="ex.favorite"
            x-cloak
          />
          <IconButton
            variant="default"
            icon={icons.star()}
            class="exo__fav-btn"
            label={L.exercices.favorites}
            :aria-label="(ex.favorite ? labels.unfavoriteAria : labels.favoriteAria) + ' ' + ex.name"
            :title="ex.favorite ? labels.unfavorite : labels.favorite"
            @click.stop="toggleFav(ex)"
            x-show="!ex.favorite"
            x-cloak
          />
        </span>

        <p
          class="exo__tip"
          x-show="isTipOpen(ex.id) && hasTip(ex.name)"
          x-cloak
          x-transition.opacity.duration.180ms
        >
          <span x-text="getTip(ex.name)"></span>
          <a
            class="exo__tip-video"
            :href="getVideoUrl(ex.name)"
            target="_blank"
            rel="noopener noreferrer"
            :aria-label="labels.videoAria + ' ' + ex.name + ' ' + labels.onYoutube"
            title={L.exercices.seeTechnique}
          >
            <Icon name="play" size={16} />
            <span>{L.exercices.seeTechnique}</span>
          </a>
        </p>

        <div class="exo__card-badges">
          <Badge
            variant="category"
            size="sm"
            :class="'badge--cat-' + muscleHue(ex.muscle)"
            x-text="trMuscle(ex.muscle)"
          />
          <Badge variant="default" size="sm" x-text="trCategory(ex.category)" />
        </div>

        <CardFooter class="exo__card-foot">
          <IconButton
            variant="ghost"
            icon={icons.edit()}
            label={L.exercices.edit}
            title={L.exercices.edit}
            @click="edit(ex)"
          />
          <IconButton
            variant="accent"
            icon={icons.plusCircle()}
            label={L.exercices.addToSession}
            title={L.exercices.addToSession}
            @click="openAddToSession(ex)"
          />
          <a
            class="exo__icon-btn exo__icon-btn--trend"
            :href="trendUrl(ex)"
            :aria-label="labels.trendAria + ' ' + ex.name"
            :title="labels.trendTitle"
          >
            <Icon name="trendingUpLine" size={20} class="exo__icon" />
          </a>
          <IconButton
            variant="danger"
            icon={icons.trash()}
            label={L.exercices.delete}
            title={L.exercices.delete}
            @click="askDelete(ex)"
          />
        </CardFooter>
      </Card>
    </template>
  </div>
</template>
{/* ── Empty state: library has no exercises at all ── */}
<template x-if="exercises.length === 0">
  <Card>
    <EmptyState iconName="dumbbell" title={L.exercices.emptyLibrary} />
    <div class="exo__empty-cta">
      <button type="button" class="exo__add-btn" @click="openAdd()" aria-label={L.exercices.add}>
        <Icon name="plus" size={16} class="exo__add-icon" />
        <span>{L.exercices.add}</span>
      </button>
    </div>
  </Card>
</template>
{/* ── Empty state: favFilter active, no favorites ── */}
<template x-if="exercises.length > 0 && favFilter && filtered.length === 0">
  <EmptyFilterState title={L.exercices.favorites} text={L.exercices.noResults} hideReset />
</template>
{/* ── Empty state: search/filters match nothing ── */}
<template x-if="exercises.length > 0 && !favFilter && filtered.length === 0">
  <EmptyFilterState
    title={L.common.noResult}
    text={L.exercices.noResults}
    resetLabel={L.common.reset}
    resetClick="search = ''; muscleFilter = ''; favFilter = false"
  />
</template>

<style>
  .exo__count {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }

  .exo__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  @media (min-width: 640px) {
    .exo__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .exo__card-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .exo__card-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .exo__card-icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .exo__card-icon svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .exo__set-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.4rem;
    padding: 0 0.9rem;
    background-color: color-mix(in srgb, var(--color-success) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-success) 30%, transparent);
    border-radius: var(--radius-pill);
    color: var(--color-success);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .exo__card-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    min-width: 0;
  }

  .exo__tip {
    margin: 0;
    padding: 1rem 1.2rem;
    background-color: var(--color-surface-2);
    border-left: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  /* ── YouTube technique link ── */
  .exo__tip-video {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
    padding: 0.5rem 0.9rem;
    background-color: color-mix(in srgb, var(--color-destructive) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-destructive) 32%, transparent);
    border-radius: var(--radius-pill);
    color: var(--color-destructive);
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .exo__tip-video:hover {
    background-color: color-mix(in srgb, var(--color-destructive) 18%, transparent);
    border-color: color-mix(in srgb, var(--color-destructive) 50%, transparent);
    color: var(--color-destructive);
  }

  .exo__tip-video:active {
    transform: scale(0.97);
  }

  .exo__tip-video svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: currentColor;
    stroke: currentColor;
    flex-shrink: 0;
  }

  .exo__tip-video svg polygon {
    fill: currentColor;
    stroke: none;
  }

  .exo__card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .exo__card-foot {
    gap: 0.6rem;
  }

  .exo__icon-btn {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
    width: 4.4rem;
    height: 4.4rem;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .exo__icon-btn:hover {
    background-color: var(--alpha-bg-soft);
    border-color: var(--alpha-border-faint);
    color: var(--color-text);
  }

  .exo__icon-btn:active {
    transform: scale(0.94);
  }

  .exo__icon-btn--trend:hover {
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    color: var(--color-accent);
  }

  .exo__fav-btn {
    color: var(--color-muted);
  }

  .exo__fav-btn.is-fav {
    color: var(--color-warning);
  }

  .exo__fav-btn.is-fav:hover {
    color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
  }

  .exo__icon {
    flex-shrink: 0;
  }

  .exo__icon svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .exo__empty-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0.4rem 0 0.8rem;
  }

  .exo__card-body {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
</style>
