---
/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
import { t } from '../../i18n';
import Card from '../ui/Card.astro';
import CardFooter from '../ui/CardFooter.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import IconButton from '../ui/IconButton.astro';
import EmptyState from '../ui/EmptyState.astro';
import EmptyFilterState from '../ui/EmptyFilterState.astro';
import { icons } from '../../lib/icons';
const L = t();
---

{/* ── Grid ── */}
<template x-if="filtered.length > 0">
  <div class="exo__grid">
    <template x-for="ex in filtered" :key="ex.id">
      <Card variant="interactive" hover clickable class="exo__card-body">
        <span class="exo__card-head">
          <span class="exo__card-icon" set:html={icons.dumbbellBox()} />
          <h3 class="exo__card-name" x-text="$store.i18n.trExercise(ex.name)"></h3>
          <span
            class="exo__set-badge u-tabular"
            x-show="getSetCount(ex.id) > 0"
            x-cloak
            x-transition.opacity.duration.200ms
            :title="getSetCount(ex.id) + ' ' + labels.sets"
            x-text="getSetCount(ex.id)"
          ></span>
          <div class="exo__card-actions">
            <IconButton
              variant="ghost"
              icon={icons.infoCircle()}
              label={L.exercices.tipLabel}
              :aria-label="labels.showTipAria + ' ' + ex.name"
              title={L.exercices.tipLabel}
              @click="toggleTip(ex.id)"
              :aria-expanded="isTipOpen(ex.id).toString()"
              x-show="hasTip(ex.name)"
              x-cloak
            />
          </div>

          <IconButton
            variant="default"
            icon={icons.starFilled()}
            class="exo__fav-btn is-fav"
            label={L.exercices.favorites}
            :aria-label="(ex.favorite ? labels.unfavoriteAria : labels.favoriteAria) + ' ' + ex.name"
            :title="ex.favorite ? labels.unfavorite : labels.favorite"
            @click.stop="toggleFav(ex)"
            x-show="ex.favorite"
            x-cloak
          />
          <IconButton
            variant="default"
            icon={icons.star()}
            class="exo__fav-btn"
            label={L.exercices.favorites}
            :aria-label="(ex.favorite ? labels.unfavoriteAria : labels.favoriteAria) + ' ' + ex.name"
            :title="ex.favorite ? labels.unfavorite : labels.favorite"
            @click.stop="toggleFav(ex)"
            x-show="!ex.favorite"
            x-cloak
          />
        </span>

        <p
          class="exo__tip"
          x-show="isTipOpen(ex.id) && hasTip(ex.name)"
          x-cloak
          x-transition.opacity.duration.180ms
        >
          <span x-text="getTip(ex.name)"></span>
          <a
            class="exo__tip-video"
            :href="getVideoUrl(ex.name)"
            target="_blank"
            rel="noopener noreferrer"
            :aria-label="labels.videoAria + ' ' + ex.name + ' ' + labels.onYoutube"
            title={L.exercices.seeTechnique}
          >
            <Icon name="play" size={16} />
            <span>{L.exercices.seeTechnique}</span>
          </a>
        </p>

        <div class="exo__card-badges">
          <Badge
            variant="category"
            size="sm"
            :class="'badge--cat-' + $store.i18n.muscleHue(ex.muscle)"
            x-text="$store.i18n.trMuscle(ex.muscle)"
          />
          <Badge variant="default" size="sm" x-text="$store.i18n.trCategory(ex.category)" />
        </div>

        <CardFooter class="exo__card-foot">
          <IconButton
            variant="ghost"
            icon={icons.edit()}
            label={L.exercices.edit}
            title={L.exercices.edit}
            @click="edit(ex)"
          />
          <IconButton
            variant="accent"
            icon={icons.plusCircle()}
            label={L.exercices.addToSession}
            title={L.exercices.addToSession}
            @click="openAddToSession(ex)"
          />
          <a
            class="exo__icon-btn exo__icon-btn--trend"
            :href="trendUrl(ex)"
            :aria-label="labels.trendAria + ' ' + ex.name"
            :title="labels.trendTitle"
          >
            <Icon name="trendingUpLine" size={20} class="exo__icon" />
          </a>
          <IconButton
            variant="danger"
            icon={icons.trash()}
            label={L.exercices.delete}
            title={L.exercices.delete}
            @click="askDelete(ex)"
          />
        </CardFooter>
      </Card>
    </template>
  </div>
</template>
{/* ── Empty state: library has no exercises at all ── */}
<template x-if="exercises.length === 0">
  <Card>
    <EmptyState iconName="dumbbell" title={L.exercices.emptyLibrary} />
    <div class="exo__empty-cta">
      <button type="button" class="exo__add-btn" @click="openAdd()" aria-label={L.exercices.add}>
        <Icon name="plus" size={16} class="exo__add-icon" />
        <span>{L.exercices.add}</span>
      </button>
    </div>
  </Card>
</template>
{/* ── Empty state: favFilter active, no favorites ── */}
<template x-if="exercises.length > 0 && favFilter && filtered.length === 0">
  <EmptyFilterState title={L.exercices.favorites} text={L.exercices.noResults} hideReset />
</template>
{/* ── Empty state: search/filters match nothing ── */}
<template x-if="exercises.length > 0 && !favFilter && filtered.length === 0">
  <EmptyFilterState
    title={L.common.noResult}
    text={L.exercices.noResults}
    resetLabel={L.common.reset}
    resetClick="search = ''; muscleFilter = ''; favFilter = false"
  />
</template>
