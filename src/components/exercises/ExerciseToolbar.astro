---
/** Composant sans props — contrat explicite (ratchet CSS). */
interface Props {}
import { t } from '../../i18n';
import SearchInput from '../ui/SearchInput.astro';
import Icon from '../ui/Icon.astro';
import { icons } from '../../lib/icons';
const L = t();
---

{/* ── Toolbar: search + filter ── */}
<div class="exo__toolbar">
  <SearchInput
    class="exo__search"
    placeholder={L.exercices.searchPlaceholder}
    x-model="search"
    label={L.exercices.search}
  />

  <div class="exo__filters" role="group" aria-label={L.exercices.filterAria}>
    <button
      type="button"
      class="exo__filter"
      :class="{ 'is-active': muscleFilter === '' }"
      :aria-pressed="muscleFilter === ''"
      @click="muscleFilter = ''"
    >
      {L.common.all}
    </button>
    <button
      type="button"
      class="exo__filter"
      :class="{ 'is-active': favFilter }"
      :aria-pressed="favFilter"
      @click="favFilter = !favFilter"
    >
      <Icon name="star" size={14} />
      {L.exercices.favorites}
    </button>
    <template x-for="m in muscleGroups" :key="m">
      <button
        type="button"
        class="exo__filter"
        :class="{ 'is-active': muscleFilter === m }"
        :aria-pressed="muscleFilter === m"
        @click="muscleFilter = m"
        x-text="m"
      ></button>
    </template>
  </div>
</div>
{/* ── Meta row: count + add button ── */}
<div class="exo__meta">
  <span class="exo__count" x-text="countLabel"></span>
  <button type="button" class="exo__add-btn" @click="openAdd()" aria-label={L.exercices.add}>
    <span class="exo__add-icon" set:html={icons.plus()} />
    <span>{L.exercices.add}</span>
  </button>
</div>

<style>
  .exo__toolbar {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    margin-bottom: 2rem;
  }

  /* ── Search input ── */
  .exo__search {
    position: relative;
    width: 100%;
  }

  /* ── Filter pills ── */
  .exo__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .exo__filter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    white-space: nowrap;
    height: 4rem;
    padding: 0 1.4rem;
    min-width: 6rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .exo__filter svg {
    flex-shrink: 0;
  }

  .exo__filter:hover {
    background-color: var(--color-surface-3);
    border-color: var(--alpha-border);
    color: var(--color-text);
  }

  .exo__filter:active {
    transform: scale(0.97);
  }

  .exo__filter.is-active {
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .exo__toolbar {
      gap: 1.2rem;
    }
    .exo__card-name {
      font-size: 1.5rem;
    }
  }

  .exo__add-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 4.4rem;
    padding: 0 1.6rem;
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-accent) 25%, transparent);
    transition:
      background-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .exo__add-btn:hover {
    background-color: var(--color-accent-hover);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .exo__add-btn:active {
    transform: scale(0.97);
  }

  .exo__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1.6rem;
  }
</style>
