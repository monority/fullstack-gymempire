---
/** En-tête aligné sur SetEditor — mêmes colonnes, mêmes modificateurs. */
interface Props {
  labels: { type: string; weight: string; reps: string };
  variant?: 'table' | 'card';
  unitExpr?: string;
}
const { labels, variant = 'table', unitExpr } = Astro.props;
---

<div class:list={['set-editor__row', 'set-editor__head', `set-editor__row--${variant}`]} role="row">
  <div class="set-editor__num" role="columnheader">
    #
  </div>
  <div class="set-editor__type" role="columnheader">
    {labels.type}
  </div>
  <div class="set-editor__weight" role="columnheader">
    {labels.weight}
    {unitExpr ? ' (' : ''}
    {unitExpr && <span x-text={unitExpr}></span>}
    {unitExpr ? ')' : ''}
  </div>
  <div class="set-editor__reps" role="columnheader">
    {labels.reps}
  </div>
  <div class="set-editor__action" role="columnheader" aria-label="Actions"></div>
</div>
