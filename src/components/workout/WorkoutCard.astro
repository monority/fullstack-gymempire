---
import Badge from '../ui/Badge.astro';
import { t, trExercise, trMuscle } from '../../i18n';
import { formatDateShort } from '../../lib/format';

const L = t();
interface Props {
  name: string;
  date: string;
  duration?: string;
  exerciseCount: number;
  totalVolume?: string;
  exercises?: Array<{ name: string; muscle: string; setCount: number }>;
  status?: 'completed' | 'in-progress' | 'planned';
  class?: string;
}

const {
  name,
  date,
  duration,
  exerciseCount,
  totalVolume,
  exercises = [],
  status = 'planned',
  class: className = '',
} = Astro.props as Props;
const statusConfig = {
  completed: { variant: 'success' as const, label: L.sessions.completed },
  'in-progress': { variant: 'accent' as const, label: L.sessions.inProgress },
  planned: { variant: 'default' as const, label: L.sessions.planned },
};
const config = statusConfig[status];
const formattedDate = formatDateShort(date);
const visibleExercises = exercises.slice(0, 4);
const hiddenCount = Math.max(0, exercises.length - visibleExercises.length);
---

<article class:list={['workout-record', `workout-record--${status}`, className]}>
  <div class="workout-record__status" aria-hidden="true">
    <span></span>
  </div>
  <div class="workout-record__body">
    <div class="workout-record__top">
      <h3 class="workout-record__name">{name}</h3>
      <Badge variant={config.variant} size="sm">
        {config.label}
      </Badge>
    </div>
    <dl class="workout-record__meta">
      <div class="workout-record__meta-item">
        <dt class="dt-label">{L.common.date}</dt>
        <dd class="workout-record__meta-value u-tabular">{formattedDate}</dd>
      </div>
      <div class="workout-record__meta-item">
        <dt class="dt-label">{L.common.exercises}</dt>
        <dd class="workout-record__meta-value u-tabular">{exerciseCount}</dd>
      </div>
      {duration && (
        <div class="workout-record__meta-item">
          <dt class="dt-label">{L.common.duration}</dt>
          <dd class="workout-record__meta-value u-tabular">{duration}</dd>
        </div>
      )}
      {totalVolume && (
        <div class="workout-record__meta-item">
          <dt class="dt-label">{L.sessions.volume}</dt>
          <dd class="workout-record__meta-value u-tabular">{totalVolume}</dd>
        </div>
      )}
    </dl>
    {visibleExercises.length > 0 && (
      <div class="workout-record__exercises">
        {visibleExercises.map((ex) => (
          <span class="workout-record__ex">
            {trExercise(ex.name)}{' '}
            <small class="workout-record__ex-detail">
              {trMuscle(ex.muscle)} · {ex.setCount}
            </small>
          </span>
        ))}
        {hiddenCount > 0 && (
          <span class="workout-record__ex-more">
            +{hiddenCount} {L.common.exercises}
          </span>
        )}
      </div>
    )}
  </div>
  <span class="workout-record__arrow" aria-hidden="true">
    ↗
  </span>
</article>
