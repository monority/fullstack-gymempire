---
import '../../styles/components/history-page.css';

import { resolveLocale } from '../../i18n';

import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import BackLink from '../../components/ui/BackLink.astro';
import MetricGrid from '../../components/ui/MetricGrid.astro';
import { buildHistoryMetrics } from '../../components/progression/metric-definitions';
const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
import Icon from '../../components/ui/Icon.astro';
import HistoryTable from '../../components/exercises/HistoryTable.astro';
---

<AppLayout title={L.historique.title}>
  <PageHeader title={L.historique.title} description={L.historique.description} />

  <div class="hist__main" x-data="exerciseHistoryApp()" x-init="init()" x-cloak>
    {/* ── Back link ── */}
    <BackLink href={localizedPath('/exercises', locale)} label={L.historique.back} />

    <template x-if="notFound">
      <EmptyState
        variant="error"
        title={L.historique.notFound}
        description={L.historique.notFoundDesc}
        actionLabel={L.historique.viewExercises}
        actionHref={localizedPath('/exercises', locale)}
      />
    </template>

    {/* ── Loaded exercise ── */}
    <template x-if="!notFound && exercise">
      <div class="hist__body">
        {/* ── Header ── */}
        <header class="hist__header">
          <div class="hist__header-row">
            <div class="hist__header-left">
              <div class="hist__title-icon" aria-hidden="true">
                <Icon name="dumbbellBox" size={24} />
              </div>
              <h1 class="hist__title" x-text="$store.i18n.trExercise(exercise.name)"></h1>
            </div>
            <div class="hist__badges">
              <Badge
                variant="category"
                size="sm"
                :class="'badge--cat-' + $store.i18n.muscleHue(exercise.muscle)"
                x-text="$store.i18n.trMuscle(exercise.muscle)"
              />
              <Badge
                variant="default"
                size="sm"
                x-text="$store.i18n.trCategory(exercise.category)"
              />
            </div>
          </div>
        </header>

        {/* ── Chart ── */}
        <Card padding="lg">
          <div class="hist__chart-wrap">
            <header class="hist__section-header">
              <h2 class="hist__section-title">{L.historique.historyTitle}</h2>
              <span class="hist__meta" x-text="chartMeta"></span>
            </header>

            <template x-if="chartData.length === 0">
              <p class="hist__empty-msg">{L.historique.historyEmpty}</p>
            </template>

            <template x-if="chartData.length > 0">
              <div class="hist__chart-body">
                <svg
                  class="hist__chart"
                  viewBox="0 0 800 300"
                  preserveAspectRatio="xMidYMid meet"
                  role="img"
                  aria-label={L.historique.historyTitle}
                >
                  {/* Horizontal grid lines + Y labels (SVG string: Alpine x-for breaks inside <svg>) */}
                  <g x-html="chartGridMarkup"></g>

                  {/* X axis baseline */}
                  <line
                    x1="0"
                    y1="300"
                    x2="800"
                    y2="300"
                    stroke="var(--color-border)"
                    stroke-width="1"
                  />

                  {/* Soft area under the line */}
                  <polygon :points="chartAreaPoints" fill="url(#hist-gradient)" opacity="0.18" />

                  {/* Line */}
                  <polyline
                    :points="chartLinePoints"
                    fill="none"
                    stroke="var(--color-accent)"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />

                  {/* Dots (SVG string: Alpine x-for breaks inside <svg>) */}
                  <g x-html="chartDotsMarkup"></g>

                  {/* Gradient defs */}
                  <defs>
                    <linearGradient id="hist-gradient" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.55" />
                      <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                </svg>

                {/* X axis date labels (subset to avoid overlap) */}
                <div class="hist__x-labels" x-show="chartData.length > 0">
                  <template x-for="(d, i) in chartData" :key="'l' + i">
                    <span
                      class="hist__x-tick"
                      :class="{ 'hist__chart-tick--start': i === 0, 'hist__chart-tick--end': i === chartData.length - 1 }"
                      x-show="i === 0 || i === chartData.length - 1 || i === Math.floor(chartData.length / 2)"
                      x-text="formatDateShort(d.date)"
                    ></span>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </Card>

        <MetricGrid
          prefix="hist-stats"
          footClass="hist-stats__date"
          metrics={buildHistoryMetrics(L)}
        />

        {/* ── History table ── */}
        <section class="hist__table-section">
          <header class="hist__table-header">
            <h2 class="hist__table-title">{L.historique.tableTitle}</h2>
            <span class="hist__table-meta" x-text="tableMeta"></span>
          </header>

          <template x-if="history.length === 0">
            <Card>
              <EmptyState
                iconName="clock"
                title={L.common.noData}
                description={L.historique.historyEmpty}
                actionLabel={L.historique.viewExercises}
                actionHref={localizedPath('/exercises', locale)}
              />
            </Card>
          </template>

          <HistoryTable labels={L.historique} />
        </section>
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import { registerAlpine } from '../../lib/alpine';
  import { createHistoryApp } from '../../components/exercises/historyApp';
  import { t, getLocale } from '../../i18n';

  const LABELS = t(getLocale());

  registerAlpine('exerciseHistoryApp', () =>
    createHistoryApp({
      search: window.location.search,
      labels: { ...LABELS.historique, kg: LABELS.common.kg },
    })
  );
</script>
