---
import { t } from '../../i18n';
import ExerciseToolbar from '../../components/exercises/ExerciseToolbar.astro';
import ExerciseGrid from '../../components/exercises/ExerciseGrid.astro';
import ExerciseFormDialog from '../../components/exercises/ExerciseFormDialog.astro';
import ExerciseAddDialog from '../../components/exercises/ExerciseAddDialog.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';

const L = t();

/**
 * Static list of categories offered in the form. Kept on the
 * frontmatter so the markup stays declarative. Values are the
 * storage keys (kept stable for data compat); labels are
 * localized.
 */
---

<AppLayout title={L.exercices.title}>
  <PageHeader title={L.exercices.title} description={L.exercices.description} />

  <div class="exo" x-data="exercisesApp()" x-init="init()" x-cloak>
    <ExerciseToolbar />
    <ExerciseGrid />
    <ExerciseFormDialog />
    <ExerciseAddDialog />
  </div>

  <script>
    import { singleton as uiStore } from '../../lib/ui-store';
    import { registerAlpine } from '../../lib/alpine';
    import {
      createExercisesApp,
      buildExercisesLabels,
    } from '../../components/exercises/exercisesApp';
    import { t, localizedPath, DATE_LOCALE } from '../../i18n';
    import { icons } from '../../lib/icons';

    const LABELS = t();
    (window as Window & { icons?: typeof icons }).icons = icons;
    registerAlpine('exercisesApp', () =>
      createExercisesApp({
        labels: buildExercisesLabels(LABELS),
        localizedPath,
        clock: {
          now: () => new Date(),
          locale: () => DATE_LOCALE(),
        },
        ui: {
          notify: (message, kind) => uiStore.notify(message, kind),
          openDialog: (id) => uiStore.openDialog(id),
          closeDialog: (id) => uiStore.closeDialog(id),
        },
      })
    );
  </script>

  <style>
    .exo {
      max-width: 96rem;
      margin: 0 auto;
      padding-bottom: 6rem;
    }
  </style>
</AppLayout>
