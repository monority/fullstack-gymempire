---
const locale = resolveLocale(Astro.url.pathname);
import { resolveLocale } from '../../i18n';

import { t } from '../../i18n';
import ExerciseToolbar from '../../components/exercises/ExerciseToolbar.astro';
import ExerciseGrid from '../../components/exercises/ExerciseGrid.astro';
import ExerciseFormDialog from '../../components/exercises/ExerciseFormDialog.astro';
import ExerciseAddDialog from '../../components/exercises/ExerciseAddDialog.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';

const L = t(locale);

/**
 * Static list of categories offered in the form. Kept on the
 * frontmatter so the markup stays declarative. Values are the
 * storage keys (kept stable for data compat); labels are
 * localized.
 */
---

<AppLayout title={L.exercices.title}>
  <PageHeader title={L.exercices.title} description={L.exercices.description} />

  <div class="exo" x-data="exercisesApp()" x-init="init()" x-cloak>
    <ExerciseToolbar />
    <ExerciseGrid />
    <ExerciseFormDialog />
    <ExerciseAddDialog />
  </div>

  <script>
    import { registerExercises } from '../../components/exercises/registration';

    registerExercises();
  </script>

  <style>
    .exo {
      max-width: 96rem;
      margin: 0 auto;
      padding-bottom: 6rem;
    }
  </style>
</AppLayout>
