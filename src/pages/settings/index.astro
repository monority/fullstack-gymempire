---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Select from '../../components/ui/Select.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Dialog from '../../components/ui/Dialog.astro';
import SettingsSection from '../../components/ui/SettingsSection.astro';
import ReminderSettings from '../../components/workout/ReminderSettings.astro';
import Segmented from '../../components/ui/Segmented.astro';
import Toggle from '../../components/ui/Toggle.astro';
import DialogFooter from '../../components/ui/DialogFooter.astro';
import { t } from '../../i18n';
import { icons } from '../../lib/icons';
import { formatRestOptions } from '../../lib/settings-stats';

const L = t();
const restOptions = formatRestOptions();
const APP_VERSION = '0.0.1';
---

<AppLayout title={L.settings.title}>
  <PageHeader title={L.settings.title} description={L.settings.description} />

  <div class="set" x-data="settingsApp()" x-init="init()" x-cloak>
    1. PROFIL
    <SettingsSection
      icon="user"
      title={L.settings.profile}
      description={L.settings.profileDesc}
      id="set-profile"
    >
      <div class="set__rows">
        <div class="set__row">
          <div class="set__label">
            <span class="set__label-title">{L.settings.pseudo}</span>
            <span class="set__label-desc">{L.settings.pseudoDesc}</span>
          </div>
          <div class="set__control">
            <Input
              bare
              size="md"
              type="text"
              id="set-pseudo"
              class="set__sync-input"
              x-model="display.pseudo"
              @change="savePseudo()"
              :placeholder="labels.pseudoPlaceholder"
              maxlength="40"
              autocomplete="nickname"
              :aria-label="labels.pseudoPlaceholder"
            />
          </div>
        </div>
        <div class="set__row">
          <div class="set__label">
            <span class="set__label-title">{L.settings.email}</span>
            <span class="set__label-desc">{L.settings.emailDesc}</span>
          </div>
          <div class="set__control">
            <Input
              bare
              size="md"
              type="email"
              id="set-email"
              class="set__sync-input"
              x-model="display.email"
              @change="saveEmail()"
              :placeholder="labels.emailPlaceholder"
              autocomplete="email"
              :aria-label="labels.emailPlaceholder"
            />
          </div>
        </div>
      </div>
    </SettingsSection>
    2. UNITÉS
    <SettingsSection
      icon="ruler"
      title={L.settings.units}
      description={L.settings.unitsDesc}
      id="set-units"
    >
      <div class="set__rows">
        <div class="set__row">
          <div class="set__label">
            <span class="set__label-title">{L.settings.weightUnit}</span>
            <span class="set__label-desc">{L.settings.weightUnitDesc}</span>
          </div>
          <Segmented
            items={[
              { value: 'kg', label: 'kg', action: "setUnit('kg')" },
              { value: 'lbs', label: 'lbs', action: "setUnit('lbs')" },
            ]}
            model="display.unit"
            ariaLabel={L.settings.weightUnit}
          />
        </div>

        <div class="set__row">
          <div class="set__label">
            <span class="set__label-title">{L.settings.repsFormat}</span>
            <span class="set__label-desc">{L.settings.repsDesc}</span>
          </div>
          <div class="set__seg-group" role="group" aria-label={L.settings.repsFormat}>
            <button
              type="button"
              class="set__seg-btn"
              :class="{ 'is-active': display.repsFormat === 'simple' }"
              :aria-pressed="display.repsFormat === 'simple'"
              @click="setRepsFormat('simple')"
            >
              {L.settings.simple}
            </button>
            <button
              type="button"
              class="set__seg-btn"
              :class="{ 'is-active': display.repsFormat === 'range' }"
              :aria-pressed="display.repsFormat === 'range'"
              @click="setRepsFormat('range')"
            >
              {L.settings.range}
            </button>
          </div>
        </div>
      </div>
    </SettingsSection>
    3. OBJECTIFS
    <SettingsSection
      icon="target"
      title={L.settings.goals}
      description={L.settings.goalsDesc}
      id="set-goals"
    >
      <div class="set__rows">
        <div class="set__row set__row--start">
          <div class="set__label">
            <span class="set__label-title">{L.settings.weeklyGoalCount}</span>
            <span class="set__label-desc">{L.settings.weeklyGoalTrackedDesc}</span>
          </div>
          <div class="set__control set__control--right">
            <div class="set__goal-wrap">
              <Button
                variant="ghost"
                iconLabel={L.settings.weeklyGoalDecrease}
                @click="setWeeklyGoal(display.weeklyGoal - 1)"
                class="set__goal-btn"
              >
                <Icon name="minus" size={24} slot="icon" />
              </Button>
              <input
                id="set-weekly-goal"
                type="number"
                min="1"
                max="7"
                step="1"
                inputmode="numeric"
                class="set__goal-input"
                :value="display.weeklyGoal"
                @change="setWeeklyGoal(parseInt($event.target.value, 10))"
                aria-label={L.settings.weeklyGoalCount}
              />
              <Button
                variant="ghost"
                iconLabel={L.settings.weeklyGoalIncrease}
                @click="setWeeklyGoal(display.weeklyGoal + 1)"
                class="set__goal-btn"
              >
                <Icon name="plus" size={24} slot="icon" />
              </Button>
            </div>
          </div>
        </div>

        <div class="set__row set__row--start">
          <div class="set__label">
            <span class="set__label-title">{L.settings.weeklyProgress}</span>
            <span class="set__label-desc">{L.settings.weeklyProgressDesc}</span>
          </div>
          <div class="set__control set__control--right">
            <span class="set__progress">
              <span class="set__progress-done" x-text="weeklyDone"></span>
              <span class="set__progress-sep" aria-hidden="true">
                /
              </span>
              <span class="set__progress-goal" x-text="display.weeklyGoal"></span>
              <span class="set__progress-unit" x-text="labels.seanceSingular">
                {L.settings.seanceSingular}
              </span>
              <span class="set__progress-plural" x-text="display.weeklyGoal > 1 ? 's' : ''"></span>
            </span>
          </div>
        </div>
      </div>
    </SettingsSection>
    4. TIMER
    <SettingsSection
      icon="clockStopwatch"
      title={L.settings.timerSettings}
      description={L.settings.timerDesc}
      id="set-timer"
    >
      <div class="set__rows">
        <div class="set__row set__row--start">
          <div class="set__label">
            <span class="set__label-title">{L.settings.defaultRestTime}</span>
            <span class="set__label-desc">{L.settings.defaultRestTimeDesc}</span>
          </div>
          <div class="set__control set__control--right">
            <Select
              id="set-rest-time"
              name="restTime"
              aria-label={L.settings.defaultRestTime}
              options={restOptions}
              :value="String(display.defaultRestTime)"
              @change="saveRestTime($event.target.value)"
            />
          </div>
        </div>

        <div class="set__row set__row--start">
          <div class="set__label">
            <span class="set__label-title">{L.settings.soundAlerts}</span>
            <span class="set__label-desc">{L.settings.soundAlertsDesc}</span>
          </div>
          <div class="set__control set__control--right">
            <Toggle
              :checked="display.soundAlerts"
              aria-label={L.settings.soundAlerts}
              :aria-checked="display.soundAlerts ? 'true' : 'false'"
              @change="saveSoundAlerts($event.target.checked)"
            />
          </div>
        </div>
      </div>
    </SettingsSection>
    5. RAPPEL D'ENTRAÎNEMENT
    <ReminderSettings />
    6. DONNÉES
    <SettingsSection
      icon="database"
      title={L.settings.data}
      description={L.settings.dataDesc}
      id="set-data"
    >
      <div class="set__data-grid">
        <div class="set__data-tile">
          <div class="set__data-tile-header">
            <div class="set__data-tile-icon" aria-hidden="true">
              <Fragment set:html={icons.download(24, 24)} />
            </div>
            <div class="set__data-tile-content">
              <h4 class="set__data-tile-title">{L.settings.exportJSON}</h4>
              <p class="set__data-tile-desc">{L.settings.exportJSONDesc}</p>
            </div>
          </div>
          <Button
            variant="secondary"
            fullWidth
            class="set__data-tile-btn"
            @click="exportData()"
            :disabled="exporting"
          >
            <span x-show="!exporting" x-cloak x-text="labels.download">
              {L.settings.download}
            </span>
            <span x-show="exporting" x-cloak x-text="labels.preparing">
              {L.settings.preparing}
            </span>
          </Button>
        </div>

        <div class="set__data-tile">
          <div class="set__data-tile-header">
            <div class="set__data-tile-icon" aria-hidden="true">
              <Fragment set:html={icons.table(24, 24)} />
            </div>
            <div class="set__data-tile-content">
              <h4 class="set__data-tile-title">{L.settings.exportCSV}</h4>
              <p class="set__data-tile-desc">{L.settings.exportCSVDesc}</p>
            </div>
          </div>
          <Button
            variant="secondary"
            fullWidth
            class="set__data-tile-btn"
            @click="exportCSV()"
            :disabled="exportingCsv"
          >
            <span x-show="!exportingCsv" x-cloak x-text="labels.download">
              {L.settings.download}
            </span>
            <span x-show="exportingCsv" x-cloak x-text="labels.preparing">
              {L.settings.preparing}
            </span>
          </Button>
        </div>

        <div class="set__data-tile">
          <div class="set__data-tile-header">
            <div class="set__data-tile-icon" aria-hidden="true">
              <Fragment set:html={icons.upload(24, 24)} />
            </div>
            <div class="set__data-tile-content">
              <h4 class="set__data-tile-title">{L.settings.import}</h4>
              <p class="set__data-tile-desc">{L.settings.importDesc}</p>
            </div>
          </div>
          <Button
            variant="secondary"
            fullWidth
            class="set__data-tile-btn"
            @click="triggerImport()"
            :disabled="importing"
          >
            <span x-show="!importing" x-cloak>
              {L.settings.chooseFile}
            </span>
            <span x-show="importing" x-cloak x-text="labels.importing">
              {L.settings.importing}
            </span>
          </Button>
          <input
            type="file"
            accept="application/json,.json"
            class="sr-only set__file-input"
            @change="handleImportFile($event)"
            aria-hidden="true"
            tabindex="-1"
          />
        </div>
      </div>

      {/* Danger zone */}
      <div class="set__danger">
        <div class="set__danger-header">
          <span class="set__danger-badge">DANGER</span>
          <h4 class="set__danger-title">{L.settings.resetAll}</h4>
        </div>
        <p class="set__danger-desc">{L.settings.resetDesc}</p>
        <Button variant="destructive" class="set__danger-btn" @click="askReset()">
          {L.settings.resetAction}
        </Button>
      </div>
    </SettingsSection>
    7. SYNCHRONISATION WEBDAV
    <section class="set__section" id="set-sync">
      <Card>
        <CardHeader>
          <div class="set__sync-heading">
            <span class="set__heading-icon" aria-hidden="true">
              <Fragment set:html={icons.cloud(24, 24)} />
            </span>
            <CardTitle>{L.settings.sync.title}</CardTitle>
          </div>
          <p class="set__sync-desc">{L.settings.sync.desc}</p>
          <p class="set__sync-cors">{L.settings.sync.corsNote}</p>
        </CardHeader>

        <CardContent>
          <div class="set__sync-fields">
            <div class="set__rows">
              <div class="set__row set__row--start">
                <div class="set__label">
                  <label class="set__label-title" for="set-sync-url" x-text="labels.syncUrl">
                    {L.settings.sync.url}
                  </label>
                  <span class="set__label-desc" x-text="labels.syncConflict">
                    {L.settings.sync.conflict}
                  </span>
                </div>
                <div class="set__control set__control--right">
                  <Input
                    bare
                    size="md"
                    type="text"
                    id="set-sync-url"
                    class="set__sync-input"
                    x-model="syncForm.url"
                    @change="saveSyncFields()"
                    :placeholder="labels.syncUrlPlaceholder"
                    autocomplete="url"
                    spellcheck="false"
                    :aria-label="labels.syncUrl"
                  />
                </div>
              </div>

              <div class="set__row set__row--start">
                <div class="set__label">
                  <label class="set__label-title" for="set-sync-username">
                    {L.settings.sync.username}
                  </label>
                </div>
                <div class="set__control set__control--right">
                  <Input
                    bare
                    size="md"
                    type="text"
                    id="set-sync-username"
                    class="set__sync-input"
                    x-model="syncForm.username"
                    @change="saveSyncFields()"
                    :placeholder="labels.syncUsernamePlaceholder"
                    autocomplete="username"
                    spellcheck="false"
                    :aria-label="labels.syncUrl"
                  />
                </div>
              </div>

              <div class="set__row set__row--start">
                <div class="set__label">
                  <label class="set__label-title" for="set-sync-password">
                    {L.settings.sync.password}
                  </label>
                  <span class="set__label-desc">{L.settings.sync.passwordNote}</span>
                </div>
                <div class="set__control set__control--right">
                  <Input
                    bare
                    size="md"
                    type="password"
                    id="set-sync-password"
                    class="set__sync-input"
                    x-model="syncForm.password"
                    @change="saveSyncFields()"
                    :placeholder="labels.syncPasswordPlaceholder"
                    autocomplete="off"
                    :aria-label="labels.syncUrl"
                  />
                </div>
              </div>
            </div>
          </div>

          {/* Last sync status + Google Drive note */}
          <div class="set__sync-status" x-show="syncConfigured" x-cloak>
            <span class="set__sync-status-label">{L.settings.sync.lastSync}</span>
            <span class="set__sync-status-value" x-text="syncLastLabel"></span>
          </div>
          <p class="set__sync-note">{L.settings.sync.googleDrive}</p>

          {/* Manual-only actions */}
          <div class="set__sync-actions">
            <Button
              variant="secondary"
              type="button"
              class="set__sync-btn"
              :disabled="syncBusy !== null || !syncForm.url.trim()"
              :loading="syncBusy === 'test'"
              @click="testSync()"
            >
              <span x-show="syncBusy !== 'test'" x-cloak x-text="labels.syncTest">
                {L.settings.sync.test}
              </span>
              <span x-show="syncBusy === 'test'" x-cloak x-text="labels.syncTesting">
                {L.settings.sync.testing}
              </span>
            </Button>
            <Button
              variant="primary"
              type="button"
              class="set__sync-btn"
              :disabled="syncBusy !== null || !syncForm.url.trim()"
              :loading="syncBusy === 'push'"
              @click="askPush()"
            >
              <span x-show="syncBusy !== 'push'" x-cloak x-text="labels.syncPush">
                {L.settings.sync.push}
              </span>
              <span x-show="syncBusy === 'push'" x-cloak x-text="labels.syncPushing">
                {L.settings.sync.pushing}
              </span>
            </Button>
            <Button
              variant="secondary"
              type="button"
              class="set__sync-btn"
              :disabled="syncBusy !== null || !syncForm.url.trim()"
              :loading="syncBusy === 'pull'"
              @click="askRestore()"
            >
              <span x-show="syncBusy !== 'pull'" x-cloak x-text="labels.syncPull">
                {L.settings.sync.pull}
              </span>
              <span x-show="syncBusy === 'pull'" x-cloak x-text="labels.syncPulling">
                {L.settings.sync.pulling}
              </span>
            </Button>
          </div>
        </CardContent>
      </Card>
    </section>
    8. À PROPOS
    <SettingsSection
      icon="infoCircle"
      title={L.settings.about}
      description={L.settings.aboutDesc}
      id="set-about"
    >
      <dl class="set__about-grid">
        <div class="set__about-row">
          <dt class="set__about-dt">{L.settings.version}</dt>
          <dd class="set__about-dd">
            <span class="set__about-pill">v{APP_VERSION}</span>
          </dd>
        </div>
        <div class="set__about-row">
          <dt class="set__about-dt">{L.settings.storage}</dt>
          <dd class="set__about-dd">{L.settings.storageValue}</dd>
        </div>
        <div class="set__about-row">
          <dt class="set__about-dt">{L.settings.mode}</dt>
          <dd class="set__about-dd">{L.settings.modeValue}</dd>
        </div>
        <div class="set__about-row">
          <dt class="set__about-dt">{L.settings.fonts}</dt>
          <dd class="set__about-dd">Inter</dd>
        </div>
        <div class="set__about-row">
          <dt class="set__about-dt">{L.settings.icons}</dt>
          <dd class="set__about-dd">Lucide</dd>
        </div>
        <div class="set__about-row">
          <dt class="set__about-dt">{L.settings.framework}</dt>
          <dd class="set__about-dd">Astro 7</dd>
        </div>
      </dl>

      <p class="set__about-credits">{L.settings.credits}</p>
    </SettingsSection>
    RESET CONFIRMATION DIALOG
    <Dialog id="set-reset-dialog" title={`${L.settings.resetAll} ?`}>
      <p class="set__dialog-text">
        {L.settings.resetConfirmIntro}
        <strong class="text-destructive"> {L.settings.resetConfirmIntroStrong}</strong> —
        {L.settings.resetConfirmIntroList}
      </p>
      <p class="set__dialog-muted">
        {L.settings.resetConfirmAction} <strong class="text-destructive">SUPPRIMER</strong>{' '}
        {L.settings.resetConfirmActionOutro}
        {L.settings.resetIrreversible}
      </p>
      <div class="set__dialog-input-wrap">
        <Input
          bare
          size="md"
          type="text"
          class="set__confirm-input"
          placeholder="SUPPRIMER"
          x-model="resetConfirmText"
          autocomplete="off"
          :aria-label="labels.resetConfirm"
        />
      </div>

      <div slot="footer">
        <DialogFooter
          cancelLabel={L.common.cancel}
          confirmLabel={L.settings.resetPermanent}
          confirmDisabled="resetConfirmText !== 'SUPPRIMER'"
          confirmClick="confirmReset()"
        />
      </div>
    </Dialog>
    WEBDAV PUSH OVERWRITE CONFIRMATION DIALOG
    <Dialog id="set-push-dialog" title={L.settings.sync.pushTitle}>
      <p class="set__dialog-text">{L.settings.sync.pushBody}</p>
      <p class="set__dialog-muted">{L.settings.sync.pushIrreversible}</p>

      <div slot="footer">
        <Button variant="secondary" data-dialog-close type="button">
          {L.common.cancel}
        </Button>
        <Button
          variant="destructive"
          type="button"
          x-bind:disabled="syncBusy !== null"
          @click="confirmPush()"
        >
          <span x-show="syncBusy !== 'push'" x-cloak>
            {L.settings.sync.pushConfirm}
          </span>
          <span x-show="syncBusy === 'push'" x-cloak>
            {L.settings.sync.pushing}
          </span>
        </Button>
      </div>
    </Dialog>
    WEBDAV RESTORE CONFIRMATION DIALOG
    <Dialog id="set-restore-dialog" title={L.settings.sync.restoreTitle}>
      <p class="set__dialog-text">{L.settings.sync.restoreBody}</p>
      <p class="set__dialog-muted">{L.settings.sync.restoreIrreversible}</p>

      <div slot="footer">
        <Button variant="secondary" data-dialog-close type="button">
          {L.common.cancel}
        </Button>
        <Button
          variant="destructive"
          type="button"
          x-bind:disabled="syncBusy !== null"
          @click="confirmRestore()"
        >
          <span x-show="syncBusy !== 'pull'" x-cloak>
            {L.settings.sync.restoreConfirm}
          </span>
          <span x-show="syncBusy === 'pull'" x-cloak>
            {L.settings.sync.pulling}
          </span>
        </Button>
      </div>
    </Dialog>
  </div>
</AppLayout>

<script>
  import { singleton as uiStore } from '../../lib/ui-store';
  import { registerAlpine } from '../../lib/alpine';
  import { createSettingsApp, buildSettingsLabels } from '../../components/settings/settingsApp';
  import { t, DATE_LOCALE } from '../../i18n';
  import { downloadBlob } from '../../lib/csv-export';

  const LABELS = t();

  function readFile(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result ?? ''));
      reader.onerror = () => reject(new Error(LABELS.settings.readError));
      reader.readAsText(file);
    });
  }
  registerAlpine('settingsApp', () =>
    createSettingsApp({
      labels: buildSettingsLabels(LABELS),
      clock: {
        now: () => new Date(),
        nowIso: () => new Date().toISOString(),
        locale: () => DATE_LOCALE(),
      },
      ui: {
        notify: (message, kind) => uiStore.notify(message, kind),
        download: downloadBlob,
        readFile,
        openDialog: (id) => uiStore.openDialog(id),
        closeDialog: (id) => uiStore.closeDialog(id),
        pickImportFile: () => {
          const input = document.querySelector<HTMLInputElement>('.set__file-input');
          if (!input) return;
          input.value = '';
          input.click();
        },
      },
    })
  );
</script>

<style>
  .set {
    padding-bottom: calc(var(--bottom-nav-height, 5.6rem) + 2rem);
    scroll-padding-top: calc(var(--topbar-height, 5.6rem) + 1rem);
  }

  /* ── Rows ── */
  .set__rows {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1.2rem;
  }

  .set__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--alpha-bg-soft);
  }
  .set__row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .set__row:first-child {
    padding-top: 0;
  }
  .set__row--start {
    align-items: flex-start;
  }

  /* ── Label ── */
  .set__label {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    min-width: 0;
    flex: 1;
  }

  /* ── Control ── */
  .set__control {
    flex-shrink: 0;
    width: 100%;
    max-width: 24rem;
  }
  .set__control--right {
    text-align: right;
    font-size: 1.3rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── Sync input (font + placeholder overrides) ── */
  .set__sync-input {
    font-family: var(--font-body);
    font-size: 1.3rem;
  }
  .set__sync-input::placeholder {
    color: var(--color-muted);
  }

  /* ── Segmented control ── */
  .set__seg-group {
    display: inline-flex;
    padding: 0.3rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
  }
  .set__seg-btn {
