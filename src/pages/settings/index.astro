---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';

import { t } from '../../i18n';
import ReminderSettings from '../../components/workout/ReminderSettings.astro';
import SettingsProfile from '../../components/settings/SettingsProfile.astro';
import SettingsGoals from '../../components/settings/SettingsGoals.astro';
import SettingsData from '../../components/settings/SettingsData.astro';
import SettingsDialogs from '../../components/settings/SettingsDialogs.astro';

const L = t();
---

<AppLayout title={L.settings.title}>
  <PageHeader title={L.settings.title} description={L.settings.description} />

  <div class="set" x-data="settingsApp()" x-init="init()" x-cloak>
    <SettingsProfile />
    <SettingsGoals />
    5. RAPPEL D'ENTRAÎNEMENT
    <ReminderSettings />
    <ReminderSettings />
    <SettingsData />
    <SettingsDialogs />
  </div>
</AppLayout>

<script>
  import { singleton as uiStore } from '../../lib/ui-store';
  import { registerAlpine } from '../../lib/alpine';
  import { createSettingsApp, buildSettingsLabels } from '../../components/settings/settingsApp';
  import { t, DATE_LOCALE } from '../../i18n';
  import { downloadBlob } from '../../lib/csv-export';

  const LABELS = t();

  function readFile(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result ?? ''));
      reader.onerror = () => reject(new Error(LABELS.settings.readError));
      reader.readAsText(file);
    });
  }
  registerAlpine('settingsApp', () =>
    createSettingsApp({
      labels: buildSettingsLabels(LABELS),
      clock: {
        now: () => new Date(),
        nowIso: () => new Date().toISOString(),
        locale: () => DATE_LOCALE(),
      },
      ui: {
        notify: (message, kind) => uiStore.notify(message, kind),
        download: downloadBlob,
        readFile,
        openDialog: (id) => uiStore.openDialog(id),
        closeDialog: (id) => uiStore.closeDialog(id),
        pickImportFile: () => {
          const input = document.querySelector<HTMLInputElement>('.set__file-input');
          if (!input) return;
          input.value = '';
          input.click();
        },
      },
    })
  );
</script>

<style>
  .set {
    padding-bottom: calc(var(--bottom-nav-height, 5.6rem) + 2rem);
    scroll-padding-top: calc(var(--topbar-height, 5.6rem) + 1rem);
  }

  .text-destructive {
    color: var(--color-destructive);
  }
</style>
