---
import AppLayout from '../layouts/AppLayout.astro';
import { DEMO_PROFILE, buildDemoSessions } from '../lib/demo-data';
import {
  computeBestPRs,
  computeSessionVolume,
  computeStreak,
  computeTop1RM,
  computeTotalVolume,
  computeWeeklyVolumeByDay,
} from '../lib/dashboard-stats';
import { aggregateByWeek, buildWeeks, topExercisesByVolume } from '../lib/week-aggregation';
import { formatDateShort, formatNumber } from '../lib/format';

const formatSessionDuration = (seconds?: number) =>
  seconds && seconds > 0 ? `${Math.round(seconds / 60)} min` : '—';

const now = new Date();
const sessions = buildDemoSessions(now);
const completed = sessions.filter((session) => session.status === 'completed');

const weeks = buildWeeks(12, now);
aggregateByWeek(sessions, weeks);
const currentWeek = weeks[weeks.length - 1];

const totalVolume = computeTotalVolume(completed);
const totalSessions = completed.length;
const streak = computeStreak(completed);
const top1RM = computeTop1RM(completed);
const bestPRs = computeBestPRs(completed);
const weeklyVolume = computeWeeklyVolumeByDay(completed);
const maxWeekly = Math.max(...weeklyVolume, 1);
const maxTrend = Math.max(...weeks.map((week) => week.volume), 1);

const topExercises = topExercisesByVolume(completed, 5, 12, now);
const maxExercise = Math.max(...topExercises.map((item) => item.volume), 1);
const recent = completed.slice(0, 6);
const { name, initials, email, since, weeklyGoal } = DEMO_PROFILE;
---

<AppLayout title={`Démo — ${name}`} skipAuth>
  <div class="demo">
    <p class="demo__banner">
      <span class="demo__banner-mark" aria-hidden="true"></span>
      Démonstration · données fictives · lecture seule — aucune donnée n'est enregistrée
    </p>

    <header class="demo__profile">
      <div class="demo__avatar" aria-hidden="true">
        {initials}
      </div>
      <div class="demo__identity">
        <h1 class="demo__name">{name}</h1>
        <p class="demo__meta">
          {email} · Membre depuis {formatDateShort(since)}
        </p>
      </div>
      <span class="demo__tag">Profil fictif</span>
    </header>

    <section class="demo__metrics" aria-label="Indicateurs de démonstration">
      <div class="demo__metric">
        <span class="demo__metric-label">Volume · 12 sem.</span>
        <strong class="demo__metric-value">
          {formatNumber(totalVolume)} <span class="demo__metric-unit">kg</span>
        </strong>
      </div>
      <div class="demo__metric">
        <span class="demo__metric-label">Séances terminées</span>
        <strong class="demo__metric-value">{totalSessions}</strong>
      </div>
      <div class="demo__metric">
        <span class="demo__metric-label">Série en cours</span>
        <strong class="demo__metric-value">
          {streak} <span class="demo__metric-unit">{streak === 1 ? 'jour' : 'jours'}</span>
        </strong>
      </div>
      <div class="demo__metric">
        <span class="demo__metric-label">Meilleur 1RM</span>
        <strong class="demo__metric-value">
          {formatNumber(top1RM)} <span class="demo__metric-unit">kg</span>
        </strong>
      </div>
    </section>

    <div class="demo__grid">
      <section class="demo__panel">
        <header class="demo__panel-head">
          <h2>Volume hebdomadaire</h2>
          <span class="demo__panel-meta">12 dernières semaines · kg soulevés</span>
        </header>
        <div class="demo__trend" role="img" aria-label="Volume par semaine sur 12 semaines">
          {weeks.map((week) => (
            <span
              class="demo__trend-col"
              title={`${formatDateShort(week.key)} · ${formatNumber(week.volume)} kg`}
              style={`height: ${Math.max(3, (week.volume / maxTrend) * 100)}%`}
            />
          ))}
        </div>
      </section>

      <section class="demo__panel">
        <header class="demo__panel-head">
          <h2>Objectif hebdomadaire</h2>
          <span class="demo__panel-meta">{weeklyGoal} séances / semaine</span>
        </header>
        <div class="demo__goal">
          <strong class="demo__goal-value">
            {currentWeek.sessionCount}
            <span> / {weeklyGoal}</span>
          </strong>
          <span class="demo__goal-hint">
            {currentWeek.sessionCount >= weeklyGoal
              ? 'Objectif atteint pour cette semaine.'
              : `${weeklyGoal - currentWeek.sessionCount} ${weeklyGoal - currentWeek.sessionCount === 1 ? 'séance restante' : 'séances restantes'}.`}
          </span>
          <div class="demo__goal-bars" role="img" aria-label="Volume des 7 derniers jours">
            {weeklyVolume.map((value, index) => (
              <span
                class:list={['demo__goal-bar', index === now.getDay() && 'demo__goal-bar--today']}
                style={`height: ${Math.max(6, (value / maxWeekly) * 100)}%`}
              />
            ))}
          </div>
        </div>
      </section>
    </div>

    <section class="demo__panel">
      <header class="demo__panel-head">
        <h2>Dernières séances</h2>
        <span class="demo__panel-meta">
          {totalSessions} séances · {bestPRs} exercices pratiqués
        </span>
      </header>
      <ul class="demo__sessions">
        {recent.map((session) => (
          <li class="demo__session">
            <span class="demo__session-date">{formatDateShort(session.date)}</span>
            <span class="demo__session-name">{session.name}</span>
            <span class="demo__session-meta">
              {session.exercises.length} exercices · {formatSessionDuration(session.duration)}
            </span>
            <span class="demo__session-volume">
              {formatNumber(computeSessionVolume(session))} kg
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="demo__panel">
      <header class="demo__panel-head">
        <h2>Top exercices</h2>
        <span class="demo__panel-meta">par volume total · 12 semaines</span>
      </header>
      <ul class="demo__tops">
        {topExercises.map((item) => (
          <li class="demo__top">
            <span class="demo__top-name">{item.name}</span>
            <span class="demo__top-track">
              <span class="demo__top-fill" style={`width: ${(item.volume / maxExercise) * 100}%`} />
            </span>
            <span class="demo__top-value">{formatNumber(item.volume)} kg</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</AppLayout>

<style>
  .demo {
    max-width: var(--page-max-w);
    margin: 0 auto;
    padding-bottom: 6rem;
  }

  .demo__banner {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 3.2rem;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .demo__banner-mark {
    width: 0.8rem;
    height: 0.8rem;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  .demo__profile {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-bottom: 3.2rem;
    padding-bottom: 2.4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .demo__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6.4rem;
    height: 6.4rem;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 700;
  }

  .demo__identity {
    min-width: 0;
    flex: 1;
  }

  .demo__name {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .demo__meta {
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .demo__tag {
    flex-shrink: 0;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
  }

  .demo__metrics {
    display: grid;
    grid-template-columns: 1fr;
    margin-bottom: 2.4rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .demo__metric {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 2rem 1.6rem;
  }

  .demo__metric + .demo__metric {
    border-top: 1px solid var(--color-border);
  }

  .demo__metric-label {
    color: var(--color-muted);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
  }

  .demo__metric-value {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-metric);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .demo__metric-unit {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .demo__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    margin-bottom: 2.4rem;
  }

  .demo__panel {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }

  .demo__panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .demo__panel-head h2 {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 700;
  }

  .demo__panel-meta {
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .demo__trend {
    display: flex;
    align-items: flex-end;
    gap: 0.8rem;
    height: 12rem;
  }

  .demo__trend-col {
    flex: 1;
    min-width: 0;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: var(--color-border-strong);
  }

  .demo__trend-col:last-child {
    background: var(--color-accent);
  }

  .demo__goal {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .demo__goal-value {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .demo__goal-value span {
    color: var(--color-muted);
  }

  .demo__goal-hint {
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .demo__goal-bars {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    height: 5rem;
  }

  .demo__goal-bar {
    flex: 1;
    min-width: 0;
    height: 6%;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: var(--color-border-strong);
  }

  .demo__goal-bar--today {
    background: var(--color-accent);
  }

  .demo__sessions,
  .demo__tops {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .demo__session {
    display: grid;
    grid-template-columns: 9rem 1fr auto auto;
    align-items: center;
    gap: 1.2rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-small);
  }

  .demo__session-date,
  .demo__session-meta {
    color: var(--color-muted);
  }

  .demo__session-name {
    color: var(--color-text);
    font-weight: 600;
  }

  .demo__session-volume {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .demo__top {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(8rem, 2fr) auto;
    align-items: center;
    gap: 1.2rem;
    padding: 0.8rem 0;
    font-size: var(--text-small);
  }

  .demo__top-name {
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .demo__top-track {
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface-3);
    overflow: hidden;
  }

  .demo__top-fill {
    display: block;
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  .demo__top-value {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 760px) {
    .demo__metrics {
      grid-template-columns: repeat(4, 1fr);
    }

    .demo__metric + .demo__metric {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }

    .demo__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .demo__profile {
      flex-wrap: wrap;
    }

    .demo__tag {
      order: 3;
    }

    .demo__session {
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
    }

    .demo__session-meta {
      grid-column: 1;
    }
  }
</style>
