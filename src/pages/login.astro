---
import { resolveLocale } from '../i18n';

import AppLayout from '../layouts/AppLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import Input from '../components/ui/Input.astro';
import { t } from '../i18n';

const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
---

<AppLayout title={L.login.title} groups={[]}>
  <div class="login" x-data="loginApp()" x-init="init()" x-cloak>
    <div class="login__card" role="form" aria-labelledby="login-title">
      {/* ── Nav: theme · logo · language ── */}
      <div class="login__nav">
        <div class="login__nav-side">
          <button
            type="button"
            class="login__theme-btn"
            @click="toggleTheme()"
            :aria-label="isDark() ? switchToLight : switchToDark"
            :title="isDark() ? switchToLight : switchToDark"
          >
            <span class="login__theme-icon--sun" aria-hidden="true">
              <Icon name="sun" size={18} />
            </span>
            <span class="login__theme-icon--moon" aria-hidden="true">
              <Icon name="moon" size={18} />
            </span>
          </button>
        </div>

        <div class="login__brand" aria-hidden="true">
          <Icon name="dumbbell" size={32} />
        </div>

        <div class="login__nav-side login__nav-side--end">
          <Button
            variant="secondary"
            size="md"
            @click="toggleLocale()"
            :aria-label="switchLocaleAria + ' : ' + langTarget"
            :title="switchLocaleAria"
            class="login__lang-btn"
          >
            <Icon name="globe" size={18} slot="icon-left" />
            <span x-text="langTarget">EN</span>
          </Button>
        </div>
      </div>

      <h1 id="login-title" class="login__title">
        {L.login.title}
      </h1>
      <p class="login__subtitle">{L.login.subtitle}</p>

      {/* ── Form ── */}
      <form class="login__form" @submit.prevent="submit" novalidate>
        <div class="login__field">
          <label for="login-email" class="login__label">
            {L.login.email}
          </label>
          <Input
            type="email"
            id="login-email"
            placeholder="vous@exemple.com"
            x-model="email"
            @input="error = ''"
            required
            autocomplete="email"
            spellcheck="false"
            bare
            class="login__input"
          />
        </div>

        <div class="login__field">
          <label for="login-password" class="login__label">
            {L.login.password}
          </label>
          <div class="login__pw-wrap">
            <Input
              :type="showPassword ? 'text' : 'password'"
              id="login-password"
              placeholder="••••••••"
              x-model="password"
              @input="error = ''"
              required
              autocomplete="current-password"
              bare
              class="login__input login__input--pw"
            />
            <button
              type="button"
              class="icon-btn icon-btn--ghost login__pw-toggle"
              x-html="showPassword ? icons.eyeOff() : icons.eye()"
              :aria-label="showPassword ? labels.hidePassword : labels.showPassword"
              @click="showPassword = !showPassword"
            ></button>
          </div>
        </div>

        <p class="login__error" x-show="error" x-text="error" x-cloak role="alert"></p>

        <Button
          type="submit"
          variant="primary"
          fullWidth
          minHeight="5.2rem"
          :disabled="loading"
          @click="submit"
          class="login__submit"
        >
          <span class="login__submit-label" x-text="labels.submit">
            {L.login.submit}
          </span>
          <span class="login__submit-loading" x-show="loading" x-cloak>
            <span class="login__spinner">
              <Icon name="spinner" size={18} />
            </span>
            <span x-text="labels.loading">{L.login.loading}</span>
          </span>
        </Button>
      </form>

      {/* ── Divider ── */}
      <div class="login__divider" aria-hidden="true">
        <span class="login__divider-text">ou</span>
      </div>

      {/* ── Dev mode ── */}
      <section class="login__dev" aria-labelledby="login-dev-title">
        <div class="login__dev-header">
          <span class="login__dev-badge" aria-hidden="true">
            DEV
          </span>
          <h2 id="login-dev-title" class="login__dev-title">
            {L.login.devMode}
          </h2>
        </div>
        <p class="login__dev-warning" role="note">
          <span aria-hidden="true" class="login__dev-warning-icon">
            <Icon name="alertTriangle" size={16} />
          </span>
          {L.login.devWarning}
        </p>
        <Button variant="secondary" fullWidth @click="devLogin()" class="login__dev-btn">
          <Icon name="zap" size={18} class="login__dev-btn-icon" slot="icon-left" />
          <span>{L.login.devLogin}</span>
        </Button>
      </section>

      <section class="login__dev login__demo" aria-labelledby="login-demo-title">
        <div class="login__dev-header">
          <span class="login__dev-badge" aria-hidden="true">
            DÉMO
          </span>
          <h2 id="login-demo-title" class="login__dev-title">
            {L.login.demoMode}
          </h2>
        </div>
        <p class="login__dev-warning" role="note">
          <span aria-hidden="true" class="login__dev-warning-icon">
            <Icon name="alertTriangle" size={16} />
          </span>
          {L.login.demoWarning}
        </p>
        <Button variant="primary" fullWidth @click="demoLogin()" class="login__dev-btn">
          <span>{L.login.demoLogin}</span>
        </Button>
      </section>

      {/* ── Signup link ── */}
      <div class="login__signup">
        <p class="login__signup-text">{L.login.createAccount}</p>
        <Button
          variant="secondary"
          type="button"
          fullWidth
          @click="showSignupMessage = !showSignupMessage"
          class="login__signup-btn"
        >
          {L.login.createAccountLink}
        </Button>
      </div>

      <p
        class="login__signup-msg"
        x-show="showSignupMessage"
        x-cloak
        x-transition.opacity.duration.200ms
        x-text="labels.signupMessage"
      >
        {L.login.signupMessage}
      </p>
    </div>

    <p class="login__footer">GYM EMPIRE · TRAINING LOG</p>
  </div>
</AppLayout>

<script>
  import { registerLogin } from '../components/layout/loginRegistration.ts';

  registerLogin();
</script>
