---
/**
 * Route locale EN unique — remplace les 20 stubs identiques.
 * Chaque page racine reste l'unique implémentation ; sa locale est dérivée
 * de l'URL (/en/...) par useI18n() dans son propre frontmatter.
 */
import Index from '../index.astro';
import Calculator from '../calculator.astro';
import Calendar from '../calendar.astro';
import Login from '../login.astro';
import Ui from '../ui.astro';
import ExercisesIndex from '../exercises/index.astro';
import ExercisesHistory from '../exercises/history.astro';
import ExercisesTrends from '../exercises/trends.astro';
import ProgressionIndex from '../progression/index.astro';
import ProgressionPoids from '../progression/poids.astro';
import ProgressionRecords from '../progression/records.astro';
import ProgressionStats from '../progression/stats.astro';
import SessionsIndex from '../sessions/index.astro';
import SessionsDetail from '../sessions/detail.astro';
import SessionsCompare from '../sessions/compare.astro';
import SessionsQuick from '../sessions/quick.astro';
import SessionsPrint from '../sessions/print.astro';
import SessionsCreate from '../sessions/create/index.astro';
import SettingsIndex from '../settings/index.astro';
import TimerIndex from '../timer/index.astro';

export function getStaticPaths() {
  const routes = [
    { slug: undefined, Page: Index },
    { slug: 'calculator', Page: Calculator },
    { slug: 'calendar', Page: Calendar },
    { slug: 'login', Page: Login },
    { slug: 'ui', Page: Ui },
    { slug: 'exercises', Page: ExercisesIndex },
    { slug: 'exercises/history', Page: ExercisesHistory },
    { slug: 'exercises/trends', Page: ExercisesTrends },
    { slug: 'progression', Page: ProgressionIndex },
    { slug: 'progression/poids', Page: ProgressionPoids },
    { slug: 'progression/records', Page: ProgressionRecords },
    { slug: 'progression/stats', Page: ProgressionStats },
    { slug: 'sessions', Page: SessionsIndex },
    { slug: 'sessions/detail', Page: SessionsDetail },
    { slug: 'sessions/compare', Page: SessionsCompare },
    { slug: 'sessions/quick', Page: SessionsQuick },
    { slug: 'sessions/print', Page: SessionsPrint },
    { slug: 'sessions/create', Page: SessionsCreate },
    { slug: 'settings', Page: SettingsIndex },
    { slug: 'timer', Page: TimerIndex },
  ];
  return routes.map(({ slug, Page }) => ({ params: { slug }, props: { Page } }));
}

const { Page } = Astro.props;
---

<Page />
