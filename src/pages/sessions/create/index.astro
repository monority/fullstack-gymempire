---
import AppLayout from '../../../layouts/AppLayout.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import Card from '../../../components/ui/Card.astro';
import CardHeader from '../../../components/ui/CardHeader.astro';
import CardTitle from '../../../components/ui/CardTitle.astro';
import CardContent from '../../../components/ui/CardContent.astro';

import Input from '../../../components/ui/Input.astro';

import { t } from '../../../i18n';

import CreateActionBar from '../../../components/builder/CreateActionBar.astro';
import CreateExerciseList from '../../../components/builder/CreateExerciseList.astro';
import CreateNotes from '../../../components/builder/CreateNotes.astro';
import CreatePicker from '../../../components/builder/CreatePicker.astro';

const L = t();
const editId = Astro.url.searchParams.get('edit');
const isEditMode = Boolean(editId);
---

<AppLayout title={isEditMode ? L.builder.editTitle : L.builder.title}>
  <PageHeader
    title={isEditMode ? L.builder.editTitle : L.builder.title}
    description={L.builder.description}
  />

  <div
    class="create__main"
    x-data="sessionBuilder()"
    x-init="init()"
    x-cloak
    @builder:remove-exercise.window="removeExercise($event.detail.index)"
    @builder:remove-superset.window="removeFromSuperset($event.detail.index)"
  >
    <CreateActionBar />
    <Card>
      <CardHeader>
        <CardTitle>{L.builder.infoTitle}</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="create__info-grid">
          <Input
            label={L.builder.name}
            id="ses-name"
            type="text"
            required
            placeholder={L.builder.namePlaceholder}
            x-model="sessionName"
            autocomplete="off"
            maxlength={80}
          />
          <Input label={L.builder.date} id="ses-date" type="date" x-model="sessionDate" />
        </div>
      </CardContent>
    </Card>

    <CreateExerciseList />
    <CreateNotes />
    <CreatePicker />
  </div>
</AppLayout>

<script>
  import { singleton as uiStore } from '../../../lib/ui-store';
  import { registerAlpine } from '../../../lib/alpine';
  import { createSessionBuilderApp } from '../../../components/builder/sessionBuilder';
  import { pickBuilderLabels } from '../../../components/builder/builderLabels';
  import { exerciseCard } from '../../../components/builder/exerciseCard';
  import { t, localizedPath, DATE_LOCALE } from '../../../i18n';

  const LABELS = t();
  const BUILDER_LABELS = pickBuilderLabels(
    LABELS as unknown as { builder: Record<string, string> }
  );

  type BuilderWindow = Window & {
    __builderSessions?: unknown;
    __builderLabels?: unknown;
    openDialog?: (id: string) => void;
    closeDialog?: (id: string) => void;
  };
  const host = window as BuilderWindow;
  registerAlpine('exerciseCard', (...args: Parameters<typeof exerciseCard>) =>
    exerciseCard(...args)
  );
  registerAlpine('sessionBuilder', () =>
    createSessionBuilderApp({
      labels: BUILDER_LABELS,
      rpeLabels:
        LABELS.builder as unknown as import('../../../components/builder/sessionMeta').SessionMetaLabels,
      search: window.location.search,
      today: () => new Date().toISOString().split('T')[0],
      locale: DATE_LOCALE(),
      localizedPath,
      host: {
        expose: (sessions, labels) => {
          host.__builderSessions = sessions;
          host.__builderLabels = labels;
        },
        onToggle: (listener) => {
          window.addEventListener('builder:exercise-toggled', ((e: CustomEvent) => {
            listener(e.detail.exerciseId, e.detail.expanded);
          }) as EventListener);
        },
        openDialog: (id) => uiStore.openDialog(id),
        closeDialog: (id) => uiStore.closeDialog(id),
        dispatch: (name) => window.dispatchEvent(new CustomEvent(name)),
        confirm: (message) => window.confirm(message),
        navigate: (href) => {
          window.location.href = href;
        },
        focusPickerSearch: () => {
          requestAnimationFrame(() => {
            document.querySelector<HTMLInputElement>('[x-ref="pickerSearch"]')?.focus();
          });
        },
      },
    })
  );
</script>

<style>
  [x-cloak] {
    display: none !important;
  }

  .create__main {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 6rem;
  }

  .create__info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .create__toggle-body {
    flex: 1 1 0%;
    min-width: 0;
  }

  .create__input {
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    min-height: 4.4rem;
    padding: 0.8rem 1rem;
    color: var(--color-text);
    font-size: 1.3rem;
    font-family: var(--font-body);
    width: 100%;
    outline: none;
  }

  .create__input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .create__validation {
    color: var(--color-destructive);
    font-size: 1.3rem;
    font-weight: 500;
    text-align: center;
    padding: 0.5rem 0;
  }
</style>
