---
import '../../../styles/components/builder-page.css';
import '../../../styles/components/builder-library.css';

import { resolveLocale } from '../../../i18n';

import AppLayout from '../../../layouts/AppLayout.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import Card from '../../../components/ui/Card.astro';
import CardHeader from '../../../components/ui/CardHeader.astro';
import CardTitle from '../../../components/ui/CardTitle.astro';
import CardContent from '../../../components/ui/CardContent.astro';

import Input from '../../../components/ui/Input.astro';

import { t } from '../../../i18n';

import CreateActionBar from '../../../components/builder/CreateActionBar.astro';
import CreateLibraryPanel from '../../../components/builder/CreateLibraryPanel.astro';
import CreateExerciseList from '../../../components/builder/CreateExerciseList.astro';
import CreateNotes from '../../../components/builder/CreateNotes.astro';
import CreatePicker from '../../../components/builder/CreatePicker.astro';

const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
const editId = Astro.url.searchParams.get('edit');
const isEditMode = Boolean(editId);
---

<AppLayout title={isEditMode ? L.builder.editTitle : L.builder.title}>
  <PageHeader
    title={isEditMode ? L.builder.editTitle : L.builder.title}
    description={L.builder.description}
  />

  <div
    class="create__main"
    x-data="sessionBuilder()"
    x-init="init()"
    x-cloak
    @input.debounce.400ms="persistDraft()"
    @change.debounce.400ms="persistDraft()"
    @builder:remove-exercise.window="removeExercise($event.detail.index)"
    @builder:remove-superset.window="removeFromSuperset($event.detail.index)"
    @builder:add-superset.window="addToSuperset($event.detail.index)"
  >
    <CreateActionBar />

    <div class="create__layout">
      <CreateLibraryPanel />

      <div class="create__draft">
        <Card>
          <CardHeader>
            <CardTitle>{L.builder.infoTitle}</CardTitle>
          </CardHeader>
          <CardContent>
            <div class="create__info-grid">
              <Input
                label={L.builder.name}
                id="ses-name"
                type="text"
                required
                placeholder={L.builder.namePlaceholder}
                x-model="sessionName"
                autocomplete="off"
                maxlength={80}
              />
              <Input
                label={L.builder.date}
                id="ses-date"
                type="date"
                required
                x-model="sessionDate"
              />
            </div>
          </CardContent>
        </Card>

        <CreateExerciseList />
        <CreateNotes />
      </div>
    </div>

    <CreatePicker />
  </div>
</AppLayout>

<script>
  import { registerBuilder } from '../../../components/builder/registration';

  registerBuilder();
</script>
