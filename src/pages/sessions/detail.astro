---
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Dialog from '../../components/ui/Dialog.astro';
import Icon from '../../components/ui/Icon.astro';
import { t, localizedPath } from '../../i18n';
import BackLink from '../../components/ui/BackLink.astro';
import DialogFooter from '../../components/ui/DialogFooter.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import SessionHeader from '../../components/session-detail/SessionHeader.astro';
import StatusSection from '../../components/session-detail/StatusSection.astro';
import StatsGrid from '../../components/session-detail/StatsGrid.astro';
import SessionActions from '../../components/session-detail/SessionActions.astro';
import NotesSection from '../../components/session-detail/NotesSection.astro';
import ExerciseList from '../../components/session-detail/ExerciseList.astro';

const L = t();
---

<AppLayout title={L.detail.title}>
  <div class="detail" x-data="sessionDetailApp()" x-init="init()" x-cloak>
    {/* ── Back link ── */}
    <BackLink href={localizedPath('/sessions')} label={L.detail.backToSessions} />
    <template x-if="notFound">
      <EmptyState
        variant="error"
        title={L.detail.notFound}
        description={L.detail.notFoundDesc}
        actionLabel={L.detail.viewAllSessions}
        actionHref={localizedPath('/sessions')}
      />
    </template>
    {/* ── Loaded session ── */}
    <template x-if="!notFound && session">
      <div class="detail__content">
        <SessionHeader />
        <StatusSection />
        <StatsGrid />
        <SessionActions />

        {/* RPE-based progression suggestions */}
        <template x-if="session.status === 'completed' && rpeSuggestion">
          <section class="detail__suggestion">
            <h2 class="detail__section-title" x-text="labels.suggestionTitle"></h2>
            <Card>
              <div class="suggestion" :class="'suggestion--' + rpeSuggestion.tone">
                <div class="suggestion__icon" aria-hidden="true">
                  <Icon name="sun" size={20} />
                </div>
                <div class="suggestion__body">
                  <div class="suggestion__headline" x-text="rpeSuggestion.headline"></div>
                  <p class="suggestion__detail" x-text="rpeSuggestion.detail"></p>
                  <div class="suggestion__meta">
                    <span>
                      <span x-text="labels.rpeAvg"></span>
                      <strong x-text="formatRpe(rpeStats.avg)"></strong>/10
                    </span>
                    <span>
                      <span x-text="labels.rpeMax"></span>
                      <strong x-text="formatRpe(rpeStats.max)"></strong>/10
                    </span>
                    <span>
                      <span x-text="labels.setsAnalyzed"></span>
                      <strong x-text="rpeStats.count"></strong>
                    </span>
                  </div>
                </div>
              </div>
            </Card>
          </section>
        </template>

        <NotesSection />
        <ExerciseList />
      </div>
    </template>
    <Dialog id="delete-session-dialog" title={L.detail.confirmDelete}>
      <p class="detail__confirm-text">
        {L.detail.confirmDeleteIntro}
        <strong x-text="session ? session.name : '{L.detail.thisSession}'"></strong>.
        {L.detail.irreversible}
      </p>

      <div slot="footer">
        <DialogFooter
          cancelLabel={L.common.cancel}
          confirmLabel={L.detail.deletePermanently}
          confirmClick="confirmDelete"
        />
      </div>
    </Dialog>
    HIDDEN SHARE CARD DOM reference for the shareable image. The actual PNG is generated by
    generateShareCard() via the canvas API, but this hidden element keeps the markup in one place
    and lets the structure be inspected/edited.
    <div id="share-card" class="share-card" x-show="false" aria-hidden="true">
      <div class="share-card__inner">
        <header class="share-card__header">
          <span class="share-card__logo">Gym Empire</span>
          <span class="share-card__date" x-text="formatShareDate(session?.date)"></span>
        </header>
        <h2 class="share-card__title" x-text="session?.name"></h2>
        <div class="share-card__stats">
          <div class="share-card__stat">
            <span class="share-card__stat-value" x-text="session?.exercises?.length || 0"></span>
            <span class="share-card__stat-label">{L.detail.exercises}</span>
          </div>
          <div class="share-card__stat">
            <span class="share-card__stat-value" x-text="totalSets"></span>
            <span class="share-card__stat-label">{L.detail.sets}</span>
          </div>
          <div class="share-card__stat">
            <span class="share-card__stat-value" x-text="formatVolume(sessionTotalVolume)"></span>
            <span class="share-card__stat-label">{L.sessions.volume}</span>
          </div>
        </div>
        <div class="share-card__exercises">
          <template x-for="ex in session?.exercises || []" :key="ex.exerciseId">
            <div class="share-card__exercise">
              <span x-text="trExercise(ex.name)"></span>
              <span x-text="`${ex.sets.length} ${ex.sets.length > 1 ? labels.setPlural : labels.setSingular}`"></span>
            </div>
          </template>
        </div>
        <div class="share-card__footer">{L.detail.shareFooter}</div>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import {
    createSessionDetailApp,
    buildSessionDetailLabels,
  } from '../../components/session-detail/sessionDetailApp';
  import { t, localizedPath, trExercise } from '../../i18n';

  const LABELS = t();

  type DialogWindow = Window & {
    openDialog?: (id: string) => void;
    closeDialog?: (id: string) => void;
  };

  const register = () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;
    const dialogs = window as DialogWindow;
    const labels = buildSessionDetailLabels(LABELS);
    labels.printHref = localizedPath('/sessions/print');

    Alpine.data('sessionDetailApp', () =>
      createSessionDetailApp({
        labels,
        search: window.location.search,
        localizedPath,
        ui: {
          notify: (message, kind) => window.showToast(message, kind),
          openDialog: (id) => dialogs.openDialog?.(id),
          closeDialog: (id) => dialogs.closeDialog?.(id),
          navigate: (href) => {
            window.location.href = href;
          },
          translateExercise: (name) => trExercise(name),
        },
      })
    );
  };

  document.addEventListener('alpine:init', register);
  if ((window as any).Alpine) register();
</script>

<style is:global>
  /* ── Layout ── */
  .detail {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 9.6rem;
  }

  .detail__content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ── Header ── */
  .detail__header {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .detail__header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .detail__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text);
    letter-spacing: -0.01em;
    word-break: break-word;
    margin: 0;
  }

  .detail__date {
    color: var(--color-muted);
    font-size: 1.3rem;
    text-transform: capitalize;
  }

  /* ── Status section ── */
  .detail__status-section {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .detail__status-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    line-height: 1;
  }

  .detail__status-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

  @media (min-width: 480px) {
    .detail__status-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Stats grid ── */
  .detail__stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  @media (min-width: 640px) {
    .detail__stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .detail__status-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 4.4rem;
    padding: 0 1.2rem;
    background-color: var(--color-surface);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .detail__status-btn:hover:not(.is-active) {
    background-color: var(--color-surface-2);
    color: var(--color-text);
    border-color: var(--alpha-border);
  }

  .detail__status-btn:active {
    transform: scale(0.98);
  }

  .detail__status-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .detail__status-btn.is-active {
    cursor: default;
  }

  .detail__status-btn:has(.detail__status-dot--planned).is-active {
    background-color: var(--alpha-bg-soft);
    color: var(--color-text);
    border-color: var(--alpha-border);
  }

  .detail__status-btn:has(.detail__status-dot--in-progress).is-active {
    background-color: color-mix(in srgb, var(--color-info) 12%, transparent);
    color: var(--color-info);
    border-color: color-mix(in srgb, var(--color-info) 40%, transparent);
  }

  .detail__status-btn:has(.detail__status-dot--completed).is-active {
    background-color: color-mix(in srgb, var(--color-success) 12%, transparent);
    color: var(--color-success);
    border-color: color-mix(in srgb, var(--color-success) 40%, transparent);
  }

  .detail__status-dot {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    flex-shrink: 0;
    background-color: var(--color-muted);
    box-shadow: 0 0 0 2px var(--color-surface-2);
  }

  .detail__status-dot--planned {
    background-color: var(--color-muted);
  }

  .detail__status-dot--in-progress {
    background-color: var(--color-info);
  }

  .detail__status-dot--completed {
    background-color: var(--color-success);
  }

  .detail__stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.8rem 2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .detail__stat-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
  }

  .detail__stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background-color: var(--alpha-bg-subtle);
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .detail__stat-icon svg {
    display: block;
    width: 1.6rem;
    height: 1.6rem;
  }

  .detail__stat-value {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .detail__stat--volume .detail__stat-icon {
    background-color: var(--color-stat-volume-bg);
    color: var(--color-stat-volume);
  }

  .detail__stat--volume .detail__stat-value {
    color: var(--color-stat-volume);
  }

  .detail__actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .detail__actions > .button {
    min-height: 4.4rem;
  }

  .detail__sheet {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    padding: 1.2rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin: 0.2rem 0;
  }

  .detail__sheet-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    margin-right: 0.4rem;
  }

  .detail__section-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-muted);
    margin: 0;
  }

  .detail__exercises {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .detail__no-exercises {
    text-align: center;
    color: var(--color-muted);
    font-size: 1.3rem;
    padding: 2rem 0;
  }

  .detail__confirm-text {
    color: var(--color-text);
    font-size: 1.3rem;
    line-height: 1.5;
  }

  .detail__confirm-text strong {
    color: var(--color-accent);
    font-weight: 700;
  }

  .exo-row {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .exo-row__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .exo-row__name {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }

  /* ── Superset group badge + row tint ── */
  .exo-row__superset {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.8rem;
    padding: 0 1.1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .exo-row__superset svg {
    width: 1.3rem;
    height: 1.3rem;
    flex-shrink: 0;
  }

  .exo-row__superset--g1 {
    background-color: var(--color-superset-g1-bg);
    color: var(--color-superset-g1);
    border-color: color-mix(in srgb, var(--color-superset-g1) 30%, transparent);
  }
  .exo-row__superset--g2 {
    background-color: var(--color-superset-g2-bg);
    color: var(--color-superset-g2);
    border-color: color-mix(in srgb, var(--color-superset-g2) 30%, transparent);
  }
  .exo-row__superset--g3 {
    background-color: var(--color-superset-g3-bg);
    color: var(--color-superset-g3);
    border-color: color-mix(in srgb, var(--color-superset-g3) 30%, transparent);
  }
  .exo-row__superset--g4 {
    background-color: var(--color-superset-g4-bg);
    color: var(--color-superset-g4);
    border-color: color-mix(in srgb, var(--color-superset-g4) 30%, transparent);
  }
  .exo-row__superset--g5 {
    background-color: var(--color-superset-g5-bg);
    color: var(--color-superset-g5);
    border-color: color-mix(in srgb, var(--color-superset-g5) 30%, transparent);
  }

  .exo-row--g1 {
    background-color: color-mix(in srgb, var(--color-superset-g1) 6%, transparent);
  }
  .exo-row--g2 {
    background-color: color-mix(in srgb, var(--color-superset-g2) 6%, transparent);
  }
  .exo-row--g3 {
    background-color: color-mix(in srgb, var(--color-superset-g3) 6%, transparent);
  }
  .exo-row--g4 {
    background-color: color-mix(in srgb, var(--color-superset-g4) 6%, transparent);
  }
  .exo-row--g5 {
    background-color: color-mix(in srgb, var(--color-superset-g5) 6%, transparent);
  }

  /* ── Per-exercise header actions ── */
  .exo-row__head-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  /* ── Per-exercise stats ── */
  .exo-row__stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 0.4rem 0 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .exo-row__stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .exo-row__stat-label {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
  }

  .exo-row__stat-value {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .exo-row__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.3rem;
  }

  .exo-row__table thead th {
    background-color: var(--color-surface-3);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-align: left;
    padding: 1.2rem 1.4rem;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .exo-row__th-end {
    text-align: right !important;
  }

  .exo-row__table tbody td {
    padding: 1rem 1.4rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .exo-row__table tbody tr:last-child td {
    border-bottom: none;
  }

  .exo-row__table tbody tr:nth-child(even) {
    background-color: var(--color-surface-2);
  }

  .exo-row__tr.is-completed {
    color: var(--color-text);
  }

  .exo-row__num {
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .exo-row__weight,
  .exo-row__reps {
    color: var(--color-text);
    font-size: 1.4rem;
  }

  .exo-row__rpe {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .exo-row__rpe--easy {
    color: var(--color-success);
  }
  .exo-row__rpe--moderate {
    color: var(--color-warning);
  }
  .exo-row__rpe--hard {
    color: var(--color-accent);
  }
  .exo-row__rpe--max {
    color: var(--color-destructive);
  }
  .exo-row__rpe--none {
    color: var(--color-muted);
  }

  .exo-row__td-end {
    text-align: right;
  }

  /* ── Check / dash ── */
  .exo-row__check {
    color: var(--color-success);
    display: inline-block;
    vertical-align: middle;
  }
  .exo-row__check svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .exo-row__dash {
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .exo-row__no-sets {
    color: var(--color-muted);
    font-size: 1.3rem;
    text-align: center;
    padding: 1.6rem 0 0.4rem;
  }

  .detail__suggestion {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .suggestion {
    display: flex;
    align-items: flex-start;
    gap: 1.4rem;
    padding: 1.8rem 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-2);
  }

  .suggestion--up {
    background-color: color-mix(in srgb, var(--color-success) 8%, var(--color-surface-2));
    border-color: color-mix(in srgb, var(--color-success) 40%, transparent);
  }

  .suggestion--maintain {
    background-color: var(--alpha-bg-subtle);
    border-color: var(--color-border);
  }

  .suggestion--down {
    background-color: color-mix(in srgb, var(--color-warning) 8%, var(--color-surface-2));
    border-color: color-mix(in srgb, var(--color-warning) 40%, transparent);
  }

  .suggestion__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 50%;
    background-color: var(--alpha-bg-soft);
    color: var(--color-muted);
  }

  .suggestion--up .suggestion__icon {
    color: var(--color-success);
    background-color: color-mix(in srgb, var(--color-success) 15%, transparent);
  }

  .suggestion--maintain .suggestion__icon {
    color: var(--color-muted);
    background-color: var(--alpha-bg-soft);
  }

  .suggestion--down .suggestion__icon {
    color: var(--color-warning);
    background-color: color-mix(in srgb, var(--color-warning) 15%, transparent);
  }

  .suggestion__icon svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .suggestion__body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .suggestion__headline {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }

  .suggestion--up .suggestion__headline {
    color: var(--color-success);
  }

  .suggestion--maintain .suggestion__headline {
    color: var(--color-muted);
  }

  .suggestion--down .suggestion__headline {
    color: var(--color-warning);
  }

  .suggestion__detail {
    color: var(--color-text);
    font-size: 1.3rem;
    line-height: 1.5;
    margin: 0;
  }

  .suggestion__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: 1.2rem;
  }

  .suggestion__meta strong {
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .detail__notes {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

