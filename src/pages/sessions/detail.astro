---
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Dialog from '../../components/ui/Dialog.astro';
import Icon from '../../components/ui/Icon.astro';
import { t, localizedPath } from '../../i18n';
import BackLink from '../../components/ui/BackLink.astro';
import DialogFooter from '../../components/ui/DialogFooter.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import SessionHeader from '../../components/session-detail/SessionHeader.astro';
import StatusSection from '../../components/session-detail/StatusSection.astro';
import StatsGrid from '../../components/session-detail/StatsGrid.astro';
import SessionActions from '../../components/session-detail/SessionActions.astro';
import NotesSection from '../../components/session-detail/NotesSection.astro';
import ExerciseList from '../../components/session-detail/ExerciseList.astro';

const L = t();
---

<AppLayout title={L.detail.title}>
  <div class="detail" x-data="sessionDetailApp()" x-init="init()" x-cloak>
    {/* ── Back link ── */}
    <BackLink href={localizedPath('/sessions')} label={L.detail.backToSessions} />
    <template x-if="notFound">
      <EmptyState
        variant="error"
        title={L.detail.notFound}
        description={L.detail.notFoundDesc}
        actionLabel={L.detail.viewAllSessions}
        actionHref={localizedPath('/sessions')}
      />
    </template>
    {/* ── Loaded session ── */}
    <template x-if="!notFound && session">
      <div class="detail__content">
        <SessionHeader />
        <StatusSection />
        <StatsGrid />
        <SessionActions />

        {/* RPE-based progression suggestions */}
        <template x-if="session.status === 'completed' && rpeSuggestion">
          <section class="detail__suggestion">
            <h2 class="detail__section-title" x-text="labels.suggestionTitle"></h2>
            <Card>
              <div class="suggestion" :class="'suggestion--' + rpeSuggestion.tone">
                <div class="suggestion__icon" aria-hidden="true">
                  <Icon name="sun" size={20} />
                </div>
                <div class="suggestion__body">
                  <div class="suggestion__headline" x-text="rpeSuggestion.headline"></div>
                  <p class="suggestion__detail" x-text="rpeSuggestion.detail"></p>
                  <div class="suggestion__meta">
                    <span>
                      <span x-text="labels.rpeAvg"></span>
                      <strong x-text="formatRpe(rpeStats.avg)"></strong>/10
                    </span>
                    <span>
                      <span x-text="labels.rpeMax"></span>
                      <strong x-text="formatRpe(rpeStats.max)"></strong>/10
                    </span>
                    <span>
                      <span x-text="labels.setsAnalyzed"></span>
                      <strong x-text="rpeStats.count"></strong>
                    </span>
                  </div>
                </div>
              </div>
            </Card>
          </section>
        </template>

        <NotesSection />
        <ExerciseList />
      </div>
    </template>
    <Dialog id="delete-session-dialog" title={L.detail.confirmDelete}>
      <p class="detail__confirm-text">
        {L.detail.confirmDeleteIntro}
        <strong x-text="session ? session.name : '{L.detail.thisSession}'"></strong>.
        {L.detail.irreversible}
      </p>

      <div slot="footer">
        <DialogFooter
          cancelLabel={L.common.cancel}
          confirmLabel={L.detail.deletePermanently}
          confirmClick="confirmDelete"
        />
      </div>
    </Dialog>
    HIDDEN SHARE CARD DOM reference for the shareable image. The actual PNG is generated by
    generateShareCard() via the canvas API, but this hidden element keeps the markup in one place
    and lets the structure be inspected/edited.
    <div id="share-card" class="share-card" x-show="false" aria-hidden="true">
      <div class="share-card__inner">
        <header class="share-card__header">
          <span class="share-card__logo">Gym Empire</span>
          <span class="share-card__date" x-text="formatShareDate(session?.date)"></span>
        </header>
        <h2 class="share-card__title" x-text="session?.name"></h2>
        <div class="share-card__stats">
          <div class="share-card__stat">
            <span class="share-card__stat-value" x-text="session?.exercises?.length || 0"></span>
            <span class="share-card__stat-label">{L.detail.exercises}</span>
          </div>
          <div class="share-card__stat">
            <span class="share-card__stat-value" x-text="totalSets"></span>
            <span class="share-card__stat-label">{L.detail.sets}</span>
          </div>
          <div class="share-card__stat">
            <span class="share-card__stat-value" x-text="formatVolume(sessionTotalVolume)"></span>
            <span class="share-card__stat-label">{L.sessions.volume}</span>
          </div>
        </div>
        <div class="share-card__exercises">
          <template x-for="ex in session?.exercises || []" :key="ex.exerciseId">
            <div class="share-card__exercise">
              <span x-text="trExercise(ex.name)"></span>
              <span x-text="`${ex.sets.length} ${ex.sets.length > 1 ? labels.setPlural : labels.setSingular}`"></span>
            </div>
          </template>
        </div>
        <div class="share-card__footer">{L.detail.shareFooter}</div>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import { singleton as uiStore } from '../../lib/ui-store';
  import { registerAlpine } from '../../lib/alpine';
  import {
    createSessionDetailApp,
    buildSessionDetailLabels,
  } from '../../components/session-detail/sessionDetailApp';
  import { t, localizedPath, trExercise } from '../../i18n';

  const LABELS = t();
  const labels = buildSessionDetailLabels(LABELS);
  labels.printHref = localizedPath('/sessions/print');
  registerAlpine('sessionDetailApp', () =>
    createSessionDetailApp({
      labels,
      search: window.location.search,
      localizedPath,
      ui: {
        notify: (message, kind) => uiStore.notify(message, kind),
        openDialog: (id) => uiStore.openDialog(id),
        closeDialog: (id) => uiStore.closeDialog(id),
        navigate: (href) => {
          window.location.href = href;
        },
        translateExercise: (name) => trExercise(name),
      },
    })
  );
</script>

<style>
  /* ── Layout ── */
  .detail {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 9.6rem;
  }

  .detail__content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .detail__date {
    color: var(--color-muted);
    font-size: 1.3rem;
    text-transform: capitalize;
  }

  .detail__section-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-muted);
    margin: 0;
  }

  .detail__exercises {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .detail__no-exercises {
    text-align: center;
    color: var(--color-muted);
    font-size: 1.3rem;
    padding: 2rem 0;
  }

  .detail__suggestion {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .detail__notes {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .share-card {
    position: absolute;
    top: 0;
    left: -9999px;
    width: 1080px;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    border-radius: var(--radius-xl);
    padding: 8rem 7rem;
    pointer-events: none;
  }

  .share-card__inner {
    display: flex;
    flex-direction: column;
    gap: 3.6rem;
    min-height: 920px;
  }

  .share-card__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1.6rem;
    border-bottom: 2px solid var(--color-accent);
  }

  .share-card__logo {
    font-family: var(--font-display);
    font-size: 4.2rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .share-card__date {
    font-size: 2.4rem;
    color: var(--color-muted);
    text-transform: capitalize;
  }

  .share-card__title {
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .share-card__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }

  .share-card__stat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 2rem 2.2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .share-card__stat-value {
    font-family: var(--font-display);
    font-size: 4.8rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .share-card__stat-label {
    font-size: 1.6rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }

  .share-card__exercises {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .share-card__exercise {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    font-size: 2.6rem;
    color: var(--color-text);
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--alpha-bg-subtle);
  }

  .share-card__exercise span:last-child {
    color: var(--color-muted);
    font-size: 2.2rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .share-card__footer {
    margin-top: auto;
    padding-top: 2rem;
    text-align: center;
    color: var(--color-muted);
    font-size: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 600;
  }
</style>
