---
import '../../styles/components/compare-page.css';

import { resolveLocale } from '../../i18n';

import { t, localizedPath } from '../../i18n';
import CompareSummary from '../../components/sessions/CompareSummary.astro';
import CompareSessionColumn from '../../components/sessions/CompareSessionColumn.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Icon from '../../components/ui/Icon.astro';
import BackLink from '../../components/ui/BackLink.astro';
const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
---

<AppLayout title={L.comparer.title}>
  <div class="comp" x-data="comparisonApp()" x-init="init()" x-cloak>
    <PageHeader title={L.comparer.title} description={L.comparer.description} />
    <BackLink href={localizedPath('/sessions', locale)} label={L.comparer.back} />
    SESSION PICKERS
    <Card>
      <CardHeader>
        <CardTitle>{L.comparer.selection}</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="comp__pickers">
          <div class="comp__picker-field">
            <label for="comp-s1" class="comp__picker-label">
              {L.comparer.session1Ref}
            </label>
            <div class="comp__picker-wrap">
              <Icon name="dumbbellBox" size={18} />
              <select
                class="comp__select"
                x-model="session1Id"
                @change="onSession1Change($event.target.value)"
                :aria-label="'{L.comparer.pickFirst}'"
              >
                <option value="">{L.comparer.chooseSession}</option>
                <template x-for="s in allSessions" :key="s.id">
                  <option
                    :value="s.id"
                    :disabled="s.id === session2Id"
                    x-text="formatOption(s)"
                  ></option>
                </template>
              </select>
            </div>
          </div>

          <div class="comp__vs" aria-hidden="true">
            <span class="comp__vs-badge">{L.comparer.vs}</span>
          </div>

          <div class="comp__picker-field">
            <label for="comp-s2" class="comp__picker-label">
              {L.comparer.session2}
            </label>
            <div class="comp__picker-wrap">
              <Icon name="dumbbellBox" size={18} />
              <select
                id="comp-s2"
                class="comp__select"
                x-model="session2Id"
                @change="onSession2Change($event.target.value)"
                :aria-label="'{L.comparer.pickSecond}'"
              >
                <option value="">{L.comparer.chooseSession}</option>
                <template x-for="s in allSessions" :key="s.id">
                  <option
                    :value="s.id"
                    :disabled="s.id === session1Id"
                    x-text="formatOption(s)"
                  ></option>
                </template>
              </select>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>
    <template x-if="allSessions.length < 2">
      <Card>
        <div class="comp__hint">
          <div class="comp__hint-icon" aria-hidden="true">
            <Icon name="infoCircle" size={18} />
          </div>
          <p>
            {L.comparer.needTwo}
            <a href={localizedPath('/sessions/create', locale)} class="comp__hint-link">
              {L.comparer.createSession}
            </a>
          </p>
        </div>
      </Card>
    </template>
    <template x-if="allSessions.length >= 2 && (!session1 || !session2)">
      <Card>
        <div class="comp__hint">
          <div class="comp__hint-icon" aria-hidden="true">
            <Icon name="trendingUpLine" size={18} />
          </div>
          <p>{L.comparer.selectBoth}</p>
        </div>
      </Card>
    </template>
    COMPARISON COLUMNS
    <template x-if="session1 && session2">
      <div class="comp__results">
        <CompareSummary />

        {/* ── Per-session columns ── */}
        <div class="comp__columns">
          <CompareSessionColumn
            expr="session1"
            exExpr="session1Ex"
            badge={L.comparer.session1Ref}
            ariaLabel={L.comparer.detailsAria1}
          />
          <CompareSessionColumn
            expr="session2"
            exExpr="session2Ex"
            badge={L.comparer.session2}
            ariaLabel={L.comparer.detailsAria2}
            accent
          />
        </div>
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import { registerCompare } from '../../components/sessions/compareRegistration.ts';

  registerCompare();
</script>
