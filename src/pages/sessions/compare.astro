---
import { t, localizedPath } from '../../i18n';
import CompareSummary from '../../components/sessions/CompareSummary.astro';
import CompareSessionColumn from '../../components/sessions/CompareSessionColumn.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import CardHeader from '../../components/ui/CardHeader.astro';
import CardTitle from '../../components/ui/CardTitle.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Icon from '../../components/ui/Icon.astro';
import BackLink from '../../components/ui/BackLink.astro';
const L = t();
---

<AppLayout title={L.comparer.title}>
  <div class="comp" x-data="comparisonApp()" x-init="init()" x-cloak>
    <PageHeader title={L.comparer.title} description={L.comparer.description} />
    <BackLink href={localizedPath('/sessions')} label={L.comparer.back} />
    SESSION PICKERS
    <Card>
      <CardHeader>
        <CardTitle>{L.comparer.selection}</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="comp__pickers">
          <div class="comp__picker-field">
            <label for="comp-s1" class="comp__picker-label">
              {L.comparer.session1Ref}
            </label>
            <div class="comp__picker-wrap">
              <Icon name="dumbbellBox" size={18} />
              <select
                class="comp__select"
                x-model="session1Id"
                @change="onSession1Change($event.target.value)"
                :aria-label="'{L.comparer.pickFirst}'"
              >
                <option value="">{L.comparer.chooseSession}</option>
                <template x-for="s in allSessions" :key="s.id">
                  <option
                    :value="s.id"
                    :disabled="s.id === session2Id"
                    x-text="formatOption(s)"
                  ></option>
                </template>
              </select>
            </div>
          </div>

          <div class="comp__vs" aria-hidden="true">
            <span class="comp__vs-badge">{L.comparer.vs}</span>
          </div>

          <div class="comp__picker-field">
            <label for="comp-s2" class="comp__picker-label">
              {L.comparer.session2}
            </label>
            <div class="comp__picker-wrap">
              <Icon name="dumbbellBox" size={18} />
              <select
                id="comp-s2"
                class="comp__select"
                x-model="session2Id"
                @change="onSession2Change($event.target.value)"
                :aria-label="'{L.comparer.pickSecond}'"
              >
                <option value="">{L.comparer.chooseSession}</option>
                <template x-for="s in allSessions" :key="s.id">
                  <option
                    :value="s.id"
                    :disabled="s.id === session1Id"
                    x-text="formatOption(s)"
                  ></option>
                </template>
              </select>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>
    HINT — show "select both" message
    <template x-if="allSessions.length < 2">
      <Card>
        <div class="comp__hint">
          <div class="comp__hint-icon" aria-hidden="true">
            <Icon name="infoCircle" size={18} />
          </div>
          <p>
            {L.comparer.needTwo}
            <a href={localizedPath('/sessions/create')} class="comp__hint-link">
              {L.comparer.createSession}
            </a>
          </p>
        </div>
      </Card>
    </template>
    <template x-if="allSessions.length >= 2 && (!session1 || !session2)">
      <Card>
        <div class="comp__hint">
          <div class="comp__hint-icon" aria-hidden="true">
            <Icon name="trendingUpLine" size={18} />
          </div>
          <p>{L.comparer.selectBoth}</p>
        </div>
      </Card>
    </template>
    COMPARISON COLUMNS
    <template x-if="session1 && session2">
      <div class="comp__results">
        <CompareSummary />

        {/* ── Per-session columns ── */}
        <div class="comp__columns">
          <CompareSessionColumn
            expr="session1"
            exExpr="session1Ex"
            badge={L.comparer.session1Ref}
            ariaLabel={L.comparer.detailsAria1}
          />
          <CompareSessionColumn
            expr="session2"
            exExpr="session2Ex"
            badge={L.comparer.session2}
            ariaLabel={L.comparer.detailsAria2}
            accent
          />
        </div>
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import { registerAlpine } from '../../lib/alpine';
  import { createComparisonApp } from '../../components/sessions/compareApp';
  import { t } from '../../i18n';

  const LABELS = t();

  registerAlpine('comparisonApp', () =>
    createComparisonApp({
      search: window.location.search,
      pathname: window.location.pathname,
      labels: {
        comparer: LABELS.comparer,
        rapide: LABELS.rapide,
        status: {
          completed: LABELS.comparer.completed,
          inProgress: LABELS.comparer.inProgress,
          planned: LABELS.comparer.planned,
        },
      },
      ui: {
        replaceUrl: (url) => window.history.replaceState({}, '', url),
      },
    })
  );
</script>

<style>
  .comp {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-5);
    padding-bottom: 6rem;
  }

  /* ── Pickers ── */
  .comp__pickers {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3);
    align-items: end;
  }

  .comp__picker-field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    min-width: 0;
  }

  .comp__picker-label {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    line-height: 1.2;
  }

  .comp__picker-wrap {
    position: relative;
  }

  .comp__vs {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.8rem;
    align-self: end;
  }

  .comp__vs-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.8rem;
    height: 4.8rem;
    padding: 0 1.4rem;
    border-radius: 9999px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-accent) 18%, transparent),
      color-mix(in srgb, var(--color-accent) 5%, transparent)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  /* ── Hint ── */
  .comp__hint {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-4);
    color: var(--color-muted);
    font-size: 1.3rem;
    line-height: 1.5;
  }

  .comp__hint-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
  }

  .comp__hint-link {
    color: var(--color-accent);
    font-weight: 700;
    margin-left: 0.4rem;
  }

  .comp__hint-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  /* ── Results ── */
  .comp__results {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-5);
  }

  .comp__rotate-180 {
    display: inline-flex;
    transform: rotate(180deg);
  }

  /* ── Session columns ── */
  .comp__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-5);
  }

  .comp__stat-label {
    font-size: 1.05rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .comp__stat-value {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  /* ── Exercises ── */
  .comp__exercises {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .comp__no-exercises {
    text-align: center;
    color: var(--color-muted);
    font-size: 1.3rem;
    padding: var(--spacing-4) 0;
  }

  @media (min-width: 960px) {
    .comp__columns {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ── Wider page for side-by-side comparison ── */
  :global(.page-content) {
    max-width: 140rem;
  }
</style>
