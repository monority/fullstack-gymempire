---
import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import IconButton from '../../components/ui/IconButton.astro';
import Segmented from '../../components/ui/Segmented.astro';
import Select from '../../components/ui/Select.astro';
import { icons } from '../../lib/icons';
const L = t();
---

<AppLayout title={L.rapide.title}>
  <div class="quick" x-data="quickSessionApp()" x-init="init()" x-cloak>
    {/* --- Top bar (working + resting) --- */}
    <template x-if="state === 'working' || state === 'resting'">
      <header class="quick__header">
        <IconButton
          variant="ghost"
          icon={icons.arrowLeft(24, 24)}
          label={L.rapide.quitAria}
          @click="stopSession()"
        />

        <div class="quick__progress-center">
          <span class="quick__progress-text" aria-live="polite" aria-atomic="true">
            {L.rapide.setProgress}
            <strong class="quick__progress-value" x-text="currentSetIndex + 1"></strong>/
            <span x-text="currentExercise?.sets?.length || 0"></span>
            <span class="quick__separator">·</span>
            {L.rapide.exerciseProgress}
            <strong class="quick__progress-value" x-text="currentExerciseIndex + 1"></strong>/
            <span x-text="totalExercises"></span>
          </span>
          <div
            class="quick__progress-bar"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label={L.rapide.setProgress}
            :aria-valuenow="progressPercent"
          >
            <div class="quick__progress-fill" :style="`width: ${progressPercent}%`"></div>
          </div>
        </div>

        <IconButton
          variant="accent"
          icon={icons.check(24, 24)}
          label={L.rapide.finish}
          title={L.rapide.finish}
          @click="confirmStop()"
        />
      </header>
    </template>

    {/* --- STATE 1 — Selecting --- */}
    <template x-if="state === 'selecting'">
      <section class="quick__selecting">
        <div class="quick__selecting-inner">
          <div class="quick__zap-icon" aria-hidden="true">
            <Fragment set:html={icons.zap(64, 64)} />
          </div>
          <h1 class="quick__title">{L.rapide.title}</h1>
          <p class="quick__intro">{L.rapide.introText}</p>

          <div class="quick__form">
            <label class="quick__label" for="qs-session">
              {L.rapide.session}
            </label>
            <select id="qs-session" class="quick__select" x-model="selectedSessionId">
              <option value="">{L.rapide.selectSession}</option>
              <template x-for="s in availableSessions" :key="s.id">
                <option
                  :value="s.id"
                  x-text="`${s.label} (${s.totalSets} ${setsShortLabel} · ${formatWeightValue(s.totalVolume)})`"
                ></option>
              </template>
            </select>
          </div>

          <div class="quick__selecting-actions">
            <Button variant="ghost" href={localizedPath('/sessions')}>
              {L.common.back}
            </Button>
            <Button variant="primary" :disabled="!selectedSessionId" @click="startSession()">
              {L.rapide.start}
            </Button>
          </div>

          <template x-if="availableSessions.length === 0">
            <p class="quick__empty-text">
              {L.rapide.emptyDesc}{' '}
              <a class="quick__empty-link" href={localizedPath('/sessions/create')}>
                {L.rapide.restart}
              </a>
              .
            </p>
          </template>
        </div>
      </section>
    </template>

    {/* --- STATE 2 — Working --- */}
    <template x-if="state === 'working' && currentSet">
      <section
        class="quick__working"
        @touchstart="onTouchStart($event)"
        @touchend="onTouchEnd($event)"
      >
        <div class="quick__working-inner">
          <div
            class="quick__exercise-name"
            x-text="trExercise(currentExercise?.name)"
            aria-live="polite"
            aria-atomic="true"
          ></div>
          <div class="quick__muscle" x-text="trMuscle(currentExercise?.muscle)"></div>

          <div class="quick__set-info" aria-live="polite" aria-atomic="true">
            {L.rapide.setProgress}
            <span x-text="currentSet.setNumber"></span>
            <span
              class="quick__set-type"
              :class="'tone--' + currentSet.type"
              x-text="typeLabel(currentSet.type)"
            ></span>
          </div>

          <div class="quick__values">
            <div class="quick__value-col">
              <span
                class="quick__value-number"
                x-text="formatWeightValue(currentSet.weight)"
              ></span>
              <span class="quick__value-unit" x-text="weightUnit()"></span>
            </div>
            <div class="quick__x-separator" aria-hidden="true">
              ×
            </div>
            <div class="quick__value-col">
              <span class="quick__value-number" x-text="currentSet.reps"></span>
              <span class="quick__value-unit">{L.rapide.repsUnit}</span>
            </div>
          </div>

          <div class="quick__rpe-control">
            <span class="quick__label">{L.rapide.rpeLabel}</span>
            <Segmented
              items={[
                { value: 'rpe', label: 'RPE' },
                { value: 'urpe', label: 'uRPE' },
              ]}
              model="currentRpeType"
              ariaLabel={L.rapide.rpeTypeLabel}
            />
            <Select
              class="quick__rpe-select"
              aria-label={L.rapide.rpeLabel}
              x-model.number="currentRpe"
            >
              <option value="">{L.rapide.rpeUnset}</option>
              <template x-for="value in rpeValues" :key="value">
                <option :value="value" x-text="value"></option>
              </template>
            </Select>
          </div>

          <Button
            variant="primary"
            class="quick__done-btn"
            @click="completeSet()"
            aria-label={L.rapide.completeSetAria}
          >
            <Fragment set:html={icons.check(24, 24)} />
            <span>{L.rapide.done}</span>
          </Button>

          <Button
            variant="ghost"
            class="quick__undo-working"
            :disabled="!canUndo"
            @click="undoLastSet()"
          >
            <Fragment set:html={icons.undo(18, 18)} />
            <span>{L.rapide.undoLast}</span>
          </Button>

          <div class="quick__nav-grid">
            <button
              type="button"
              class="quick__nav-btn"
              :disabled="!canGoPrev()"
              @click="prevSet()"
              aria-label={L.rapide.prevSetAria}
            >
              <Fragment set:html={icons.chevronLeft(20, 20)} />
              <span>{L.rapide.prev}</span>
            </button>
            <button
              type="button"
              class="quick__nav-btn"
              :disabled="!canGoNext()"
              @click="nextSet()"
              aria-label={L.rapide.nextSetAria}
            >
              <span>{L.rapide.next}</span>
              <Fragment set:html={icons.chevronRight(20, 20)} />
            </button>
          </div>
        </div>
      </section>
    </template>

    {/* --- STATE 3 — Resting --- */}
    <template x-if="state === 'resting'">
      <section class="quick__resting">
        <div class="quick__resting-inner">
          <div class="quick__recorded-label" role="status" aria-live="polite">
            {L.rapide.setRecorded}
          </div>
          <div class="quick__resting-title">{L.rapide.resting}</div>
          <div
            class="quick__resting-timer"
            role="timer"
            aria-live="off"
            :class="{ 'quick__resting-timer--low': restRemaining <= 10 && restRemaining > 0 }"
            x-text="formatRestTime()"
          ></div>
          <div
            class="quick__rest-next"
            x-text="restNextLabel()"
            aria-live="polite"
            aria-atomic="true"
          ></div>

          <div class="quick__resting-grid">
            <Button variant="ghost" @click="addRestTime(-15)" aria-label={L.rapide.restMinusAria}>
              -15s
            </Button>
            <Button
              variant="ghost"
              active={true}
              @click="skipRest()"
              aria-label={L.rapide.skipRest}
            >
              {L.common.skip}
            </Button>
            <Button variant="ghost" @click="addRestTime(15)" aria-label={L.rapide.restPlusAria}>
              +15s
            </Button>
            <Button variant="ghost" class="quick__undo" :disabled="!canUndo" @click="undoLastSet()">
              {L.rapide.undoLast}
            </Button>
          </div>
        </div>
      </section>
    </template>

    {/* --- STATE 4 — Completed --- */}
    <template x-if="state === 'completed'">
      <section class="quick__completed">
        <div class="quick__completed-inner">
          <div
            class="quick__done-icon"
            :class="{ 'quick__done-icon--partial': recordedSets < totalSets }"
            aria-hidden="true"
          >
            <Fragment set:html={icons.checkCircle(80, 80)} />
          </div>
          <h1 class="quick__done-title" x-text="completionTitle"></h1>
          <p class="quick__done-name" x-text="session?.name"></p>
          <p class="quick__done-message" x-text="completionMessage" role="status"></p>

          <div class="quick__stats">
            <div class="quick__stat-card">
              <div class="quick__stat-value" x-text="`${recordedSets} / ${totalSets}`"></div>
              <div class="quick__stat-label">{L.rapide.setsDone}</div>
            </div>
            <div class="quick__stat-card">
              <div
                class="quick__stat-value"
                x-text="`${completedExercises} / ${totalExercises}`"
              ></div>
              <div class="quick__stat-label">{L.rapide.exercises}</div>
            </div>
            <div class="quick__stat-card">
              <div class="quick__stat-value" x-text="formatDuration(sessionDuration)"></div>
              <div class="quick__stat-label">{L.rapide.duration}</div>
            </div>
            <div class="quick__stat-card">
              <div class="quick__stat-value" x-text="formatWeightValue(sessionTotalVolume)"></div>
              <div class="quick__stat-label">{L.rapide.volume}</div>
            </div>
          </div>

          <div class="quick__done-actions">
            <Button variant="primary" :href="detailHref(session?.id)">
              {L.rapide.viewSession}
            </Button>
            <Button variant="ghost" :disabled="!canUndo" @click="undoLastSet()">
              {L.rapide.undoLast}
            </Button>
            <Button variant="ghost" @click="reset()">
              {L.rapide.chooseAnother}
            </Button>
          </div>
        </div>
      </section>
    </template>
  </div>
</AppLayout>

<script>
  import { getAlpine } from '../../lib/alpine';
  import { t, localizedPath } from '../../i18n';
  import { getSessions, saveSession, updateSession } from '../../lib/storage/sessions';
  import { getSettings } from '../../lib/storage/settings';
  import { getRestTime } from '../../lib/rest-times';
  import { createQuickSession } from '../../components/sessions/quickSession';

  const LABELS = t();

  document.addEventListener('alpine:init', () => {
    const Alpine = getAlpine();
    if (!Alpine) return;

    Alpine.data('quickSessionApp', () =>
      createQuickSession({
        labels: LABELS.rapide,
        storage: { getSessions, saveSession, updateSession },
        defaultRestSeconds: () => getSettings().defaultRestTime,
        restSecondsFor: (name, fallback) => getRestTime(name, fallback),
        unit: () => getSettings().unit,
        confirm: (message) => window.confirm(message),
        navigate: (href) => (window.location.href = href),
        sessionsHref: localizedPath('/sessions'),
        detailHref: (id) => localizedPath('/sessions/detail?id=' + encodeURIComponent(id || '')),
      })
    );
  });
</script>

<style>
  .quick {
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    font-family: var(--font-body);
    max-width: 96rem;
    margin: 0 auto;
    padding-bottom: 6rem;
  }

  .quick__header {
    flex-shrink: 0;
    display: grid;
    grid-template-columns: 6rem 1fr 6rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--alpha-bg-soft);
  }

  .quick__header :global(.icon-btn) {
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 0;
    background-color: transparent;
    border-color: transparent;
    color: var(--color-text);
  }
  .quick__header :global(.icon-btn:hover) {
    background-color: transparent;
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .quick__progress-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
  }

  .quick__progress-text {
    font-size: 1.4rem;
    display: flex;
    gap: 0.5rem;
    color: var(--color-muted);
    font-weight: 600;
    text-align: center;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .quick__progress-value {
    color: var(--color-text);
    font-weight: 700;
  }

  .quick__separator {
    margin-left: 0.25rem;
    margin-right: 0.25rem;
    opacity: 0.4;
  }

  .quick__progress-bar {
    width: 100%;
    max-width: 28rem;
    height: 0.375rem;
    background-color: var(--color-surface-2);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .quick__progress-fill {
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      color-mix(in srgb, var(--color-accent) 65%, white)
    );
    transition: width 280ms ease;
  }

  .quick__selecting {
    flex: 1 1 0%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overflow-y: auto;
  }

  .quick__selecting-inner {
    width: 100%;
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .quick__zap-icon {
    width: 9.6rem;
    height: 9.6rem;
    border-radius: 0;
    background-color: transparent;
    border: 0;
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .quick__title {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 6vw, 4.8rem);
    font-weight: 700;
    line-height: 1;
    margin: 0;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .quick__intro {
    font-size: 1.5rem;
    color: var(--color-muted);
    line-height: 1.4;
    margin: 0;
    max-width: 38rem;
  }

  .quick__form {
    width: 100%;
    max-width: 44rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
    text-align: left;
  }

  .quick__label {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
  }

  .quick__select {
    width: 100%;
    height: 3.75rem;
    padding: 0 1rem;
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.6rem;
    font-weight: 600;
    cursor: pointer;
    appearance: none;
    transition: all 140ms var(--transition-fast);
  }
  .quick__select:hover {
    background-color: transparent;
    border-color: var(--color-border-strong);
  }
  .quick__select:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .quick__selecting-actions {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    max-width: 44rem;
    margin-top: 0.25rem;
  }

  .quick__empty-text {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 1.4rem;
    line-height: 1.5;
  }

  .quick__empty-link {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .quick__working {
    flex: 1 1 0%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow: hidden;
  }

  .quick__working-inner {
    width: 100%;
    max-width: 60rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .quick__exercise-name {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-text);
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
  }

  .quick__muscle {
    font-size: 1.4rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }

  .quick__set-info {
    font-size: 1.6rem;
    color: var(--color-muted);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .quick__set-type {
    display: inline-flex;
    align-items: center;
    height: 2.6rem;
    padding: 0 0.625rem;
    border-radius: 0;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background-color: transparent;
    border: 1px solid var(--color-border);
  }

  .quick__values {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
    margin: 0.5rem 0;
  }

  .quick__rpe-control {
    display: grid;
    grid-template-columns: auto auto minmax(11rem, 16rem);
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: 100%;
  }

  .quick__rpe-control :global(.seg) {
    min-height: 4.4rem;
  }

  .quick__rpe-control :global(.select-wrapper) {
    width: 100%;
  }

  .quick__rpe-select {
    min-height: 4.4rem;
    font-size: 1.3rem;
  }

  .quick__value-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .quick__value-number {
    font-family: var(--font-display);
    font-size: clamp(5.2rem, 14vw, 9.6rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .quick__value-unit {
    font-family: var(--font-body);
    font-size: 1.6rem;
    color: var(--color-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-top: 0.25rem;
  }

  .quick__x-separator {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 5.6rem);
    color: var(--color-muted);
    font-weight: 300;
    line-height: 1;
  }

  .quick__done-btn {
    width: 100%;
    max-width: 60rem;
    min-height: 5.2rem;
    padding: 0 1.5rem;
    background-color: var(--color-success);
    color: var(--color-success-foreground);
    border: none;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-success) 20%, transparent);
    transition: all 140ms var(--transition-fast);
  }
  .quick__done-btn:hover {
    background-color: color-mix(in srgb, var(--color-success) 90%, white);
  }
  .quick__done-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .quick__done-btn:active {
    transform: scale(0.985);
  }

  .quick__undo-working {
    min-height: 4.4rem;
    font-size: 1.3rem;
    color: var(--color-muted);
  }
  .quick__undo-working:disabled {
    opacity: 0.35;
  }

  .quick__nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    width: 100%;
    max-width: 60rem;
  }

  .quick__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 4.4rem;
    padding: 0 1rem;
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 600;
    cursor: pointer;
    appearance: none;
    transition: all 140ms var(--transition-fast);
  }
  .quick__nav-btn:hover {
    background-color: transparent;
    border-color: var(--color-border-strong);
  }
  .quick__nav-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .quick__nav-btn:active {
    transform: scale(0.98);
  }
  .quick__nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .quick__resting {
    flex: 1 1 0%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .quick__resting-inner {
    width: 100%;
    max-width: 60rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .quick__recorded-label {
    color: var(--color-success);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .quick__resting-title {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 700;
  }

  .quick__resting-timer {
    font-family: var(--font-display);
    font-size: clamp(12rem, 30vw, 24rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-text);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    transition: color 200ms ease;
  }
  .quick__resting-timer--low {
    color: var(--color-warning);
    animation: quick-pulse 1s ease-in-out infinite;
  }
  @keyframes quick-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.04);
    }
  }

  .quick__rest-next {
    font-size: 1.6rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .quick__resting-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr 1fr;
    gap: 0.75rem;
    width: 100%;
    max-width: 50rem;
  }

  .quick__undo {
    grid-column: 1 / -1;
    min-height: 4.4rem;
    font-size: 1.3rem;
