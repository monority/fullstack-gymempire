---
import { t } from '../../i18n';
import QuickHeader from '../../components/sessions/QuickHeader.astro';
import QuickSelecting from '../../components/sessions/QuickSelecting.astro';
import QuickWorking from '../../components/sessions/QuickWorking.astro';
import QuickResting from '../../components/sessions/QuickResting.astro';
import QuickCompleted from '../../components/sessions/QuickCompleted.astro';
import AppLayout from '../../layouts/AppLayout.astro';

const L = t();
---

<AppLayout title={L.rapide.title}>
  <div class="quick" x-data="quickSessionApp()" x-init="init()" x-cloak>
    <QuickHeader />
    <QuickSelecting />
    <QuickWorking />
    <QuickResting />
    <QuickCompleted />
  </div>
</AppLayout>

<script>
  import { registerQuick } from '../../components/sessions/quickRegistration.ts';

  registerQuick();
</script>
