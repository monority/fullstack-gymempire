---
import AppLayout from '../layouts/AppLayout.astro';
import Button from '../components/ui/Button.astro';
import KpiItem from '../components/ui/KpiItem.astro';
import WeeklyGoal from '../components/dashboard/WeeklyGoal.astro';
import NextSession from '../components/dashboard/NextSession.astro';
import VolumeTrend from '../components/dashboard/VolumeTrend.astro';
import RecentSessions from '../components/dashboard/RecentSessions.astro';
import { t, localizedPath } from '../i18n';

const L = t();
---

<AppLayout title={L.dashboard.title}>
  <div class="dash" x-data="dashboardApp()" x-init="init()" x-cloak>
    <header class="dash__header">
      <h1 class="dash__title" x-text="greeting()">
        {L.dashboard.title}
      </h1>
      <a class="dash__header-action" href={localizedPath('/sessions/create')}>
        {L.dashboard.newSession}
      </a>
    </header>

    <div class="dash__state" x-show="isLoading" role="status" aria-live="polite">
      <span class="dash__state-mark" aria-hidden="true"></span>
      <span x-text="labels.loading">{L.dashboard.loading}</span>
    </div>

    <div class="dash__state dash__state--error" x-show="loadError" role="alert">
      <span x-text="labels.loadError">{L.dashboard.loadError}</span>
      <button type="button" class="dash__state-action" x-on:click="retry()" x-text="labels.retry">
        {L.dashboard.retry}
      </button>
    </div>

    <div x-show="!isLoading && !loadError && hasSessions">
      <div class="dash__hero-row">
        <NextSession />
        <WeeklyGoal />
      </div>

      <section class="dash__kpis" aria-label={L.dashboard.kpisAria}>
        <KpiItem
          icon="dumbbell"
          label={L.dashboard.totalVolume}
          valueExpr="formatVolume(kpis.totalVolume)"
          unit={L.common.kg}
          color="var(--color-stat-volume)"
          class="dash__kpi dash__kpi--volume"
        />
        <KpiItem
          icon="calendar"
          label={L.dashboard.totalSessions}
          valueExpr="kpis.totalSessions"
          unitExpr="kpis.totalSessions === 1 ? labels.weeklyMoreSingular : labels.sessionsUnit"
          color="var(--color-stat-sessions)"
          class="dash__kpi dash__kpi--sessions"
        />
        <KpiItem
          icon="award"
          label={L.dashboard.bestPRs}
          valueExpr="kpis.bestPRs"
          unitExpr="kpis.bestPRs === 1 ? labels.exoSingular.trim() : labels.exercisesUnit"
          subExpr="kpis.top1RM > 0 ? labels.top1RM + ' ' + formatVolume(kpis.top1RM) + ' ' + labels.kg : ''"
          color="var(--color-stat-pr)"
          class="dash__kpi dash__kpi--pr"
        />
        <KpiItem
          icon="flame"
          label={L.dashboard.streak}
          valueExpr="kpis.streak"
          unitExpr="kpis.streak === 1 ? labels.daysSingular : labels.daysUnit"
          subExpr="kpis.streak === 0 && kpis.totalSessions > 0 ? labels.noRecent : ''"
          color="var(--color-stat-streak)"
          class="dash__kpi dash__kpi--streak"
        />
      </section>

      <div class="dash__charts">
        <VolumeTrend />
        <RecentSessions />
      </div>
    </div>

    <div class="dash__empty" x-show="!isLoading && !loadError && !hasSessions">
      <h2 class="dash__empty-title">{L.dashboard.emptyTitle}</h2>
      <p class="dash__empty-desc">{L.dashboard.emptyDesc}</p>

      <div class="dash__empty-actions">
        <Button variant="primary" size="md" href={localizedPath('/sessions/create')}>
          <span>{L.dashboard.createFirst}</span>
        </Button>
        <Button variant="secondary" size="md" href={localizedPath('/timer')}>
          <span>{L.dashboard.stopwatch}</span>
        </Button>
        <a href={localizedPath('/exercises')} class="dash__empty-link">
          {L.dashboard.browseExercises}
        </a>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import { createDashboardApp } from '../components/dashboard/dashboardApp';
  import { t, getLocale, localizedPath } from '../i18n';

  const LABELS = t();

  const register = () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('dashboardApp', () =>
      createDashboardApp(
        {
          ...LABELS.dashboard,
          kg: LABELS.common.kg,
          status: {
            completed: LABELS.sessions.completed,
            inProgress: LABELS.sessions.inProgress,
            planned: LABELS.sessions.planned,
          },
        },
        localizedPath,
        {
          locale: () => (getLocale() === 'en' ? 'en' : 'fr'),
          today: () => new Date(),
          onError: (error) => console.error('[dashboard] failed to load', error),
          translateMuscle: (name) =>
            (window as { trMuscle?: (m: string) => string }).trMuscle?.(name) ?? name,
        }
      )
    );
  };

  document.addEventListener('alpine:init', register);
  if ((window as any).Alpine) register();
</script>

<style>
  .dash {
    max-width: 96rem;
    margin: 0 auto;
    padding-bottom: 8rem;
  }

  .dash__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.4rem;
    margin-bottom: 4rem;
  }

  .dash__title {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .dash__header-action {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    padding: 0 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .dash__header-action:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .dash__header-action:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dash__state {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 12rem;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 1.4rem;
  }

  .dash__state-mark {
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-border-strong);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: dash-state-spin 0.8s linear infinite;
  }

  .dash__state--error {
    justify-content: space-between;
    gap: 2rem;
    color: var(--color-destructive);
  }

  .dash__state--error .dash__state-mark {
    display: none;
  }

  .dash__state-action {
    flex-shrink: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .dash__state-action:hover {
    color: var(--color-accent-hover);
  }

  .dash__state-action:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @keyframes dash-state-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .dash__hero-row {
    display: grid;
    gap: 0;
    margin-bottom: 2.4rem;
    border-top: 1px solid var(--color-border);
  }

  .dash__kpis {
    display: grid;
    grid-template-columns: 1fr;
    margin-bottom: 2.4rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .dash__kpi {
    min-width: 0;
    padding: 2rem 1.6rem;
    background-color: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    transition: background-color var(--transition-base);
  }

  .dash__kpi:hover {
    background-color: var(--alpha-bg-subtle);
  }

  .dash__charts {
    display: grid;
    gap: 0;
  }

  .dash__empty {
    max-width: 52rem;
    margin: 0 auto;
    padding: 6rem 0 8rem;
  }

  .dash__empty-title {
    margin: 0 0 1.2rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 700;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
  }

  .dash__empty-desc {
    max-width: 42rem;
    margin: 0 0 3.2rem;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .dash__empty-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
  }

  .dash__empty-link {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .dash__empty-link:hover {
    color: var(--color-text);
  }

  .dash__empty-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (min-width: 480px) {
    .dash__kpis {
      grid-template-columns: repeat(2, 1fr);
    }

    .dash__kpi:nth-child(odd) {
      border-right: 1px solid var(--color-border);
    }

    .dash__kpi:nth-child(-n + 2) {
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (min-width: 760px) {
    .dash__hero-row {
      grid-template-columns: minmax(0, 1.5fr) minmax(26rem, 0.8fr);
    }
  }

  @media (min-width: 1024px) {
    .dash__kpis {
      grid-template-columns: repeat(4, 1fr);
    }

    .dash__kpi:nth-child(odd) {
      border-right: 0;
    }

    .dash__kpi:nth-child(-n + 2) {
      border-bottom: 0;
    }

    .dash__kpi + .dash__kpi {
      border-left: 1px solid var(--color-border);
    }

    .dash__charts {
      grid-template-columns: minmax(0, 2fr) minmax(28rem, 1fr);
      gap: 3.2rem;
      align-items: start;
    }
  }
</style>
