---
import AppLayout from '../layouts/AppLayout.astro';
import Button from '../components/ui/Button.astro';
import WeeklyGoal from '../components/dashboard/WeeklyGoal.astro';
import NextSession from '../components/dashboard/NextSession.astro';
import VolumeTrend from '../components/dashboard/VolumeTrend.astro';
import RecentSessions from '../components/dashboard/RecentSessions.astro';
import { t, localizedPath } from '../i18n';

const L = t();
---

<AppLayout title={L.dashboard.title}>
  <div class="dash" x-data="dashboardApp()" x-init="init()" x-cloak>
    <header class="dash__header">
      <h1 class="dash__title" x-text="greeting()">
        {L.dashboard.title}
      </h1>
      <a class="dash__header-action" href={localizedPath('/sessions/create')}>
        {L.dashboard.newSession}
      </a>
    </header>

    <div class="dash__state" x-show="isLoading" role="status" aria-live="polite">
      <span class="dash__state-mark" aria-hidden="true"></span>
      <span x-text="labels.loading">{L.dashboard.loading}</span>
    </div>

    <div class="dash__state dash__state--error" x-show="loadError" role="alert">
      <span x-text="labels.loadError">{L.dashboard.loadError}</span>
      <button type="button" class="dash__state-action" x-on:click="retry()" x-text="labels.retry">
        {L.dashboard.retry}
      </button>
    </div>

    <div x-show="!isLoading && !loadError && hasSessions">
      <div class="dash__hero-row">
        <NextSession />
        <WeeklyGoal />
      </div>

      <section class="dash__metrics" aria-label={L.dashboard.metricsAria}>
        <div class="dash__metric">
          <div class="dash__metric-head">
            <span class="dash__metric-label">{L.dashboard.weeklyVolumeShort}</span>
            <strong class="dash__metric-value">
              <span x-text="formatVolume(weeklyVolumeTotal)"></span>
              <span class="dash__metric-unit" x-text="labels.kg"></span>
            </strong>
          </div>
          <div class="dash__metric-bars" role="img" aria-label={L.dashboard.weeklyVolumeTrend}>
            <template x-for="(value, index) in weeklyVolumeByDay" :key="index">
              <span
                class="dash__metric-bar"
                :class="{ 'dash__metric-bar--today': index === todayIdx }"
                :style="`height: ${Math.max(6, (value / maxVol) * 100)}%`"
              ></span>
            </template>
          </div>
        </div>

        <div class="dash__metric">
          <div class="dash__metric-head">
            <span class="dash__metric-label">{L.dashboard.totalSessions}</span>
            <strong class="dash__metric-value">
              <span x-text="weeklySessionsByDay.reduce((total, count) => total + count, 0)"></span>
              <span
                class="dash__metric-unit"
                x-text="weeklySessionsByDay.reduce((total, count) => total + count, 0) === 1 ? labels.weeklyMoreSingular : labels.sessionsUnit"
              ></span>
            </strong>
          </div>
          <div class="dash__metric-bars" role="img" aria-label={L.dashboard.totalSessions}>
            <template x-for="(value, index) in weeklySessionsByDay" :key="index">
              <span
                class="dash__metric-bar"
                :class="{ 'dash__metric-bar--today': index === todayIdx }"
                :style="`height: ${Math.max(6, (value / Math.max(...weeklySessionsByDay, 1)) * 100)}%`"
              ></span>
            </template>
          </div>
        </div>

        <div class="dash__metric">
          <div class="dash__metric-head">
            <span class="dash__metric-label">{L.dashboard.setsUnit}</span>
            <strong class="dash__metric-value">
              <span x-text="weeklySetsTotal"></span>
              <span
                class="dash__metric-unit"
                x-text="weeklySetsTotal === 1 ? labels.setSingular : labels.setsUnit"
              ></span>
            </strong>
          </div>
          <div class="dash__metric-bars" role="img" aria-label={L.dashboard.setsUnit}>
            <template x-for="(value, index) in weeklySetsByDay" :key="index">
              <span
                class="dash__metric-bar"
                :class="{ 'dash__metric-bar--today': index === todayIdx }"
                :style="`height: ${Math.max(6, (value / Math.max(...weeklySetsByDay, 1)) * 100)}%`"
              ></span>
            </template>
          </div>
        </div>
      </section>

      <div class="dash__charts">
        <VolumeTrend />
        <RecentSessions />
      </div>
    </div>

    <div class="dash__empty" x-show="!isLoading && !loadError && !hasSessions">
      <h2 class="dash__empty-title">{L.dashboard.emptyTitle}</h2>
      <p class="dash__empty-desc">{L.dashboard.emptyDesc}</p>

      <div class="dash__empty-actions">
        <Button variant="primary" size="md" href={localizedPath('/sessions/create')}>
          <span>{L.dashboard.createFirst}</span>
        </Button>
        <Button variant="secondary" size="md" href={localizedPath('/timer')}>
          <span>{L.dashboard.stopwatch}</span>
        </Button>
        <a href={localizedPath('/exercises')} class="dash__empty-link">
          {L.dashboard.browseExercises}
        </a>
      </div>
    </div>
  </div>
</AppLayout>

<script>
  import { createDashboardApp } from '../components/dashboard/dashboardApp';
  import { t, getLocale, localizedPath } from '../i18n';

  const LABELS = t();

  const register = () => {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const Alpine = (window as any).Alpine;

    Alpine.data('dashboardApp', () =>
      createDashboardApp(
        {
          ...LABELS.dashboard,
          kg: LABELS.common.kg,
          status: {
            completed: LABELS.sessions.completed,
            inProgress: LABELS.sessions.inProgress,
            planned: LABELS.sessions.planned,
          },
        },
        localizedPath,
        {
          locale: () => (getLocale() === 'en' ? 'en' : 'fr'),
          today: () => new Date(),
          onError: (error) => console.error('[dashboard] failed to load', error),
          translateMuscle: (name) =>
            (window as { trMuscle?: (m: string) => string }).trMuscle?.(name) ?? name,
        }
      )
    );
  };

  document.addEventListener('alpine:init', register);
  if ((window as any).Alpine) register();
</script>

<style>
  .dash {
    max-width: 96rem;
    margin: 0 auto;
    padding-bottom: 8rem;
  }

  .dash__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.4rem;
    margin-bottom: 4rem;
  }

  .dash__title {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .dash__header-action {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    padding: 0 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .dash__header-action:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .dash__header-action:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dash__state {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 12rem;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 1.4rem;
  }

  .dash__state-mark {
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-border-strong);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: dash-state-spin 0.8s linear infinite;
  }

  .dash__state--error {
    justify-content: space-between;
    gap: 2rem;
    color: var(--color-destructive);
  }

  .dash__state--error .dash__state-mark {
    display: none;
  }

  .dash__state-action {
    flex-shrink: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .dash__state-action:hover {
    color: var(--color-accent-hover);
  }

  .dash__state-action:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @keyframes dash-state-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .dash__hero-row {
    display: grid;
    gap: 0;
    margin-bottom: 2.4rem;
    border-top: 1px solid var(--color-border);
  }

  .dash__metrics {
    display: grid;
    grid-template-columns: 1fr;
    margin-bottom: 2.4rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .dash__metric {
    min-width: 0;
    padding: 2rem 1.6rem;
  }

  .dash__metric + .dash__metric {
    border-top: 1px solid var(--color-border);
  }

  .dash__metric-head {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.6rem;
  }

  .dash__metric-label {
    color: var(--color-muted);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
  }

  .dash__metric-value {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-metric);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .dash__metric-unit {
    margin-left: 0.4rem;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .dash__metric-bars {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    height: 5rem;
  }

  .dash__metric-bar {
    flex: 1;
    min-width: 0;
    height: 6%;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: var(--color-border-strong);
    transition:
      height 240ms var(--ease-out),
      background-color var(--transition-fast);
  }

  .dash__metric-bar--today {
    background: var(--color-accent);
  }

  .dash__charts {
    display: grid;
    gap: 0;
  }

  .dash__empty {
    max-width: 52rem;
    margin: 0 auto;
    padding: 6rem 0 8rem;
  }

  .dash__empty-title {
    margin: 0 0 1.2rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 700;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
  }

  .dash__empty-desc {
    max-width: 42rem;
    margin: 0 0 3.2rem;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .dash__empty-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
  }

  .dash__empty-link {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .dash__empty-link:hover {
    color: var(--color-text);
  }

  .dash__empty-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (min-width: 760px) {
    .dash__hero-row {
      grid-template-columns: minmax(0, 1.5fr) minmax(26rem, 0.8fr);
    }

    .dash__metrics {
      grid-template-columns: repeat(3, 1fr);
    }

    .dash__metric + .dash__metric {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
  }

  @media (min-width: 1024px) {
    .dash__charts {
      grid-template-columns: minmax(0, 2fr) minmax(28rem, 1fr);
      gap: 3.2rem;
      align-items: start;
    }
  }
</style>
