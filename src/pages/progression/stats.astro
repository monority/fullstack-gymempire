---
import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import PanelHeader from '../../components/ui/PanelHeader.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Segmented from '../../components/ui/Segmented.astro';
import Toggle from '../../components/ui/Toggle.astro';
const L = t();
---

<AppLayout title={L.stats.title}>
  <PageHeader title={L.stats.title} description={L.stats.description} />

  <div class="stats__page" x-data="statsApp()" x-cloak>
    <div class="stats__empty-state" x-show="!hasCompletedSessions" x-cloak role="status">
      <h2 class="stats__empty-title">{L.stats.noData}</h2>
      <p class="stats__empty-text">{L.stats.empty}</p>
      <a href={localizedPath('/sessions/create')} class="stats__empty-cta">
        {L.common.startSession}
      </a>
    </div>

    <div class="stats__content" x-show="hasCompletedSessions" x-cloak>
      <div class="stats__summary">
        <div class="stats__sum">
          <span class="stats__sum-label">{L.stats.volumeTotal}</span>
          <div class="stats__sum-value-row">
            <span class="stats__sum-value" x-text="formatNumber(totalVolume12w)"></span>
            <span class="stats__sum-unit">{L.common.kg}</span>
          </div>
          <span
            class="stats__sum-foot"
            x-text="sessions12w + ' ' + labels.sessionSingular + (sessions12w > 1 ? 's' : '') + ' ' + labels.completed"
          ></span>
        </div>

        <div class="stats__sum">
          <span class="stats__sum-label">{L.stats.sessions12w}</span>
          <div class="stats__sum-value-row">
            <span class="stats__sum-value" x-text="sessions12w"></span>
          </div>
          <span class="stats__sum-foot">{L.stats.completed}</span>
        </div>

        <div class="stats__sum">
          <span class="stats__sum-label">{L.stats.avgDuration}</span>
          <div class="stats__sum-value-row">
            <span class="stats__sum-value" x-text="formatDuration(avgDuration)"></span>
          </div>
          <span
            class="stats__sum-foot"
            x-text="durationSessionCount > 0 ? labels.on + durationSessionCount + ' ' + labels.sessionSingular + (durationSessionCount > 1 ? 's' : '') : labels.noTimed"
          ></span>
        </div>

        <div class="stats__sum">
          <span class="stats__sum-label">{L.stats.regularity}</span>
          <div class="stats__sum-value-row">
            <span class="stats__sum-value" x-text="consistencyPct + '%'"></span>
          </div>
          <span
            class="stats__sum-foot"
            x-text="activeWeeks + ' ' + (activeWeeks > 1 ? labels.activeWeeks : labels.activeWeek) + ' / 12'"
          ></span>
        </div>
      </div>

      <Card>
        <PanelHeader title={L.stats.volumeChart} meta={L.stats.last12wKg} />
        <CardContent>
          <div class="stats__chart-wrap" x-html="renderVolumeChart()"></div>
        </CardContent>
      </Card>

      <div class="stats__grid">
        <Card>
          <div class="stats__card-header">
            <PanelHeader title={L.stats.volumeByMuscle} />
            <div class="stats__card-controls">
              <span class="stats__chart-meta" x-text="periodMeta"></span>
              <Segmented
                items={[
                  { value: 'week', label: L.stats.volumePeriodWeek },
                  { value: 'month', label: L.stats.volumePeriodMonth },
                ]}
                model="period"
                ariaLabel={L.stats.volumePeriod}
              />
            </div>
          </div>
          <CardContent>
            <div class="stats__chart-wrap" x-html="renderMuscleChart()"></div>
          </CardContent>
        </Card>

        <Card>
          <PanelHeader title={L.stats.freqChart} meta={L.stats.last8w} />
          <CardContent>
            <div class="stats__chart-wrap" x-html="renderFrequencyChart()"></div>
          </CardContent>
        </Card>
      </div>

      <Card>
        <PanelHeader title={L.stats.topExercises} meta={L.stats.volumeTotalMeta} />
        <CardContent>
          <div class="stats__top-wrap" x-html="renderTopExercises()"></div>
        </CardContent>
      </Card>

      <Card>
        <PanelHeader
          title={L.stats.benchmarksTitle}
          meta={`${L.stats.benchmarksThresholdHeader} · ${L.common.kg}`}
        />
        <CardContent>
          <p class="stats__bench-desc">{L.stats.benchmarksDesc}</p>

          {/* ── Opt-in : enregistre l'INTENTION, ne déclenche AUCUN appel réseau ── */}
          <div class="stats__bench-optin">
            <div class="stats__bench-optin-label">
              <span class="stats__bench-optin-title">{L.stats.benchmarksOptInLabel}</span>
              <span class="stats__bench-optin-hint">{L.stats.benchmarksOptInDesc}</span>
            </div>
            <Toggle
              aria-label={L.stats.benchmarksOptInLabel}
              :checked="settings.benchmarksOptIn"
              :aria-checked="settings.benchmarksOptIn ? 'true' : 'false'"
              @change="setBenchmarksOptIn($event.target.checked)"
            />
          </div>

          {/* ── Table des benchmarks (1RM Epley vs références) ── */}
          <div class="stats__chart-wrap" x-html="renderBenchmarksTable()"></div>

          {/* ── Honnêteté des données : source étiquetée, non-communautaire ── */}
          <p class="stats__bench-note">{L.stats.benchmarksSourceNote}</p>
        </CardContent>
      </Card>
    </div>
  </div>
</AppLayout>

<script>
  import { getAlpine } from '../../lib/alpine';
  import { getSessions } from '../../lib/storage/sessions';
  import { getSettings, updateSettings } from '../../lib/storage/settings';

  import { buildBenchmarkRows, type PercentileBand } from '../../lib/benchmarks';

  import { REFERENCE_DATA } from '../../lib/benchmarks-data';

  import { t, trExercise, trMuscle } from '../../i18n';

  import { formatDateShort, formatNumber, formatDuration } from '../../lib/format';

  import {
    volumeByMuscle,
    type MuscleVolumeSlice,
    type VolumePeriod,
  } from '../../lib/volume-stats';

  import { cssVar, cssVarAlpha } from '../../lib/css-var';
  import {
    buildWeeks,
    aggregateByWeek,
    topExercisesByVolume,
    type WeekBucket,
    type TopExercise,
  } from '../../lib/week-aggregation';
  import {
    renderVolumeChart as renderVolumeChartSvg,
    renderMuscleChart as renderMuscleChartSvg,
    renderFrequencyChart as renderFrequencyChartSvg,
    renderTopExercises as renderTopExercisesSvg,
    renderBenchmarksTable as renderBenchmarksTableSvg,
    type StatsChartDeps,
    type StatsChartLabels,
  } from '../../lib/charts/statsCharts';

  const LABELS = t();

  const chartLabels: StatsChartLabels = {
    kg: LABELS.common.kg,
    noData: LABELS.common.noData,
    volumeChart: LABELS.stats.volumeChart,
    freqChart: LABELS.stats.freqChart,
    volumeByMuscle: LABELS.stats.volumeByMuscle,
    total: LABELS.stats.total,
    sessionSingular: LABELS.stats.sessionSingular,
    volumeEmpty: LABELS.stats.volumeEmpty,
    benchmarksEmpty: LABELS.stats.benchmarksEmpty,
    benchmarksColExercise: LABELS.stats.benchmarksColExercise,
    benchmarksColYour1RM: LABELS.stats.benchmarksColYour1RM,
    benchmarksPctl50: LABELS.stats.benchmarksPctl50,
    benchmarksPctl75: LABELS.stats.benchmarksPctl75,
    benchmarksPctl90: LABELS.stats.benchmarksPctl90,
    benchmarksTitle: LABELS.stats.benchmarksTitle,
    benchmarksNoBands: LABELS.stats.benchmarksNoBands,
  };

  const chartDeps: StatsChartDeps = {
    cssVar,
    cssVarAlpha,
    formatNumber,
    formatDate: formatDateShort,
    trExercise,
    trMuscle,
  };

  document.addEventListener('alpine:init', () => {
    const Alpine = getAlpine();
    if (!Alpine) return;

    Alpine.data('statsApp', () => ({
      // ── Labels ──
      labels: {
        sessionSingular: LABELS.stats.sessionSingular,
        completed: LABELS.stats.completed,
        on: LABELS.records.on,
        noTimed: LABELS.stats.noTimed,
        activeWeek: LABELS.stats.activeWeek,
        activeWeeks: LABELS.stats.activeWeeks,
      },

      // ── Aggregated state ──
      weeks12: [] as WeekBucket[],
      weeks8: [] as WeekBucket[],
      sessions12w: 0,
      totalVolume12w: 0,
      activeWeeks: 0,
      consistencyPct: 0,
      avgDuration: 0,
      durationSessionCount: 0,
      period: 'week' as VolumePeriod,
      muscleWeek: [] as MuscleVolumeSlice[],
      muscleMonth: [] as MuscleVolumeSlice[],
      top5: [] as TopExercise[],

      // ── Benchmarks (V1 locale, référence étiquetée) ──
      settings: getSettings(),
      hasCompletedSessions: false,
      benchmarkRows: [] as Array<{
        exercise: string;
        userValue: number | null;
        band: PercentileBand | null;
        p50: number;
        p75: number;
        p90: number;
      }>,

      // ── Init ──
      init() {
        const sessions = getSessions();

        this.weeks12 = buildWeeks(12);
        aggregateByWeek(sessions, this.weeks12);
        this.sessions12w = this.weeks12.reduce((s, b) => s + b.sessionCount, 0);
        this.totalVolume12w = this.weeks12.reduce((s, b) => s + b.volume, 0);
        this.activeWeeks = this.weeks12.filter((b) => b.sessionCount > 0).length;
        this.consistencyPct = Math.round((this.activeWeeks / 12) * 100);

        const totalDur = this.weeks12.reduce((s, b) => s + b.durationSum, 0);
        const durCount = this.weeks12.reduce((s, b) => s + b.durationCount, 0);
        this.avgDuration = durCount > 0 ? totalDur / durCount : 0;
        this.durationSessionCount = durCount;

        this.weeks8 = buildWeeks(8);
        aggregateByWeek(sessions, this.weeks8);

        this.muscleWeek = volumeByMuscle(sessions, { period: 'week' });
        this.muscleMonth = volumeByMuscle(sessions, { period: 'month' });
        this.top5 = topExercisesByVolume(sessions, 5, 12);

        // ── Benchmarks (séances terminées uniquement) ──
        this.settings = getSettings();
        this.hasCompletedSessions = sessions.some((s) => s.status === 'completed');
        this.benchmarkRows = buildBenchmarkRows(sessions, REFERENCE_DATA);
      },

      // ── Derived (volume-by-muscle donut) ──
      get slices(): MuscleVolumeSlice[] {
        return this.period === 'week' ? this.muscleWeek : this.muscleMonth;
      },

      get periodMeta(): string {
        return this.period === 'week' ? LABELS.stats.volumeLast7d : LABELS.stats.volumeLast30d;
      },

      // ── Display helpers ──
      formatNumber(n: number): string {
        return formatNumber(n);
      },
      formatDate(iso: string): string {
        return formatDateShort(iso);
      },
      formatDuration(seconds: number): string {
        return formatDuration(seconds);
      },

      renderVolumeChart(): string {
        return renderVolumeChartSvg(this.weeks12, chartLabels, chartDeps);
      },

      renderMuscleChart(): string {
        return renderMuscleChartSvg(this.slices, chartLabels, chartDeps);
      },

      renderFrequencyChart(): string {
        return renderFrequencyChartSvg(this.weeks8, chartLabels, chartDeps);
      },

      renderTopExercises(): string {
        return renderTopExercisesSvg(this.top5, chartLabels, chartDeps);
      },

      setBenchmarksOptIn(checked: boolean) {
        this.settings = updateSettings({ benchmarksOptIn: checked });
      },

      renderBenchmarksTable(): string {
        return renderBenchmarksTableSvg(
          this.benchmarkRows,
          this.hasCompletedSessions,
          chartLabels,
          chartDeps
        );
      },
    }));
  });
</script>

<style>
  .stats__page {
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .stats__empty-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .stats__empty-title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 700;
    color: var(--color-text);
  }

  .stats__empty-text {
    max-width: 42rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 1.4rem;
  }

  .stats__empty-cta {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    margin-top: 0.5rem;
    padding-left: 1.8rem;
    padding-right: 1.8rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    font-size: var(--text-small);
    font-weight: 700;
    text-decoration: none;
  }

  .stats__content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .stats__summary {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .stats__summary {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats__sum {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    padding: 2rem 1.6rem;
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
  }

  @media (max-width: 767px) {
    .stats__sum:nth-child(even) {
      border-left: 1px solid var(--color-border);
    }
  }

  @media (min-width: 768px) {
    .stats__sum {
      border-bottom: 0;
    }

    .stats__sum + .stats__sum {
      border-left: 1px solid var(--color-border);
    }
  }

  .stats__sum-label {
    color: var(--color-muted);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
  }

  .stats__sum-value-row {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .stats__sum-value {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-metric);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .stats__sum-unit {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .stats__sum-foot {
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .stats__chart-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .stats__card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stats__card-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stats__top-wrap {
    width: 100%;
  }

  .stats__bench-desc {
    font-size: var(--text-small);
    color: var(--color-muted);
    margin: 0;
    margin-bottom: 0.25rem;
    line-height: 1.4;
  }

  .stats__bench-optin {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
    padding-left: 1.6rem;
    padding-right: 1.6rem;
    margin-top: 1.2rem;
    margin-bottom: 1.6rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (max-width: 767px) {
    .stats__bench-optin {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  .stats__bench-optin-label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .stats__bench-note {
    font-size: var(--text-caption);
    color: var(--color-muted);
    margin-top: 1.3rem;
    margin-bottom: 0;
    line-height: 1.4;
  }

  :global(.stats__content > .surface),
  :global(.stats__grid > .surface) {
    background: transparent;
    border: 0;
    border-top: 1px solid var(--color-border);
    border-radius: 0;
  }
  :global(.stats__content > .surface:last-child) {
    border-bottom: 1px solid var(--color-border);
  }
</style>

<style is:global>
  .badge--category {
    background-color: var(--alpha-bg-soft);
    color: var(--color-muted);
  }
  .badge--cat-chest {
    background-color: var(--color-cat-chest-bg);
    color: var(--color-cat-chest);
  }
  .badge--cat-back {
    background-color: var(--color-cat-back-bg);
    color: var(--color-cat-back);
  }
  .badge--cat-shoulders {
    background-color: var(--color-cat-shoulders-bg);
    color: var(--color-cat-shoulders);
  }
  .badge--cat-arms {
    background-color: var(--color-cat-arms-bg);
    color: var(--color-cat-arms);
  }
  .badge--cat-legs {
    background-color: var(--color-cat-legs-bg);
    color: var(--color-cat-legs);
  }
  .badge--cat-core {
    background-color: var(--color-cat-core-bg);
    color: var(--color-cat-core);
  }
  .badge--cat-other {
    background-color: var(--alpha-bg-soft);
    color: var(--color-muted);
  }
  .stats__muscle-badge {
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    white-space: nowrap;
    border-radius: var(--radius-pill);
    padding: 0.125rem 0.5rem;
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    align-self: flex-start;
  }

  /* Le markup des graphiques est injecté par x-html : il ne reçoit pas le
     hash de scoped CSS d'Astro. Tout ce qui le stylise doit être global. */
  .stats__empty {
    padding: 2.4rem 0;
    color: var(--color-muted);
    font-size: var(--text-body);
  }
  .stats__donut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.4rem;
  }
  .stats__donut-svg {
    width: min(100%, 28rem);
    height: auto;
  }
  .stats__donut-svg circle {
    fill: none;
  }
  .stats__donut-svg circle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .stats__donut-legend {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stats__legend-row {
    display: grid;
    grid-template-columns: 0.8rem 1fr auto auto;
    align-items: center;
    gap: 1.2rem;
    font-size: var(--text-small);
  }
  .stats__legend-swatch {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: var(--radius-pill);
  }
  .stats__legend-name {
    color: var(--color-text);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .stats__legend-pct {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .stats__legend-value {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .stats__top-list {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stats__top-row {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
  }
  .stats__top-rank {
    flex-shrink: 0;
    width: 2.4rem;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  .stats__top-main {
    flex: 1;
    min-width: 0;
  }
  .stats__top-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }
  .stats__top-name {
    color: var(--color-text);
    font-size: var(--text-body);
    font-weight: 600;
  }
  .stats__top-value {
    margin-left: auto;
    color: var(--color-muted);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }
  .stats__top-bar {
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface-3);
    overflow: hidden;
  }
  .stats__top-fill {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }
  .stats__bench-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-body);
  }
  .stats__bench-table th,
  .stats__bench-table td {
    padding: 1rem 1.1rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .stats__bench-table thead th {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
  }
  .stats__bench-table thead th:nth-child(n + 2) {
    text-align: right;
  }
  .stats__bench-table tbody td {
    color: var(--color-muted);
    text-align: right;
  }
  .stats__bench-table tbody th {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 600;
    white-space: normal;
    word-break: break-word;
  }
  .stats__bench-row:hover {
    background-color: var(--alpha-bg-subtle);
  }
  .stats__bench-row--top {
    background-color: color-mix(in srgb, var(--color-success) 10%, transparent);
  }
  .stats__bench-value {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    color: var(--color-muted);
    font-weight: 600;
  }
  .stats__bench-num {
    color: var(--color-text);
  }
  .stats__bench-badge {
    display: inline-flex;
    align-items: center;
    height: 2.2rem;
    padding: 0 0.8rem;
