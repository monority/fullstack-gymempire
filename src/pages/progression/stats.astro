---
import { t, localizedPath } from '../../i18n';
import StatsSummary from '../../components/progression/StatsSummary.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Card from '../../components/ui/Card.astro';
import PanelHeader from '../../components/ui/PanelHeader.astro';
import CardContent from '../../components/ui/CardContent.astro';
import Segmented from '../../components/ui/Segmented.astro';
import Toggle from '../../components/ui/Toggle.astro';
const L = t();
---

<AppLayout title={L.stats.title}>
  <PageHeader title={L.stats.title} description={L.stats.description} />

  <div class="stats__page" x-data="statsApp()" x-cloak>
    <div class="stats__empty-state" x-show="!hasCompletedSessions" x-cloak role="status">
      <h2 class="stats__empty-title">{L.stats.noData}</h2>
      <p class="stats__empty-text">{L.stats.empty}</p>
      <a href={localizedPath('/sessions/create')} class="stats__empty-cta">
        {L.common.startSession}
      </a>
    </div>

    <div class="stats__content" x-show="hasCompletedSessions" x-cloak>
      <StatsSummary labels={L.stats} common={L.common} />

      <Card>
        <PanelHeader title={L.stats.volumeChart} meta={L.stats.last12wKg} />
        <CardContent>
          <div class="stats__chart-wrap" x-html="renderVolumeChart()"></div>
        </CardContent>
      </Card>

      <div class="stats__grid">
        <Card>
          <div class="stats__card-header">
            <PanelHeader title={L.stats.volumeByMuscle} />
            <div class="stats__card-controls">
              <span class="stats__chart-meta" x-text="periodMeta"></span>
              <Segmented
                items={[
                  { value: 'week', label: L.stats.volumePeriodWeek },
                  { value: 'month', label: L.stats.volumePeriodMonth },
                ]}
                model="period"
                ariaLabel={L.stats.volumePeriod}
              />
            </div>
          </div>
          <CardContent>
            <div class="stats__chart-wrap" x-html="renderMuscleChart()"></div>
          </CardContent>
        </Card>

        <Card>
          <PanelHeader title={L.stats.freqChart} meta={L.stats.last8w} />
          <CardContent>
            <div class="stats__chart-wrap" x-html="renderFrequencyChart()"></div>
          </CardContent>
        </Card>
      </div>

      <Card>
        <PanelHeader title={L.stats.topExercises} meta={L.stats.volumeTotalMeta} />
        <CardContent>
          <div class="stats__top-wrap" x-html="renderTopExercises()"></div>
        </CardContent>
      </Card>

      <Card>
        <PanelHeader
          title={L.stats.benchmarksTitle}
          meta={`${L.stats.benchmarksThresholdHeader} · ${L.common.kg}`}
        />
        <CardContent>
          <p class="stats__bench-desc">{L.stats.benchmarksDesc}</p>

          {/* ── Opt-in : enregistre l'INTENTION, ne déclenche AUCUN appel réseau ── */}
          <div class="stats__bench-optin">
            <div class="stats__bench-optin-label">
              <span class="stats__bench-optin-title">{L.stats.benchmarksOptInLabel}</span>
              <span class="stats__bench-optin-hint">{L.stats.benchmarksOptInDesc}</span>
            </div>
            <Toggle
              aria-label={L.stats.benchmarksOptInLabel}
              :checked="settings.benchmarksOptIn"
              :aria-checked="settings.benchmarksOptIn ? 'true' : 'false'"
              @change="setBenchmarksOptIn($event.target.checked)"
            />
          </div>

          {/* ── Table des benchmarks (1RM Epley vs références) ── */}
          <div class="stats__chart-wrap" x-html="renderBenchmarksTable()"></div>

          {/* ── Honnêteté des données : source étiquetée, non-communautaire ── */}
          <p class="stats__bench-note">{L.stats.benchmarksSourceNote}</p>
        </CardContent>
      </Card>
    </div>
  </div>
</AppLayout>

<script>
  import { t } from '../../i18n';
  import { buildStatsDeps, createStatsApp } from '../../components/progression/statsApp';
  import { registerAlpine } from '../../lib/alpine';

  registerAlpine('statsApp', () => createStatsApp(buildStatsDeps(t())));
</script>

<style>
  .stats__page {
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .stats__empty-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .stats__empty-title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 700;
    color: var(--color-text);
  }

  .stats__empty-text {
    max-width: 42rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 1.4rem;
  }

  .stats__empty-cta {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    margin-top: 0.5rem;
    padding-left: 1.8rem;
    padding-right: 1.8rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    font-size: var(--text-small);
    font-weight: 700;
    text-decoration: none;
  }

  .stats__content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .stats__chart-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .stats__card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stats__card-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stats__top-wrap {
    width: 100%;
  }

  .stats__bench-desc {
    font-size: var(--text-small);
    color: var(--color-muted);
    margin: 0;
    margin-bottom: 0.25rem;
    line-height: 1.4;
  }

  .stats__bench-optin {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
    padding-left: 1.6rem;
    padding-right: 1.6rem;
    margin-top: 1.2rem;
    margin-bottom: 1.6rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (max-width: 767px) {
    .stats__bench-optin {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  .stats__bench-optin-label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .stats__bench-note {
    font-size: var(--text-caption);
    color: var(--color-muted);
    margin-top: 1.3rem;
    margin-bottom: 0;
    line-height: 1.4;
  }

  :global(.stats__content > .surface),
  :global(.stats__grid > .surface) {
    background: transparent;
    border: 0;
    border-top: 1px solid var(--color-border);
    border-radius: 0;
  }
  :global(.stats__content > .surface:last-child) {
    border-bottom: 1px solid var(--color-border);
  }
</style>

<style is:global>
  .badge--category {
    background-color: var(--alpha-bg-soft);
    color: var(--color-muted);
  }
  .badge--cat-chest {
    background-color: var(--color-cat-chest-bg);
    color: var(--color-cat-chest);
  }
  .badge--cat-back {
    background-color: var(--color-cat-back-bg);
    color: var(--color-cat-back);
  }
  .badge--cat-shoulders {
    background-color: var(--color-cat-shoulders-bg);
    color: var(--color-cat-shoulders);
  }
  .badge--cat-arms {
    background-color: var(--color-cat-arms-bg);
    color: var(--color-cat-arms);
  }
  .badge--cat-legs {
    background-color: var(--color-cat-legs-bg);
    color: var(--color-cat-legs);
  }
  .badge--cat-core {
    background-color: var(--color-cat-core-bg);
    color: var(--color-cat-core);
  }
  .badge--cat-other {
    background-color: var(--alpha-bg-soft);
    color: var(--color-muted);
  }
  .stats__muscle-badge {
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    white-space: nowrap;
    border-radius: var(--radius-pill);
    padding: 0.125rem 0.5rem;
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    align-self: flex-start;
  }

  /* Le markup des graphiques est injecté par x-html : il ne reçoit pas le
     hash de scoped CSS d'Astro. Tout ce qui le stylise doit être global. */
  .stats__empty {
    padding: 2.4rem 0;
    color: var(--color-muted);
    font-size: var(--text-body);
  }
  .stats__donut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.4rem;
  }
  .stats__donut-svg {
    width: min(100%, 28rem);
    height: auto;
  }
  .stats__donut-svg circle {
    fill: none;
  }
  .stats__donut-svg circle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .stats__donut-legend {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stats__legend-row {
    display: grid;
    grid-template-columns: 0.8rem 1fr auto auto;
    align-items: center;
    gap: 1.2rem;
    font-size: var(--text-small);
  }
  .stats__legend-swatch {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: var(--radius-pill);
  }
  .stats__legend-name {
    color: var(--color-text);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .stats__legend-pct {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .stats__legend-value {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .stats__top-list {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stats__top-row {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
  }
  .stats__top-rank {
    flex-shrink: 0;
    width: 2.4rem;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  .stats__top-main {
    flex: 1;
    min-width: 0;
  }
  .stats__top-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }
  .stats__top-name {
    color: var(--color-text);
    font-size: var(--text-body);
    font-weight: 600;
  }
  .stats__top-value {
    margin-left: auto;
    color: var(--color-muted);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }
  .stats__top-bar {
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface-3);
    overflow: hidden;
  }
  .stats__top-fill {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }
  .stats__bench-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-body);
  }
  .stats__bench-table th,
  .stats__bench-table td {
    padding: 1rem 1.1rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .stats__bench-table thead th {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
  }
  .stats__bench-table thead th:nth-child(n + 2) {
    text-align: right;
  }
  .stats__bench-table tbody td {
    color: var(--color-muted);
    text-align: right;
  }
  .stats__bench-table tbody th {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 600;
    white-space: normal;
    word-break: break-word;
  }
  .stats__bench-row:hover {
    background-color: var(--alpha-bg-subtle);
  }
  .stats__bench-row--top {
    background-color: color-mix(in srgb, var(--color-success) 10%, transparent);
  }
  .stats__bench-value {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    color: var(--color-muted);
    font-weight: 600;
  }
  .stats__bench-num {
    color: var(--color-text);
  }
  .stats__bench-badge {
    display: inline-flex;
    align-items: center;
    height: 2.2rem;
    padding: 0 0.8rem;
    background-color: color-mix(in srgb, var(--color-accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    border-radius: var(--radius-pill);
    color: var(--color-accent);
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
