---
import '../../styles/components/records-page.css';

import { resolveLocale } from '../../i18n';

import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import MetricGrid from '../../components/ui/MetricGrid.astro';
import { buildRecordsMetrics } from '../../components/progression/metric-definitions';
const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
import Icon from '../../components/ui/Icon.astro';
---

<AppLayout title={L.records.title}>
  <PageHeader title={L.records.titlePage} description={L.records.description} />

  <div class="rec" x-data="recordsApp()" x-init="init()" x-cloak>
    <template x-if="totalPRs > 0 || hasData">
      <div>
        <MetricGrid prefix="records-summary" metrics={buildRecordsMetrics(L)} />
        <p class="u-hint rec__hint">{L.records.oneRMHint}</p>
      </div>
    </template>

    <template x-if="allRecords.length > 0">
      <div class="rec__toolbar">
        <label class="rec__search">
          <Icon name="searchLine" size={20} />
          <input
            type="search"
            class="rec__search-input"
            placeholder={L.records.searchPlaceholder}
            x-model="search"
            aria-label={L.records.searchAria}
          />
        </label>

        <div class="rec__sort">
          <span class="rec__sort-label">{L.records.sortLabel}</span>
          <div class="rec__sort-group" role="radiogroup" aria-label={L.records.sortAria}>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'rm' }"
              @click="sortBy = 'rm'"
              role="radio"
              :aria-checked="sortBy === 'rm'"
            >
              {L.records.sortRM}
            </button>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'name' }"
              @click="sortBy = 'name'"
              role="radio"
              :aria-checked="sortBy === 'name'"
            >
              {L.records.sortName}
            </button>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'recent' }"
              @click="sortBy = 'recent'"
              role="radio"
              :aria-checked="sortBy === 'recent'"
            >
              {L.records.sortRecent}
            </button>
          </div>
        </div>
      </div>
    </template>

    <template x-if="filteredRecords.length > 0">
      <div class="rec__list">
        <template x-for="rec in filteredRecords" :key="rec.exerciseId">
          <a
            class="rec__card"
            :href="historyHref(rec.exerciseId)"
            :aria-label="labels.viewHistoryAriaPrefix + rec.name"
          >
            <div class="rec__card-icon" aria-hidden="true">
              <Icon name="dumbbellBox" size={24} />
            </div>

            <div class="rec__card-main">
              <div class="rec__card-head">
                <h3
                  class="rec__card-name text-display"
                  x-text="$store.i18n.trExercise(rec.name)"
                ></h3>
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + $store.i18n.muscleHue(rec.muscle)"
                  x-text="$store.i18n.trMuscle(rec.muscle)"
                />
              </div>

              <div class="rec__card-stats">
                <div class="rec__card-stat rec__card-stat--hero">
                  <span class="rec__card-stat-label">{L.records.sortRM}</span>
                  <span
                    class="rec__card-stat-value text-display"
                    x-text="formatNumber(rec.estimated1RM) + ' ' + labels.kg"
                  ></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.bestWeight}</span>
                  <span
                    class="rec__card-stat-value text-display"
                    x-text="formatNumber(rec.bestWeight) + ' ' + labels.kg"
                  ></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.bestReps}</span>
                  <span class="rec__card-stat-value text-display" x-text="rec.bestReps"></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.sessions}</span>
                  <span class="rec__card-stat-value text-display" x-text="rec.sessionCount"></span>
                </div>
              </div>
            </div>

            <div class="rec__card-side">
              <span class="rec__card-date-label">{L.records.lastSession}</span>
              <span class="rec__card-date" x-text="formatDate(rec.lastSessionDate)"></span>
              <span class="rec__card-date rec__card-date--pr">
                {L.records.prDate} <span x-text="formatDate(rec.date)"></span>
              </span>
              <span class="rec__card-cta" aria-hidden="true">
                <Icon name="chevronRight" size={16} />
              </span>
            </div>
          </a>
        </template>
      </div>
    </template>

    <template x-if="allRecords.length === 0 && !hasData">
      <div class="rec__empty">
        <EmptyState
          iconName="chart"
          title={L.records.noRecords}
          description={L.records.noRecordsDesc}
          actionLabel={L.common.startSession}
          actionHref={localizedPath('/sessions/create', locale)}
        />
      </div>
    </template>

    <template x-if="allRecords.length > 0 && filteredRecords.length === 0">
      <div class="rec__empty">
        <EmptyState
          iconName="chart"
          title={L.records.noResult}
          description={L.records.noResultDesc}
        />
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import { registerRecords } from '../../components/progression/recordsRegistration.ts';

  registerRecords();
</script>
