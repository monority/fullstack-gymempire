---
import { t, localizedPath } from '../../i18n';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import RecordsSummary from '../../components/progression/RecordsSummary.astro';
import { icons } from '../../lib/icons';
const L = t();
---

<AppLayout title={L.records.title}>
  <PageHeader title={L.records.titlePage} description={L.records.description} />

  <div class="rec" x-data="recordsApp()" x-init="init()" x-cloak>
    <template x-if="totalPRs > 0 || hasData">
      <RecordsSummary labels={L.records} common={L.common} />
    </template>

    <template x-if="allRecords.length > 0">
      <div class="rec__toolbar">
        <label class="rec__search">
          <Fragment set:html={icons.searchLine(20, 20)} />
          <input
            type="search"
            class="rec__search-input"
            placeholder={L.records.searchPlaceholder}
            x-model="search"
            aria-label={L.records.searchAria}
          />
        </label>

        <div class="rec__sort">
          <span class="rec__sort-label">{L.records.sortLabel}</span>
          <div class="rec__sort-group" role="radiogroup" aria-label={L.records.sortAria}>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'rm' }"
              @click="sortBy = 'rm'"
              role="radio"
              :aria-checked="sortBy === 'rm'"
            >
              {L.records.sortRM}
            </button>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'name' }"
              @click="sortBy = 'name'"
              role="radio"
              :aria-checked="sortBy === 'name'"
            >
              {L.records.sortName}
            </button>
            <button
              type="button"
              class="rec__sort-btn"
              :class="{ 'rec__sort-btn--active': sortBy === 'recent' }"
              @click="sortBy = 'recent'"
              role="radio"
              :aria-checked="sortBy === 'recent'"
            >
              {L.records.sortRecent}
            </button>
          </div>
        </div>
      </div>
    </template>

    <template x-if="filteredRecords.length > 0">
      <div class="rec__list">
        <template x-for="rec in filteredRecords" :key="rec.exerciseId">
          <a
            class="rec__card"
            :href="historyHref(rec.exerciseId)"
            :aria-label="labels.viewHistoryAriaPrefix + rec.name"
          >
            <div class="rec__card-icon" aria-hidden="true">
              <Fragment set:html={icons.dumbbellBox(24, 24)} />
            </div>

            <div class="rec__card-main">
              <div class="rec__card-head">
                <h3 class="rec__card-name text-display" x-text="trExercise(rec.name)"></h3>
                <Badge
                  variant="category"
                  size="sm"
                  :class="'badge--cat-' + muscleHue(rec.muscle)"
                  x-text="trMuscle(rec.muscle)"
                />
              </div>

              <div class="rec__card-stats">
                <div class="rec__card-stat rec__card-stat--hero">
                  <span class="rec__card-stat-label">{L.records.sortRM}</span>
                  <span
                    class="rec__card-stat-value text-display"
                    x-text="formatNumber(rec.estimated1RM) + ' ' + labels.kg"
                  ></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.bestWeight}</span>
                  <span
                    class="rec__card-stat-value text-display"
                    x-text="formatNumber(rec.bestWeight) + ' ' + labels.kg"
                  ></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.bestReps}</span>
                  <span class="rec__card-stat-value text-display" x-text="rec.bestReps"></span>
                </div>
                <div class="rec__card-stat">
                  <span class="rec__card-stat-label">{L.records.sessions}</span>
                  <span class="rec__card-stat-value text-display" x-text="rec.sessionCount"></span>
                </div>
              </div>
            </div>

            <div class="rec__card-side">
              <span class="rec__card-date-label">{L.records.lastSession}</span>
              <span class="rec__card-date" x-text="formatDate(rec.lastSessionDate)"></span>
              <span class="rec__card-date rec__card-date--pr">
                {L.records.prDate} <span x-text="formatDate(rec.date)"></span>
              </span>
              <span class="rec__card-cta" aria-hidden="true">
                <Fragment set:html={icons.chevronRight(16, 16)} />
              </span>
            </div>
          </a>
        </template>
      </div>
    </template>

    <template x-if="allRecords.length === 0 && !hasData">
      <div class="rec__empty">
        <EmptyState
          iconName="chart"
          title={L.records.noRecords}
          description={L.records.noRecordsDesc}
          actionLabel={L.common.startSession}
          actionHref={localizedPath('/sessions/create')}
        />
      </div>
    </template>

    <template x-if="allRecords.length > 0 && filteredRecords.length === 0">
      <div class="rec__empty">
        <EmptyState
          iconName="chart"
          title={L.records.noResult}
          description={L.records.noResultDesc}
        />
      </div>
    </template>
  </div>
</AppLayout>

<script>
  import { registerAlpine } from '../../lib/alpine';
  import { createRecordsApp } from '../../components/progression/recordsApp';
  import { t, localizedPath, getLocale } from '../../i18n';

  const LABELS = t();

  registerAlpine('recordsApp', () =>
    createRecordsApp({
      labels: {
        on: LABELS.records.on,
        exercisesTracked: LABELS.records.exercisesTracked,
        exerciseTracked: LABELS.records.exerciseTracked,
        kg: LABELS.common.kg,
        viewHistoryAriaPrefix: LABELS.records.viewHistoryAriaPrefix,
      },
      today: () => new Date(),
      locale: getLocale(),
      localizedPath,
    })
  );
</script>

<style>
  :global(.rec) {
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.rec__toolbar) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.875rem;
    padding-bottom: 0.875rem;
    background-color: transparent;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: var(--color-border);
  }

  :global(.rec__search) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex: 1 1 0%;
    min-width: 0;
    height: 2.75rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    background-color: var(--color-surface-2);
    border-width: 1px;
    border-style: solid;
    border-color: var(--color-border);
    border-radius: var(--radius-md);
    transition-property: border-color, box-shadow;
    transition-duration: var(--transition-fast);
  }

  :global(.rec__search-input) {
    flex: 1 1 0%;
    min-width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    outline: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.4rem;
  }

  :global(.rec__sort) {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  :global(.rec__sort-group) {
    display: inline-flex;
    padding: 0.3rem;
    background-color: var(--color-surface-2);
    border-width: 1px;
    border-style: solid;
    border-color: var(--color-border);
    border-radius: var(--radius-md);
    gap: 0.125rem;
  }

  :global(.rec__sort-btn) {
    height: 2.75rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    background-color: transparent;
    border-width: 0;
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    transition-property: background-color, color;
    transition-duration: var(--transition-fast);
  }

  :global(.rec__list) {
    display: flex;
    flex-direction: column;
  }

  :global(.rec__card) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.875rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: var(--color-border);
    border-radius: 0;
    text-decoration: none;
    color: inherit;
    transition-property: background-color, color;
    transition-duration: var(--transition-normal);
  }

  :global(.rec__card-icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background-color: transparent;
    color: var(--color-accent);
    border-right-width: 1px;
    border-right-style: solid;
    border-right-color: var(--color-border);
    padding-right: 0.625rem;
    flex-shrink: 0;
  }

  :global(.rec__card-main) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  :global(.rec__card-head) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  :global(.rec__card-name) {
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
    overflow-wrap: break-word;
  }

  :global(.rec__card-stats) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    row-gap: 0.375rem;
    column-gap: 0.75rem;
  }

  :global(.rec__card-stat) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 5.2rem;
  }

  :global(.rec__card-stat-label) {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    font-weight: 700;
  }

  :global(.rec__card-stat-value) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  :global(.rec__card-side) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  :global(.rec__card-date-label) {
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.rec__card-date) {
    font-size: 1.2rem;
    color: var(--color-text);
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
  }

  :global(.rec__card-date--pr) {
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  :global(.rec__card-cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    color: var(--color-muted);
    transition-property: color, transform;
    transition-duration: var(--transition-fast);
  }

  :global(.rec__empty) {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    border-top-width: 1px;
    border-top-style: solid;
    border-top-color: var(--color-border);
    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: var(--color-border);
  }

  :global(.rec__search-input::placeholder) {
    color: var(--color-muted);
  }

  :global(.rec__search-input::-webkit-search-cancel-button) {
    appearance: none;
  }

  :global(.rec__sort-btn:focus-visible) {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  :global(.rec__sort-btn--active) {
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  :global(.rec__sort-btn--active:hover) {
    background-color: var(--color-accent-hover);
    color: var(--color-accent-foreground);
  }

  :global(.rec__card:hover) {
    background-color: var(--alpha-bg-subtle);
    color: inherit;
  }

  :global(.rec__card:focus-visible) {
    outline: 0;
    box-shadow: var(--focus-ring);
  }

  :global(.rec__card:hover .rec__card-cta) {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  :global(.rec__card-stat--hero .rec__card-stat-value) {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    :global(.rec__card) {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'icon side'
        'main main';
      gap: 1rem;
    }

    :global(.rec__card-icon) {
      grid-area: icon;
      width: 3.2rem;
      height: 3.8rem;
    }

    :global(.rec__card-icon svg) {
      width: 2rem;
      height: 2rem;
    }

    :global(.rec__card-main) {
      grid-area: main;
    }

    :global(.rec__card-side) {
      grid-area: side;
      align-items: flex-end;
    }

    :global(.rec__card-stats) {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem 1.2rem;
    }
  }
</style>
