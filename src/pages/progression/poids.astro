---
import '../../styles/components/poids-page.css';

import { resolveLocale } from '../../i18n';

import { t } from '../../i18n';
import PoidsForm from '../../components/progression/PoidsForm.astro';
import PoidsStats from '../../components/progression/PoidsStats.astro';
import PoidsChart from '../../components/progression/PoidsChart.astro';
import PoidsTable from '../../components/progression/PoidsTable.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';

const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);
---

<AppLayout title={L.poids.title}>
  <PageHeader title={L.poids.title} description={L.poids.description} />

  <div class="poids" x-data="poidsApp()" x-init="init()" x-cloak>
    <PoidsForm />
    <PoidsStats />
    <PoidsChart />
    <PoidsTable />
  </div>
</AppLayout>

<script>
  import { registerAlpine } from '../../lib/alpine';
  import { createPoidsApp } from '../../components/progression/poidsApp';
  import { t } from '../../i18n';

  const LABELS = t();

  registerAlpine('poidsApp', () =>
    createPoidsApp({
      labels: { ...LABELS.poids, kg: LABELS.common.kg },
      today: () => new Date().toISOString().split('T')[0],
      ui: {
        confirm: (message) => window.confirm(message),
        schedule: (fn, ms) => window.setTimeout(fn, ms),
      },
    })
  );
</script>
