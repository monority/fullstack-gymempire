---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import Segmented from '../../components/ui/Segmented.astro';
import Card from '../../components/ui/Card.astro';
import { t } from '../../i18n';
import { icons } from '../../lib/icons';
const L = t();
import Icon from '../../components/ui/Icon.astro';
---

<AppLayout title={L.timer.title}>
  <PageHeader title={L.timer.title} description={L.timer.description} />

  <div class="timer" x-data="timerApp()" x-init="init()" x-cloak>
    {/* ── Top bar: pop-out (right) ── */}
    <div class="timer__topbar">
      <Button
        variant="secondary"
        size="sm"
        class="timer__popout"
        :class="{ 'timer__popout--open': popupOpen }"
        @click="openPopup()"
        :aria-label="labels.popoutAria"
        :title="labels.popout"
      >
        <Icon name="popout" size={16} />
        <span x-text="popupOpen ? labels.popoutOpen : labels.popout">{L.timer.popout}</span>
      </Button>
    </div>
    HERO — current mode + big clock + start CTA
    <section class="timer__hero">
      <div class="timer__hero-mode">
        <span class="timer__hero-icon" aria-hidden="true">
          <Fragment set:html={icons.countdown(18, 18)} x-show="mode === 'countdown'" />
          <Fragment set:html={icons.stopwatch(18, 18)} x-show="mode === 'stopwatch'" />
        </span>
        <span
          class="timer__hero-mode-label"
          x-text="mode === 'countdown' ? labels.countdown : labels.stopwatch"
        >
          {L.timer.countdown}
        </span>
        <span class="timer__hero-sep" aria-hidden="true">
          ·
        </span>
        <span class="timer__hero-mode-status" x-text="modeStatusLabel"></span>
      </div>

      <div class="timer__hero-ring-wrap">
        <svg class="timer__hero-ring-svg" viewBox="0 0 240 240" aria-hidden="true">
          <circle class="timer__hero-ring-track" cx="120" cy="120" r="108" />
          <circle
            class="timer__hero-ring-progress"
            :class="ringClasses"
            cx="120"
            cy="120"
            r="108"
            :stroke-dasharray="ringCircumference"
            :stroke-dashoffset="ringOffset"
          />
        </svg>
        <div
          class="timer__hero-clock"
          :class="clockClasses"
          x-text="clockText"
          aria-live="polite"
          aria-atomic="true"
        >
          00:00
        </div>
      </div>

      <div class="timer__hero-info">
        <span x-show="mode === 'countdown'">
          <span x-text="formatShort(totalTime)"></span>
          <span class="timer__hero-sep" aria-hidden="true">
            ·
          </span>
          <span x-text="labels.custom + ' ' + (customTime === totalTime ? formatShort(customTime) : formatShort(customTime))"></span>
        </span>
        <span
          x-show="mode === 'stopwatch'"
          x-text="labels.stopwatch + ' · ' + labels.running"
        ></span>
      </div>

      <div class="timer__hero-actions">
        <Button variant="primary" size="lg" fullWidth @click="toggle()">
          <span x-text="toggleLabel">{L.timer.start}</span>
        </Button>
        <Button variant="secondary" size="lg" @click="resetCurrent()">
          <span x-text="labels.reset">{L.timer.reset}</span>
        </Button>
        <Button
          variant="ghost"
          size="lg"
          x-show="mode === 'stopwatch'"
          @click="swRecordLap()"
          :disabled="!sw.running"
        >
          <span x-text="labels.lap">{L.timer.lap}</span>
        </Button>
      </div>
    </section>
    MODE + PRESETS — same row, segmented + 4 quick pills
    <section class="timer__presets-section" aria-label={L.timer.modeAria}>
      <div class="timer__presets-segmented">
        <Segmented
          model="mode"
          items={[
            { value: 'countdown', label: L.timer.countdown },
            { value: 'stopwatch', label: L.timer.stopwatch },
          ]}
        />
      </div>
      <div
        class="timer__presets-list"
        role="group"
        aria-label={L.timer.presetsAria}
        x-show="mode === 'countdown'"
      >
        <template x-for="preset in presets" :key="preset">
          <Button
            variant="secondary"
            size="md"
            pill
            :active="totalTime === preset && !running && remaining === totalTime"
            @click="setPreset(preset)"
          >
            <span x-text="formatShort(preset)"></span>
          </Button>
        </template>
      </div>
    </section>
    CUSTOM INPUT + LAPS — two cards side by side (countdown / stopwatch)
    <section class="timer__panels">
      {/* Custom time — countdown only */}
      <Card padding="md" class="timer__panel-card" x-show="mode === 'countdown'">
        <header class="timer__panel-header">
          <span class="timer__panel-title" x-text="labels.custom">
            {L.timer.custom}
          </span>
          <span class="timer__panel-subtitle" x-text="labels.customSeconds">
            {L.timer.customSeconds}
          </span>
        </header>
        <div class="timer__custom-controls">
          <Button
            variant="secondary"
            size="md"
            @click="adjustCustom(-15); setCustom()"
            aria-label={L.timer.reduce15}
          >
            −15
          </Button>
          <input
            id="custom-seconds"
            type="number"
            min="5"
            max="600"
            step="5"
            class="timer__custom-input no-spinner"
            x-model.number="customTime"
            @keydown.enter="setCustom()"
            @blur="setCustom()"
            aria-label={L.timer.customSeconds}
          />
          <Button
            variant="secondary"
            size="md"
            @click="adjustCustom(15); setCustom()"
            aria-label={L.timer.increase15}
          >
            +15
          </Button>
        </div>
      </Card>

      {/* Laps — stopwatch only */}
      <Card
        padding="none"
        class="timer__panel-card timer__laps"
        x-show="mode === 'stopwatch' && sw.laps.length > 0"
      >
        <div class="timer__laps-header">
          <span class="timer__laps-col-label" x-text="labels.lap">
            {L.timer.lap}
          </span>
          <span class="timer__laps-col-label" x-text="labels.lapTime">
            {L.timer.lapTime}
          </span>
          <span class="timer__laps-col-label timer__laps-col-label--right" x-text="labels.total">
            {L.timer.total}
          </span>
        </div>
        <div class="timer__laps-body">
          <template x-for="(lap, revIdx) in swLapsReversed" :key="lap.totalTime + '-' + revIdx">
            <div class="timer__laps-row" :class="{ 'timer__laps-row--latest': revIdx === 0 }">
              <span class="timer__laps-num" x-text="sw.laps.length - revIdx"></span>
              <span class="timer__laps-time" x-text="formatStopwatch(lap.lapTime)"></span>
              <span
                class="timer__laps-time timer__laps-time--accent"
                x-text="formatStopwatch(lap.totalTime)"
              ></span>
            </div>
          </template>
        </div>
      </Card>
    </section>
    SHORTCUTS — kbd hints, subtle row
    <div class="timer__shortcuts" aria-hidden="true">
      <span class="timer__shortcut">
        <kbd class="timer__kbd" x-text="labels.spaceKey">
          {L.timer.spaceKey}
        </kbd>
        <span x-text="labels.shortcutsToggle">{L.timer.shortcutsToggle}</span>
      </span>
      <span class="timer__shortcut">
        <kbd class="timer__kbd">R</kbd>
        <span x-text="labels.shortcutsReset">{L.timer.shortcutsReset}</span>
      </span>
    </div>
    SOUND TOGGLE — subtle footer
    <div class="timer__sound">
      <label class="timer__sound-label">
        <input
          type="checkbox"
          class="timer__sound-checkbox"
          x-model="soundEnabled"
          aria-label={L.timer.soundAlert}
        />
        <span class="timer__sound-text" x-text="labels.soundAlert">
          {L.timer.soundAlert}
        </span>
      </label>
    </div>
  </div>
</AppLayout>

<script>
  import { createTimerApp } from '../../components/timer/timerApp';
  import { registerAlpine } from '../../lib/alpine';
  import { t, localizedPath } from '../../i18n';

  const LABELS = t();

  registerAlpine('timerApp', () =>
    createTimerApp({
      labels: LABELS.timer,
      labelSource: LABELS,
      now: () => Date.now(),
      randomId: () => Math.random().toString(36).slice(2, 10),
      localizedPath,
    })
  );
</script>

<style>
  /* ── Layout ── */
  .timer {
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
    padding-bottom: 9.6rem;
  }

  /* ── Top bar ── */
  .timer__topbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  /* ── Hero section ── */
  .timer__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
    padding: 1.6rem 0 2.4rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .timer__hero-mode {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .timer__hero-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .timer__hero-icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .timer__hero-mode-label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .timer__hero-sep {
    color: var(--alpha-text-faint);
  }

  .timer__hero-mode-status {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .timer__hero-ring-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(28rem, 80vw);
    aspect-ratio: 1;
  }

  .timer__hero-ring-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .timer__hero-info {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.3rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .timer__hero-actions {
    display: flex;
    align-items: stretch;
    gap: 1.2rem;
    width: 100%;
    max-width: 36rem;
  }

  /* ── Presets section ── */
  .timer__presets-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .timer__presets-section {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .timer__presets-segmented {
    flex: none;
  }

  .timer__presets-list {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* ── Panels ── */
  .timer__panels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  @media (min-width: 760px) {
    .timer__panels {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .timer__panel-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
  }

  .timer__panel-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .timer__panel-subtitle {
    font-size: 1.1rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .timer__custom-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
  }

  /* ── Laps ── */
  .timer__laps-header {
    display: grid;
    grid-template-columns: 6rem 1fr 1fr;
    padding: 1.4rem 2rem;
    background: var(--color-surface-2);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-bottom: 1px solid var(--color-border);
  }

  .timer__laps-col-label--right {
    text-align: right;
  }

  .timer__laps-body {
    max-height: 32rem;
    overflow-y: auto;
  }

  .timer__laps-row {
    display: grid;
    grid-template-columns: 6rem 1fr 1fr;
    align-items: center;
    padding: 1.3rem 2rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color var(--transition-base),
      color var(--transition-base);
  }

  .timer__laps-row:last-child {
    border-bottom: 0;
  }

  .timer__laps-row--latest {
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
  }

  .timer__laps-num {
    color: var(--color-muted);
    font-weight: 600;
  }
  .timer__laps-row--latest .timer__laps-num {
    color: var(--color-accent);
    font-weight: 700;
  }

  .timer__laps-time {
    font-weight: 600;
  }

  .timer__laps-time--accent {
    text-align: right;
    color: var(--color-accent);
  }

  /* ── Shortcuts ── */
  .timer__shortcuts {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .timer__shortcut {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
    color: var(--color-muted);
  }

  .timer__kbd {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--color-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.6rem;
    line-height: 1.2;
  }

  /* ── Sound toggle ── */
  .timer__sound {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timer__sound-label {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-muted);
    font-size: 1.3rem;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    transition: color var(--transition-fast);
  }

  .timer__sound-label:hover {
    color: var(--color-text);
  }

  .timer__sound-checkbox {
    width: 1.8rem;
    height: 1.8rem;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  /* ── Popout button ── */
  .timer__popout.is-active,
  .timer__popout--open {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .timer__hero-icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .timer__hero-ring-track {
    fill: none;
    stroke: var(--color-surface-3);
    stroke-width: 4;
  }

  .timer__hero-ring-progress {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 5;
    stroke-linecap: round;
    transition:
      stroke-dashoffset var(--transition-fast),
      stroke var(--transition-base);
  }

  .timer__hero-ring-progress--running {
    stroke: var(--color-accent);
  }
  .timer__hero-ring-progress--warning {
    stroke: var(--color-warning);
  }
  .timer__hero-ring-progress--done {
    stroke: var(--color-success);
  }
  .timer__hero-ring-progress--paused {
    stroke: var(--color-muted);
    opacity: 0.6;
  }

  .timer__hero-clock {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(5rem, 14vw, 9.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    text-align: center;
    transition: color var(--transition-base);
  }

  .timer__hero-clock--running {
    color: var(--color-accent);
  }
  .timer__hero-clock--warning {
    color: var(--color-warning);
  }
  .timer__hero-clock--done {
    color: var(--color-success);
  }

  .timer__custom-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 4.4rem;
    padding: 0 1.2rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    text-align: center;
    font-variant-numeric: tabular-nums;
    outline: none;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
    -moz-appearance: textfield;
  }

  .timer__custom-input::-webkit-outer-spin-button,
  .timer__custom-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .timer__laps-row {
    display: grid;
    grid-template-columns: 6rem 1fr 1fr;
    align-items: center;
    padding: 1.3rem 2rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color var(--transition-base),
      color var(--transition-base);
  }

  .timer__laps-row:last-child {
    border-bottom: 0;
  }

  .timer__laps-row--latest {
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
  }

  .timer__laps-num {
    color: var(--color-muted);
    font-weight: 600;
  }
  .timer__laps-row--latest .timer__laps-num {
    color: var(--color-accent);
    font-weight: 700;
  }

  .timer__sound-label {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-muted);
    font-size: 1.3rem;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    transition: color var(--transition-fast);
  }

  .timer__sound-label:hover {
    color: var(--color-text);
  }
</style>
