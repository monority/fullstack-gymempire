---
import { resolveLocale } from '../i18n';

import '../styles/global.css';
import AppShell from '../components/layout/AppShell.astro';
import QuickSearch from '../components/layout/QuickSearch.astro';
import Toast from '../components/ui/Toast.astro';
import { ClientRouter } from 'astro:transitions';
import { t, localizedPath } from '../i18n';
import type { NavTree } from '../lib/types';

interface Props {
  title: string;
  description?: string;
  groups?: NavTree;
}

// Astro ajoute un slash final aux routes : on normalise pour que les
// comparaisons exactes avec les href des enfants fonctionnent en SSR.
const rawPath = Astro.url.pathname;
const currentPath = rawPath.length > 1 ? rawPath.replace(/\/+$/, '') : rawPath;
const locale = resolveLocale(Astro.url.pathname);
const L = t(locale);

const defaultGroups: NavTree = [
  {
    label: L.nav.groups.primary,
    items: [
      { label: L.nav.dashboard, href: localizedPath('/', locale), icon: 'dashboard' },
      {
        label: L.nav.seances,
        href: localizedPath('/sessions', locale),
        icon: 'clipboard',
        children: [
          { label: L.nav.historique, href: localizedPath('/sessions', locale), icon: 'clock' },
          { label: L.nav.creer, href: localizedPath('/sessions/create', locale), icon: 'plus' },
        ],
      },
      { label: L.nav.rapide, href: localizedPath('/sessions/quick', locale), icon: 'zap' },
      {
        label: L.nav.progression,
        href: localizedPath('/progression', locale),
        icon: 'trending-up',
        children: [
          { label: L.nav.force, href: localizedPath('/progression', locale), icon: 'target' },
          {
            label: L.nav.poidsMesures,
            href: localizedPath('/progression/poids', locale),
            icon: 'scale',
          },
          {
            label: L.nav.records,
            href: localizedPath('/progression/records', locale),
            icon: 'award',
          },
          {
            label: L.nav.statistiques,
            href: localizedPath('/progression/stats', locale),
            icon: 'chartBar',
          },
        ],
      },
    ],
  },
  {
    label: L.nav.groups.secondary,
    items: [
      { label: L.nav.exercices, href: localizedPath('/exercises', locale), icon: 'dumbbell' },
      { label: L.nav.calendrier, href: localizedPath('/calendar', locale), icon: 'calendar' },
      { label: L.nav.timer, href: localizedPath('/timer', locale), icon: 'timer' },
      { label: L.nav.calculateur, href: localizedPath('/calculator', locale), icon: 'calculator' },
    ],
  },
  {
    label: L.nav.groups.utility,
    items: [{ label: L.nav.settings, href: localizedPath('/settings', locale), icon: 'settings' }],
  },
];

const { title, description, groups = defaultGroups } = Astro.props;

// Mark active state on each item (and its children when present)
// so the Sidebar and the mobile drawer can highlight the right
// link without recomputing on the client.
const groupsWithActive = groups.map((g) => ({
  label: g.label,
  items: g.items.map((it) => {
    const isActive =
      currentPath === it.href || (it.href !== '/' && currentPath.startsWith(it.href + '/'));
    const children = it.children?.map((c) => ({
      ...c,
      // Leaves are terminal links, so they only highlight on an exact
      // match. Using prefix matching here made the first child (whose
      // href duplicates the parent, e.g. /progression) stay active on
      // every deeper page (e.g. /progression/records).
      active: currentPath === c.href,
    }));
    return {
      ...it,
      active: isActive,
      children,
      // "parent-active" — a collapsible group whose deepest active child
      // is the current page gets accent TEXT only (the pill stays on the
      // active leaf, never on the toggle).
      parentActive: (children ?? []).some((c) => c.active),
    };
  }),
}));
---

<html lang={locale}>
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="referrer" content="no-referrer" />
    {/* CSP defensive : aucune ressource externe (Alpine, polices et icônes sont
        auto-hébergés). 'unsafe-inline' est requis par les boots synchrones
        (thème, locale, Alpine ESM) documentés plus bas. Alpine 3 compile ses
        expressions avec `new Function` : 'unsafe-eval' est requis par le moteur
        lui-même (ADR-001). connect-src couvre le WebDAV configuré par
        l'utilisateur et le HMR en développement. */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:* ws: wss:; object-src 'none'; base-uri 'none'; form-action 'self'"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — Gym Empire</title>
    <meta name="description" content={description || L.layout.appTagline} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
    {/* theme-color cannot read CSS vars at rest — the attribute below is a
        static fallback; the theme bootstrap script overwrites it with the
        real --color-accent value (pop.astro precedent). */}
    <meta name="theme-color" content="#EA580C" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Gym Empire" />

    {/* ── i18n store (injecté, plus de globals window) ── */}
    <script>
      import { registerI18nStore } from '../lib/i18n-store';
      registerI18nStore();
    </script>

    {/* ── Theme bootstrap ──
        Runs synchronously in the head, BEFORE first paint, so the
        page never flashes the wrong palette when the user has
        chosen the light theme. The Alpine-side toggle lives in
        AppShell.astro; this block is the only thing that needs to
        be inline to avoid a flash. */}
    <script is:inline src="/theme-bootstrap.js" data-meta-var="--color-accent"></script>
    <style is:inline>
      html {
        background-color: var(--color-bg);
      }
    </style>
  </head>
  <body>
    {groupsWithActive.length > 0 ? (
      <AppShell groups={groupsWithActive} title={title}>
        <slot />
      </AppShell>
    ) : (
      <main>
        <slot />
      </main>
    )}

    {/* Global command palette — searches pages/exercises/sessions.
        Opened by the sidebar search field, "/", or Ctrl/Cmd+K. */}
    <QuickSearch />

    {/* Global toast — persists across page navigations. */}
    <Toast />

    <script is:inline>
      // Register the service worker for offline use (gym wifi is spotty).
      // Deferred until the load event so it doesn't compete with first paint.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' }).catch((err) => {
            console.warn('[muscu] service worker registration failed:', err);
          });
        });
      }
    </script>

    <script>
      import { t } from '../i18n';

      // Native number spinners are hidden in src/styles/components/stepper.css (they
      // can't be themed reliably cross-browser). Here we inject designed
      // chevron buttons inside the right edge of every standalone
      // number input. Inputs that already ship their own +/- steppers
      // opt out via the `.no-spinner` class.
      const L = t();

      const CHEVRON_UP = '<polyline points="6 14 12 8 18 14"/>';
      const CHEVRON_DOWN = '<polyline points="6 10 12 16 18 10"/>';

      const svg = (body: string): string =>
        `<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;

      function enhance(input: HTMLInputElement): void {
        if (input.dataset.stepper === 'true') return;
        input.dataset.stepper = 'true';

        const wrap = document.createElement('div');
        wrap.className = 'input-stepper';
        input.parentNode?.insertBefore(wrap, input);
        wrap.appendChild(input);

        const makeBtn = (cls: string, label: string, icon: string, fn: () => void) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = cls;
          btn.setAttribute('aria-label', label);
          btn.innerHTML = svg(icon);
          // preventDefault keeps focus on the input (no blur, no submit).
          btn.addEventListener('mousedown', (e) => {
            e.preventDefault();
            fn();
          });
          wrap.appendChild(btn);
        };

        makeBtn('input-stepper__btn input-stepper__btn--up', L.common.increase, CHEVRON_UP, () =>
          input.stepUp()
        );
        makeBtn(
          'input-stepper__btn input-stepper__btn--down',
          L.common.decrease,
          CHEVRON_DOWN,
          () => input.stepDown()
        );
      }

      const isTarget = (el: Element | null): boolean =>
        !!el &&
        el instanceof HTMLInputElement &&
        el.type === 'number' &&
        !el.classList.contains('no-spinner');

      const init = (): void => {
        document
          .querySelectorAll<HTMLInputElement>('input[type="number"]:not(.no-spinner)')
          .forEach(enhance);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }

      // Also enhance inputs added later by Alpine (e.g. session set
      // rows). enhance() is idempotent via the data-stepper marker.
      const observer = new MutationObserver((records) => {
        for (const record of records) {
          for (const node of record.addedNodes) {
            if (node.nodeType !== Node.ELEMENT_NODE) continue;
            const el = node as HTMLElement;
            if (isTarget(el)) enhance(el as HTMLInputElement);
            el.querySelectorAll<HTMLInputElement>('input[type="number"]:not(.no-spinner)').forEach(
              enhance
            );
          }
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    </script>

    {/* Alpine — imported from a self-hosted ESM build via an inline
        module script (NOT the jsdelivr CDN, and NOT bundled by Astro).

        Why not the CDN cdn.min.js build here: it auto-starts via
        queueMicrotask the instant it executes. Astro hoists this
        layout's scripts ahead of the page's deferred alpine:init
        listener modules (which land after </html>), so Alpine.start()
        fired before loginApp/commandMenu/etc. were registered
        ("loginApp is not defined"). The ESM build does NOT auto-start.

        Why not `import Alpine from 'alpinejs'` in a processed
        <script>: Astro/rolldown native-crashes bundling it on this
        machine, and 3.14.1 ships no .d.ts. The self-hosted ESM file
        is self-contained (inlines @vue/reactivity) and exports
        default Alpine.

        We call Alpine.start() on DOMContentLoaded — which only fires
        after every deferred page/module alpine:init listener has
        attached, so Alpine.data() registrations run before the
        component graph is walked. */}
    <script is:inline type="module">
      import Alpine from '/vendor/alpinejs-3.14.1.esm.js';
      window.Alpine = Alpine;
      // Astro hoists child-page alpine:init listener modules AFTER
      // this layout's scripts (after </html>), but ALL deferred
      // module scripts still run before DOMContentLoaded. So booting
      // on DCL — never inline — guarantees those listeners attach
      // before Alpine walks the graph. (Do NOT use the
      // readyState==='loading' / else boot() pattern: at module
      // execution time readyState is already 'interactive', so the
      // else branch would boot before the post-</html> listeners.)
      document.addEventListener('DOMContentLoaded', () => Alpine.start(), { once: true });
    </script>

    {/* Lifecycle ClientRouter (theme, x-ignore, re-registration) — module typé, ADR-001. */}
    <script>
      import { installAlpineLifecycle, registerStore } from '../lib/alpine';
      import { singleton as uiStore } from '../lib/ui-store';
      installAlpineLifecycle();
      registerStore('ui', uiStore);
    </script>
  </body>
</html>
