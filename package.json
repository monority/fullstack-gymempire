{
  "name": "gym-empire",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:strict": "astro check --minimumFailingSeverity hint",
    "format:check": "node scripts/format-changed.mjs",
    "format": "node scripts/format-changed.mjs --write",
    "lint": "oxlint",
    "check:colors": "node scripts/check-colors.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:components": "node scripts/check-components.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:i18n": "vitest run src/i18n/__tests__",
    "check:i18n-build": "node scripts/check-i18n-build.mjs",
    "check:style-parity": "node scripts/style-parity.mjs",
    "check:dead-code": "node scripts/dead-code.mjs",
    "screens": "node scripts/capture-screens.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke-routes.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.1.1",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
